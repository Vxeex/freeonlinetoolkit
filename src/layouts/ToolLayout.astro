---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SeoContent from '../components/SeoContent.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { toolBySlug } from '../data/tools';

export interface Props {
  title: string;
  description: string;
  breadcrumbItems: { label: string; href?: string }[];
  jsonLd?: Record<string, any>[];
}

const { title, description, breadcrumbItems, jsonLd } = Astro.props;
const toolSlug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() || '';
const tool = toolBySlug[toolSlug];
const toolTitle = tool?.title || 'Calculator';

// Improve page title for search — prefix with "Free" and add "- Free Online Calculator"
// e.g., "Mortgage Calculator - FreeOnlineToolkit" → "Free Mortgage Calculator - Free Online Calculator | FreeOnlineToolkit"
const siteName = 'FreeOnlineToolkit';
const siteUrl = 'https://freeonlinetoolkit.org';
const improvedTitle = tool
  ? `Free ${tool.title} — Free Online Calculator & Tool | ${siteName}`
  : title;

// Strip .html and ensure trailing slash for breadcrumb URLs
function cleanPath(pathname: string): string {
  let p = pathname.replace(/\.html$/, '');
  if (!p.endsWith('/')) p += '/';
  return p;
}
const currentUrl = `${siteUrl}${cleanPath(Astro.url.pathname)}`;

// Breadcrumb structured data
const breadcrumbSchema = breadcrumbItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.label,
    "item": item.href ? `${siteUrl}${item.href}` : currentUrl
  }))
} : null;

const allJsonLd = breadcrumbSchema
  ? [...(jsonLd || []), breadcrumbSchema]
  : jsonLd;
---

<BaseLayout title={improvedTitle} description={description} jsonLd={allJsonLd}>
  <Header />
  <div class="tool-page">
    <Breadcrumb items={breadcrumbItems} />
    <slot name="heading" />
    <slot name="intro" />
    <div class="tool-layout">
      <main class="tool-main">
        <slot name="calculator" />
        <EmailCapture toolSlug={toolSlug} toolTitle={toolTitle} />
        <SeoContent slug={toolSlug} />
        <slot name="content" />
      </main>
      <aside class="tool-sidebar">
        <slot name="sidebar" />
      </aside>
    </div>
  </div>
  <Footer />
</BaseLayout>

<script>
  import { trackRecentTool } from '../utils/recent-tools';
  const toolSlug = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean).pop() || '';
  if (toolSlug) trackRecentTool(toolSlug);
</script>
