---
import { toolBySlug, type Tool } from '../data/tools';
import { categories } from '../data/categories';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = toolBySlug[slug];
if (!tool) return;

const category = categories.find(c => c.id === tool.category);
const catTools = category
  ? category.toolSlugs.map(s => toolBySlug[s]).filter(Boolean) as Tool[]
  : [];
const related = catTools.filter(t => t.slug !== slug).slice(0, 4);

const categoryName = category?.name || 'tools';
const catId = category?.id || '';
const lowerTitle = tool.title.toLowerCase();

// Tool-type-specific quick start steps — generates unique content per category
function getSteps(cat: string): { label: string; text: string }[] {
  const sets: Record<string, { label: string; text: string }[]> = {
    financial: [
      { label: 'Enter the loan or investment amount', text: 'Type in the total amount you want to borrow, invest, or calculate. Most fields include sensible defaults so you can see results immediately.' },
      { label: 'Set the interest rate and term', text: 'Adjust the annual interest rate and loan duration or investment period. Small changes can significantly affect your monthly payments or final returns.' },
      { label: 'Add extra payments or contributions', text: 'If you plan to pay more than the minimum or contribute regularly, enter those amounts to see how much sooner you reach your goal.' },
      { label: 'Review the full breakdown', text: 'The results show your monthly payment, total interest paid, and a complete amortization schedule or growth projection.' },
    ],
    'health-wellness': [
      { label: 'Enter your body measurements', text: 'Fill in your height, weight, age, or other relevant metrics. You can usually switch between metric and imperial units.' },
      { label: 'Review your results', text: 'The calculator instantly shows your score or measurement along with a clear category label — such as healthy ranges or risk levels.' },
      { label: 'Understand what it means', text: 'Read the breakdown explaining how your result compares to standard ranges. Each category includes guidance on next steps.' },
      { label: 'Track changes over time', text: 'Come back periodically to log new measurements and see how your numbers trend. Consistent tracking gives the most useful insights.' },
    ],
    utility: [
      { label: 'Enter the value you want to convert or generate', text: 'Type or paste the input — an amount, a URL, a block of text — depending on what the tool does. Results appear after a single click.' },
      { label: 'Choose your options', text: 'Select units, character types, format preferences, or other settings to customize the output for your specific need.' },
      { label: 'Read or copy your result', text: 'The output is displayed clearly on screen. Use the copy button or select the text to paste it elsewhere.' },
      { label: 'Try different inputs', text: 'Experiment with various values to see how the output changes. The tool updates instantly so you can compare results side by side.' },
    ],
    legal: [
      { label: 'Enter your case details', text: 'Provide the relevant facts about your situation — such as medical costs, lost income, patent type, or settlement factors. Be as accurate as possible for a realistic estimate.' },
      { label: 'Review the estimated range', text: 'The calculator gives a low-to-high estimate based on standard formulas and historical data. Your actual outcome may vary.' },
      { label: 'Understand the factors', text: 'Read how each input affects the estimate. This helps you identify which factors carry the most weight in your situation.' },
      { label: 'Consult a professional', text: 'Use this estimate as a starting point for discussions with a qualified attorney or legal professional who can evaluate your specific case.' },
    ],
    developer: [
      { label: 'Enter your usage metrics', text: 'Input your expected volume — such as requests per month, tokens processed, or infrastructure specs — to model your costs or performance.' },
      { label: 'Compare options side by side', text: 'Many developer tools let you switch between providers, tiers, or configurations to see how each option affects the bottom line.' },
      { label: 'Review the cost or performance breakdown', text: 'The output breaks down each cost component or technical metric so you understand exactly what drives the total.' },
      { label: 'Optimize based on results', text: 'Use the comparison data to choose the most cost-effective or performant setup for your specific workload.' },
    ],
    ecommerce: [
      { label: 'Enter your product costs and pricing', text: 'Input numbers like product cost, selling price, shipping fees, and platform commissions. Accuracy here makes the results more useful.' },
      { label: 'Adjust margin assumptions', text: 'Try different markup percentages, discount scenarios, or ad spend levels to see how they affect your profit.' },
      { label: 'Review profit breakdowns', text: 'The results show gross margin, net profit, ROI, and other key metrics at a glance — so you know which products or campaigns are worth pursuing.' },
      { label: 'Run multiple scenarios', text: 'Change one variable at a time to stress-test your business model. Small shifts in cost or price can have a big impact on your bottom line.' },
    ],
    saas: [
      { label: 'Enter your SaaS metrics', text: 'Input key numbers like monthly visitors, conversion rate, average revenue per user, churn rate, and operating costs to model your business.' },
      { label: 'Adjust growth assumptions', text: 'Change scenarios around customer acquisition, pricing tiers, or retention improvements to see how they affect MRR and ARR.' },
      { label: 'Review unit economics', text: 'The output shows LTV, CAC, payback period, gross margin, and the LTV:CAC ratio — the core metrics investors and founders watch.' },
      { label: 'Identify optimization opportunities', text: 'See which lever (pricing, retention, or acquisition) has the biggest impact on your bottom line and focus your efforts accordingly.' },
    ],
    freelancing: [
      { label: 'Enter your desired income and expenses', text: 'Input your target annual income, estimated business expenses, taxes, and how many billable hours or days you work per year.' },
      { label: 'Adjust your utilization rate', text: 'Not all hours are billable. Factor in admin time, marketing, and breaks to find a realistic hourly or project rate.' },
      { label: 'Compare rate scenarios', text: 'Try different rates and utilization levels to see how they affect your take-home pay. Find the sweet spot that works for you and your clients.' },
      { label: 'Revisit regularly', text: 'As your skills, experience, and expenses evolve, update your rate. Annual reviews help ensure you are being fairly compensated.' },
    ],
    education: [
      { label: 'Enter your scores or grades', text: 'Input your current grades, test scores, or GPA information. Include weights if your school uses a weighted grading system.' },
      { label: 'Set your target', text: 'Tell the calculator what grade or score you are aiming for. Some tools let you calculate what you need on a final exam to reach your goal.' },
      { label: 'Review the results', text: 'The output shows where you stand now and what you need to achieve your target. Use it to plan your study time and priorities.' },
      { label: 'Plan your next steps', text: 'Use the breakdown to identify which assignments or exams have the most impact on your final grade and focus your effort where it matters most.' },
    ],
    automotive: [
      { label: 'Enter vehicle or trip details', text: 'Input information like distance, fuel efficiency, vehicle type, or current tire sizes depending on the tool you are using.' },
      { label: 'Compare options', text: 'Try different vehicles, routes, or configurations to see how each choice affects cost, time, or performance.' },
      { label: 'Review the comparison', text: 'The results show a side-by-side breakdown so you can quickly identify the most cost-effective or practical option.' },
      { label: 'Save your settings for later', text: 'Note your preferred configuration so you can quickly recalculate with updated numbers in the future.' },
    ],
    lifestyle: [
      { label: 'List your items or categories', text: 'Enter the different items, categories, or options relevant to your calculation — such as budget line items or pet ownership costs.' },
      { label: 'Adjust quantities and amounts', text: 'Set the numbers that match your situation. Most fields explain what the typical range looks like for reference.' },
      { label: 'Review the total breakdown', text: 'The results show a detailed breakdown of each component so you see exactly where the numbers come from.' },
      { label: 'Share and discuss', text: 'Share the results with family members, partners, or friends to make informed decisions together.' },
    ],
    food: [
      { label: 'Enter your ingredients or measurements', text: 'Input the quantities, servings, or recipe details you want to work with. The tool accepts common kitchen measurements.' },
      { label: 'Adjust servings or units', text: 'Scale the recipe up or down by changing the serving size, or switch between units like grams, cups, or ounces.' },
      { label: 'Review the results', text: 'See the adjusted quantities, nutrition facts, or cooking times clearly displayed. Each result includes the relevant details.' },
      { label: 'Save or note your settings', text: 'Record your preferred configuration so you can quickly recreate the same calculation next time.' },
    ],
    'real-estate': [
      { label: 'Enter your financial details', text: 'Input your income, down payment, monthly debts, or property value depending on the tool. Be realistic for the most useful results.' },
      { label: 'Adjust loan or rental assumptions', text: 'Try different interest rates, loan terms, or rental periods to see how each factor affects affordability or total cost.' },
      { label: 'Compare scenarios', text: 'See renting vs buying side by side, or compare different price ranges to find what works for your budget.' },
      { label: 'Use results in real-world decisions', text: 'Bring these estimates to discussions with a mortgage broker, real estate agent, or landlord to make informed choices.' },
    ],
    homeowner: [
      { label: 'Enter your project measurements', text: 'Input the dimensions of your project — length, width, depth — in feet, inches, or meters depending on the material.' },
      { label: 'Select material type and options', text: 'Choose the specific material or product you plan to use. Different materials have different coverage rates and cost factors.' },
      { label: 'Add a waste buffer', text: 'Include a wastage factor (typically 10-15%) to account for cuts, mistakes, and uneven surfaces. It is better to have a little extra than to run short.' },
      { label: 'Review material estimates', text: 'The results show exactly how much material to order in cubic yards, bags, or other units — including the waste buffer.' },
    ],
    'health-insurance': [
      { label: 'Enter your household details', text: 'Input your income, household size, age, and location. These factors determine eligibility and subsidy amounts for health coverage.' },
      { label: 'Review coverage options or needs', text: 'The tool estimates costs for different types of care or insurance needs based on your inputs and standard pricing.' },
      { label: 'Adjust scenarios', text: 'Try different income levels or care assumptions to see how they affect your costs or coverage estimates.' },
      { label: 'Use results for planning', text: 'Review your estimates annually during open enrollment or whenever your circumstances change to ensure adequate coverage.' },
    ],
    hr: [
      { label: 'Enter salary and benefit details', text: 'Input the base salary, bonus, benefits costs, and other compensation components to calculate the fully loaded employee cost.' },
      { label: 'Add payroll tax and overhead', text: 'Include employer-side payroll taxes, training costs, equipment, and overhead to see the true cost of each employee.' },
      { label: 'Review the cost breakdown', text: 'The results show each cost component so you understand how salary, taxes, benefits, and overhead stack up.' },
      { label: 'Use for budget planning', text: 'Use the fully loaded cost when creating hiring budgets or comparing full-time vs contract options.' },
    ],
  };
  return sets[cat] || [
    { label: 'Enter your values', text: 'Fill in the fields with numbers relevant to your situation. Most fields include sensible defaults so you can see results right away.' },
    { label: 'Adjust the settings', text: 'Change options like units, timeframes, or rates to match your specific scenario. Each change updates the results instantly.' },
    { label: 'Read your results', text: 'The output is displayed clearly with a breakdown of each component so you understand how the total is calculated.' },
    { label: 'Try different scenarios', text: 'Change one input at a time to see how it affects the outcome. This helps you make more informed decisions.' },
  ];
}

const quickSteps = getSteps(catId);

// Category-specific usage guidance
const usageContext: Record<string, { audience: string; tip: string }> = {
  financial: {
    audience: 'homebuyers, investors, and budget-conscious individuals',
    tip: 'Try adjusting the interest rate or loan term by small amounts to see how much you could save over the long run.',
  },
  'business-finance': {
    audience: 'entrepreneurs, startup founders, and business owners',
    tip: 'Use the results as a starting point for discussions with your financial advisor or accountant.',
  },
  'health-wellness': {
    audience: 'health-conscious individuals, fitness enthusiasts, and anyone tracking their well-being',
    tip: 'Track your results over time to see trends and progress toward your health goals.',
  },
  'health-insurance': {
    audience: 'individuals and families planning their healthcare coverage',
    tip: 'Review your results annually during open enrollment when your circumstances or plan options change.',
  },
  utility: {
    audience: 'students, professionals, and anyone who needs quick answers',
    tip: 'Bookmark this page for quick access whenever you need it again.',
  },
  legal: {
    audience: 'individuals planning for legal situations and estimating potential costs',
    tip: 'Use this as an educational estimate and consult a qualified professional for official advice.',
  },
  developer: {
    audience: 'developers, IT professionals, and system architects',
    tip: 'Combine this with your actual usage data for the most accurate budget projections.',
  },
  ecommerce: {
    audience: 'e-commerce sellers, marketers, and online business owners',
    tip: 'Run multiple scenarios with different margin assumptions to stress-test your business model.',
  },
  saas: {
    audience: 'SaaS founders, product managers, and growth teams',
    tip: 'Share these metrics with your team to align on growth targets and unit economics.',
  },
  freelancing: {
    audience: 'freelancers, contractors, and consultants',
    tip: 'Revisit your rates annually as your skills, experience, and expenses evolve.',
  },
  hr: {
    audience: 'HR professionals, business owners, and hiring managers',
    tip: 'Factor in company-specific costs like training, equipment, and benefits beyond the base salary.',
  },
  education: {
    audience: 'students, parents, and educators',
    tip: 'Use the results to set realistic goals and create a plan to achieve them.',
  },
  automotive: {
    audience: 'car owners, commuters, and travel planners',
    tip: 'Compare multiple scenarios — such as different vehicles or routes — to find the most cost-effective option.',
  },
  lifestyle: {
    audience: 'individuals planning major life events and purchases',
    tip: 'Share the results with family members or partners to align on budget decisions together.',
  },
  food: {
    audience: 'home cooks, bakers, and food enthusiasts',
    tip: 'Save your favorite settings so you can quickly recalculate next time.',
  },
  'real-estate': {
    audience: 'home buyers, sellers, and real estate investors',
    tip: 'Use these estimates alongside professional advice from a real estate agent or mortgage broker.',
  },
  homeowner: {
    audience: 'homeowners and DIY enthusiasts planning improvement projects',
    tip: 'Always add 10-15% buffer to material estimates for waste and unexpected issues.',
  },
  moving: {
    audience: 'individuals and families planning a move',
    tip: 'Get quotes from at least three moving companies to compare with this estimate.',
  },
};

const context = usageContext[catId] || {
  audience: 'anyone who needs quick, accurate results',
  tip: 'Try different input values to see how small changes can make a big difference.',
};

// Category-specific FAQ items
const faqByCategory: Record<string, { q: string; a: string }[]> = {
  financial: [
    { q: 'How accurate is this calculator?', a: 'This calculator provides accurate results based on the inputs you enter. The calculations follow standard financial formulas used by banks and financial institutions. Always verify critical numbers with a professional.' },
    { q: 'Can I save or print my results?', a: 'Yes! You can use your browser\'s print function (Ctrl+P or Cmd+P) to save or print the results. We recommend taking a screenshot for quick reference.' },
    { q: 'Is this calculator really free?', a: 'Yes, 100% free. No signup, no hidden fees, no usage limits. Use it as many times as you need.' },
  ],
  'health-wellness': [
    { q: 'Should I use this instead of seeing a doctor?', a: 'No. This tool provides educational estimates only. Always consult a healthcare professional for medical advice, diagnosis, or treatment.' },
    { q: 'How often should I use this tool?', a: 'Use it as often as you like. Tracking your results weekly or monthly can help you spot trends and monitor progress over time.' },
  ],
  utility: [
    { q: 'Is there a limit on how many times I can use this?', a: 'No limits at all. Use it as many times as you need, completely free.' },
    { q: 'Does this work on mobile devices?', a: 'Yes. The tool is fully responsive and works on smartphones, tablets, and desktop browsers.' },
  ],
  ecommerce: [
    { q: 'How should I use these numbers?', a: 'Use them as a starting point for your business planning. Market conditions, fees, and pricing change frequently, so revisit your calculations regularly.' },
    { q: 'Are the fee estimates up to date?', a: 'We update fee structures as platforms announce changes. However, always verify current fees on the platform\'s official website.' },
  ],
  developer: [
    { q: 'How are the estimates calculated?', a: 'The tool uses published pricing from official provider documentation. Actual costs may vary based on your specific usage patterns, reserved instances, and negotiated discounts.' },
  ],
  education: [
    { q: 'Can schools use this tool?', a: 'Absolutely. Teachers and students can use it in the classroom, for homework, or personal planning. No registration needed.' },
  ],
  food: [
    { q: 'Can I adjust the measurements?', a: 'Yes. The tool supports different units and serving sizes. Adjust the inputs to match your specific recipe or needs.' },
  ],
};

const faqItems = faqByCategory[catId] || [
  { q: 'How accurate are the results?', a: 'Results are based on standard formulas and the values you enter. They are accurate for educational and planning purposes.' },
  { q: 'Is this tool really free?', a: 'Yes, completely free. No signup, no hidden charges, no usage limits. Use it as often as you need.' },
  { q: 'Can I share the results?', a: 'Yes. You can take a screenshot or share the page link with anyone. The tool works the same for everyone.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="seo-content-section">
  <h2>How to Use the {tool.title}</h2>
  <p>
    The <strong>{tool.title}</strong> helps you {tool.description.charAt(0).toLowerCase() + tool.description.slice(1).replace(/\.\s*$/, '')}.
    Whether you are {context.audience} — this tool gives you accurate results instantly.
  </p>

  <h3>Quick Start Guide</h3>
  <ol>
    {quickSteps.map(step => (
      <li><strong>{step.label}</strong> — {step.text}</li>
    ))}
  </ol>

  <h3>Who Is This For?</h3>
  <p>
    This <strong>{lowerTitle}</strong> is designed for {context.audience}. It's intentionally simple — no complex signup forms, no data tracking, no distractions. Just enter your numbers and get the answer.
  </p>

  <h3>Pro Tip</h3>
  <p>
    {context.tip}
  </p>

  {related.length > 0 && (
    <>
      <h3>Explore More {categoryName}</h3>
      <p>These related tools work well alongside the {lowerTitle}:</p>
      <ul class="seo-related-list">
        {related.map(t => (
          <li>
            <a href={`/${t.slug}/`}>{t.shortTitle || t.title}</a>
            <span class="seo-related-desc"> — {t.shortDescription || t.description.replace(/\.$/, '').split('.').slice(0, 1)}.</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <h3>Frequently Asked Questions</h3>
  <div class="seo-faq">
    {faqItems.map(item => (
      <details class="seo-faq-item">
        <summary class="seo-faq-question">{item.q}</summary>
        <p class="seo-faq-answer">{item.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .seo-content-section {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .seo-content-section h2 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
  }
  .seo-content-section h3 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--color-text);
  }
  .seo-content-section p {
    margin-bottom: 0.75rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .seo-content-section ol {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .seo-content-section li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .seo-content-section .seo-related-list {
    list-style: none;
    padding: 0;
  }
  .seo-content-section .seo-related-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }
  .seo-content-section .seo-related-list li:last-child {
    border-bottom: none;
  }
  .seo-content-section .seo-related-list a {
    font-weight: 600;
  }
  .seo-related-desc {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  /* FAQ inside SEO content */
  .seo-faq {
    margin-top: 0.5rem;
  }
  .seo-faq-item {
    border-bottom: 1px solid var(--color-border-light);
    padding: 0.5rem 0;
  }
  .seo-faq-item:first-child {
    border-top: 1px solid var(--color-border-light);
  }
  .seo-faq-question {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.25rem 0;
    color: var(--color-text);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .seo-faq-question::-webkit-details-marker {
    display: none;
  }
  .seo-faq-question::after {
    content: '+';
    font-size: 1rem;
    color: var(--color-text-muted);
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .seo-faq-item[open] .seo-faq-question::after {
    content: '−';
  }
  .seo-faq-answer {
    padding: 0.25rem 0 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
