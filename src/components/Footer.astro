---
import { tools } from '../data/tools';
import { guides } from '../data/guides';

const footerTools = tools.slice(0, 5);
const footerGuides = guides.slice(0, 4);
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <span class="logo-icon">F</span>FreeOnlineToolkit
        </a>
        <p>Fast, accurate, and completely free online calculators and tools for everyday tasks. No signup required. Bookmark us!</p>
      </div>
      <div>
        <h3>Tools</h3>
        <ul>
          {footerTools.map(t => <li><a href={`/${t.slug}/`}>{t.shortTitle || t.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Guides</h3>
        <ul>
          {footerGuides.map(g => <li><a href={`/guides/${g.slug}/`} title={g.title}>{g.title.replace(/^(How to Use |Understanding Your |A Complete |Your Guide to )/, '').split(/[:–—]| - /)[0].replace(/^a\s+/i, '').trim()}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 FreeOnlineToolkit.org. All rights reserved.</span>
      <span>Free online tools and calculators</span>
    </div>
  </div>
</footer>

<!-- Styles are in global.css -->
