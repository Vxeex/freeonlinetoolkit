---
import { tools, toolBySlug } from '../data/tools';
import type { Tool } from '../data/tools';

const footerTools = tools.slice(0, 5);

// High-CPC calculators (legal, insurance, finance categories)
const highCpcSlugs = [
  'mortgage-calculator',
  'life-insurance-calculator',
  'personal-injury-calculator',
  'home-affordability-calculator',
  'student-loan-payoff-calculator',
  'workers-comp-calculator',
  'divorce-calculator',
  'long-term-care-calculator',
];
const footerTop: Tool[] = highCpcSlugs.map(s => toolBySlug[s]).filter(Boolean) as Tool[];
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <span class="logo-icon">F</span>FreeOnlineToolkit
        </a>
        <p>Fast, accurate, and completely free online calculators and tools for everyday tasks. No signup required. Bookmark us!</p>
      </div>
      <div>
        <h3>Tools</h3>
        <ul>
          {footerTools.map(t => <li><a href={`/${t.slug}/`}>{t.shortTitle || t.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Top Calculators</h3>
        <ul>
          {footerTop.map(t => <li><a href={`/${t.slug}/`}>{t.shortTitle || t.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 FreeOnlineToolkit.org. All rights reserved.</span>
      <span>Free online tools and calculators</span>
    </div>
  </div>
</footer>

<!-- Styles are in global.css -->
