---
import { categories } from '../data/categories';
import { toolBySlug, type Tool } from '../data/tools';

interface Props {
  currentSlug: string;
  category?: string;
  max?: number;
}

const { currentSlug, category, max = 8 } = Astro.props;

let related: Tool[] = [];

if (category) {
  const cat = categories.find(c => c.id === category);
  if (cat) {
    related = cat.toolSlugs
      .filter(s => s !== currentSlug)
      .map(s => toolBySlug[s])
      .filter(Boolean) as Tool[];
  }
}

if (related.length === 0) {
  related = Object.values(toolBySlug)
    .filter(t => t.slug !== currentSlug)
    .slice(0, max) as Tool[];
}

related = related.slice(0, max);
---

<div class="content-section">
  <h2>Related Tools</h2>
  <div class="related-tools-list">
    {related.map(t => (
      <a href={`/${t.slug}/`} class="related-tool-item">
        <span class="related-tool-icon" style={`background:${t.color}14;color:${t.color};`}>
          <i class={`fa-solid ${t.icon}`}></i>
        </span>
        <span class="related-tool-name">{t.title}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .related-tools-list { display: flex; flex-direction: column; gap: 6px; }
  .related-tool-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    transition: background var(--duration-fast) var(--ease-out);
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
  .related-tool-item:hover {
    background: var(--color-bg);
    color: var(--color-primary);
    text-decoration: none;
  }
  .related-tool-icon {
    width: 28px; height: 28px;
    border-radius: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
    flex-shrink: 0;
  }
  .related-tool-name { font-weight: 500; }
</style>
