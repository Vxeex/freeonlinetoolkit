---
import { categories } from '../data/categories';
import { toolBySlug, type Tool } from '../data/tools';
import { totalToolsCount } from '../data/tools';

interface Props {
  currentSlug: string;
  category?: string;
  max?: number;
}

const { currentSlug, category, max = 5 } = Astro.props;

let related: Tool[] = [];

if (category) {
  const cat = categories.find(c => c.id === category);
  if (cat) {
    related = cat.toolSlugs
      .filter(s => s !== currentSlug)
      .map(s => toolBySlug[s])
      .filter(Boolean) as Tool[];
  }
}

if (related.length === 0) {
  related = Object.values(toolBySlug)
    .filter(t => t.slug !== currentSlug)
    .slice(0, max) as Tool[];
}

related = related.slice(0, max);
const catObj = categories.find(c => c.id === category);
const catToolCount = catObj ? catObj.toolSlugs.length : 0;
---

<div class="sidebar-section">
  <h3>Related Tools</h3>
  <div class="related-list">
    {related.map(t => (
      <a href={`/${t.slug}/`} class="related-item">
        <i class={`fa-solid ${t.icon}`} style={`background:${t.color}14;color:${t.color};`}></i>
        <span>{t.shortTitle || t.title}</span>
      </a>
    ))}
  </div>
</div>

<div class="sidebar-section">
  <h3>Quick Stats</h3>
  <div class="sidebar-stats-grid">
    <div class="sidebar-stat">
      <div class="sidebar-stat-value">{totalToolsCount}</div>
      <div class="sidebar-stat-label">Free Tools</div>
    </div>
    {catToolCount > 0 && (
      <div class="sidebar-stat">
        <div class="sidebar-stat-value">{catToolCount}</div>
        <div class="sidebar-stat-label">{catObj?.name?.split(' ')[0] || ''} Tools</div>
      </div>
    )}
  </div>
</div>

<!-- Styles are in global.css -->
