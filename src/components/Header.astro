---
import LanguageSwitcher from './LanguageSwitcher.astro';
---

<header class="header" id="site-header">
  <div class="header-inner">
    <!-- Mobile sidebar toggle (hamburger) -->
    <button class="sidebar-mobile-toggle" id="sidebarMobileToggle" aria-label="Open navigation" aria-expanded="false">
      <i class="fas fa-bars"></i>
    </button>

    <a href="/" class="logo">
      FreeOnlineToolkit
    </a>

    <!-- Header search bar -->
    <div class="header-search" id="headerSearch">
      <i class="fas fa-magnifying-glass header-search-icon"></i>
      <input
        type="text"
        class="header-search-input"
        id="headerSearchInput"
        placeholder="Search tools…"
        autocomplete="off"
        data-i18n-placeholder="search.placeholder"
      />
      <kbd class="header-search-kbd" id="headerSearchKbd">⌘K</kbd>
    </div>

    <div class="header-right">
      <nav class="nav" id="mainNav">
        <a href="/" data-i18n="nav.home">Home</a>
        <a href="/guides/" data-i18n="nav.guides">Guides</a>
        <a href="/about/" data-i18n="nav.about">About</a>
        <a href="/contact/" data-i18n="nav.contact">Contact</a>
        <a href="/mortgage-calculator/" class="nav-cta" data-i18n="nav.tryTool">Try a Tool</a>
      </nav>
      <LanguageSwitcher />
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" title="Toggle theme">
        <i class="fas fa-moon" id="themeIcon"></i>
      </button>
    </div>
  </div>
</header>

<!-- Styles are in global.css -->

<script>
  const header = document.getElementById('site-header');

  if (header) {
    header.classList.toggle('scrolled', window.scrollY > 10);
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 10);
    }, { passive: true });
  }

  // Mobile sidebar toggle
  const sidebarMobileToggle = document.getElementById('sidebarMobileToggle');
  const appSidebar = document.getElementById('appSidebar');
  const sidebarOverlay = document.getElementById('sidebarOverlay');

  if (sidebarMobileToggle && appSidebar) {
    sidebarMobileToggle.addEventListener('click', () => {
      const isOpen = appSidebar.classList.toggle('open');
      if (sidebarOverlay) sidebarOverlay.classList.toggle('visible', isOpen);
      sidebarMobileToggle.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
  }

  // Header search — keyboard shortcut
  const searchInput = document.getElementById('headerSearchInput') as HTMLInputElement | null;
  const searchKbd = document.getElementById('headerSearchKbd');

  // Detect OS for shortcut display
  if (searchKbd) {
    const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
    searchKbd.textContent = isMac ? '⌘K' : 'Ctrl+K';
  }

  document.addEventListener('keydown', (e) => {
    // Ctrl+K or Cmd+K to focus search
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }
    // Escape to blur search
    if (e.key === 'Escape' && document.activeElement === searchInput) {
      searchInput?.blur();
    }
  });

  // Search functionality — filter and navigate
  if (searchInput) {
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = searchInput.value.trim();
        if (query) {
          window.location.href = '/?search=' + encodeURIComponent(query);
        }
      }
    });
  }

  // Theme toggle
  const themeToggle = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');
  if (themeToggle) {
    // Sync icon with current theme
    themeIcon.className = document.documentElement.getAttribute('data-theme') === 'dark' ? 'fas fa-sun' : 'fas fa-moon';

    themeToggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';

      html.classList.add('theme-transitioning');
      html.setAttribute('data-theme', newTheme);
      localStorage.setItem('fot-theme', newTheme);
      themeIcon.className = newTheme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';

      setTimeout(() => html.classList.remove('theme-transitioning'), 400);
    });
  }
</script>
