---
import { toolContent } from '../data/tool-content';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const content = toolContent[slug];
const resources = content?.resources;
---

{resources && resources.length > 0 && (
  <section class="download-resources">
    <h3>Download Resources</h3>
    <p class="download-resources-desc">Free templates and worksheets to help you get the most from this tool.</p>
    <div class="download-grid">
      {resources.map((r, i) => (
        <a href="#" class="download-card" title={`${r.title} — Coming soon`}>
          <div class="download-icon">
            <i class="fas fa-file-pdf"></i>
          </div>
          <div class="download-info">
            <span class="download-title">{r.title}</span>
            <span class="download-desc">{r.description}</span>
            <span class="download-badge">PDF · Free</span>
          </div>
          <div class="download-action">
            <i class="fas fa-download"></i>
            <span class="download-coming-soon">Coming soon</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .download-resources {
    margin-top: 1.5rem;
    padding-top: 1rem;
  }
  .download-resources h3 {
    font-size: 1.05rem;
    margin: 0 0 0.25rem;
    color: var(--color-text);
  }
  .download-resources-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .download-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
  }
  .download-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    position: relative;
  }
  .download-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .download-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fef2f2;
    color: #dc2626;
    border-radius: 6px;
    font-size: 1rem;
  }
  .download-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .download-title {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.3;
  }
  .download-desc {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .download-badge {
    display: inline-block;
    margin-top: 0.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-bg, rgba(99,102,241,0.08));
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    width: fit-content;
  }
  .download-action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    padding-top: 0.2rem;
  }
  .download-coming-soon {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
