---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  featured?: boolean;
  index?: number;
}

const { tool, featured = false, index = 0 } = Astro.props;

// Before/after examples for popular tools
const examples: Record<string, string> = {
  'mortgage-calculator': '$300K loan → $1,896/mo',
  'bmi-calculator': '5\'10" 170 lbs → BMI 24.4',
  'compound-interest-calculator': '$10K @ 7% → $76,123 in 30 yrs',
  'salary-calculator': '$75K salary → $58,200 take-home',
  'tip-calculator': '$85 bill + 18% → $100.30',
  'password-generator': 'Generate: xK9#mP2$vL...',
  'auto-loan-calculator': '$35K car → $648/mo for 60 mo',
  'savings-calculator': '$500/mo → $81,940 in 10 yrs',
  'credit-card-payoff-calculator': '$8K debt → debt-free in 24 mo',
  'percentage-calculator': 'What is 15% of 250? → 37.5',
  'currency-converter': '100 USD → 92.40 EUR',
  'inflation-calculator': '$100 in 2000 → $179 today',
  'vat-calculator': '$100 + 20% VAT → $120.00',
  'gpa-calculator': '3.5 + 3.8 + 4.0 → GPA 3.77',
  'calorie-calculator': 'Moderate activity → 2,200 cal/day',
  'fuel-cost-calculator': '500 mi @ 30 mpg → $55.00',
  'qr-code-generator': 'URL → scannable QR code',
  'word-counter': '500 words → 3 min read time',
  'json-formatter': '{minified} → {pretty printed}',
  'rent-vs-buy-calculator': '5-yr horizon → buying wins by $12K',
  'home-affordability-calculator': '$80K income → $350K home',
  'sip-calculator': '₹10K/mo @ 12% → ₹23.2L in 10 yrs',
};

const example = examples[tool.slug] || '';
const cardDelay = `${(index % 12) * 0.06}s`;
---

<a
  href={`/${tool.slug}/`}
  class:list={['tool-card', 'tool-card-rich', featured && 'tool-card-featured', 'animate-in', `animate-in-delay-${Math.min(index + 1, 10)}`]}
  style={`transition-delay:${cardDelay};`}
>
  <div class="tool-card-header" style={`background: linear-gradient(135deg, ${tool.color}dd, ${tool.color}88);`}>
    <i class={`fa-solid ${tool.icon} tool-card-header-icon`}></i>
  </div>
  <div class="tool-card-body">
    <h3>{tool.title}</h3>
    <p class="tool-card-desc">{tool.shortDescription || tool.description}</p>
    {example && (
      <div class="tool-card-example">
        <span class="tool-card-example-text">{example}</span>
      </div>
    )}
    <div class="tool-card-cta">
      Use Tool <i class="fa-solid fa-arrow-right"></i>
    </div>
  </div>
</a>

<style>
  /* ===== RICH TOOL CARD ===== */
  .tool-card-rich {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    will-change: transform, box-shadow;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease;
  }

  .tool-card-rich:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 4px 12px rgba(0,0,0,0.06);
    border-color: transparent;
    text-decoration: none;
  }

  .tool-card-rich:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* --- Header with gradient --- */
  .tool-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100px;
    position: relative;
    overflow: hidden;
  }

  .tool-card-header::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.15) 0%, transparent 60%);
    pointer-events: none;
  }

  .tool-card-header-icon {
    font-size: 2rem;
    color: #fff;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
    animation: iconPulse 3s ease-in-out infinite;
    z-index: 1;
  }

  /* --- Body --- */
  .tool-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 20px 20px;
  }

  .tool-card-rich h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .tool-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0 0 12px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- Before/after example --- */
  .tool-card-example {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    overflow: hidden;
    position: relative;
  }

  .tool-card-example::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent 0%, var(--color-bg) 100%);
    animation: typingReveal 2.5s steps(40, end) forwards;
    z-index: 1;
  }

  .tool-card-example-text {
    white-space: nowrap;
  }

  /* --- CTA --- */
  .tool-card-cta {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .tool-card-cta i {
    font-size: 0.6rem;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tool-card-rich:hover .tool-card-cta i {
    transform: translateX(5px);
  }

  /* ===== FEATURED (Popular) VARIANT ===== */
  .tool-card-featured .tool-card-header {
    height: 120px;
  }

  .tool-card-featured .tool-card-header-icon {
    font-size: 2.5rem;
  }

  .tool-card-featured .tool-card-body {
    padding: 20px 24px 24px;
  }

  .tool-card-featured h3 {
    font-size: var(--text-lg);
  }

  .tool-card-featured .tool-card-desc {
    font-size: var(--text-base);
    -webkit-line-clamp: 3;
  }

  .tool-card-featured .tool-card-example {
    font-size: 0.78rem;
  }

  /* ===== ANIMATIONS ===== */
  @keyframes iconPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.08); opacity: 0.9; }
  }

  @keyframes typingReveal {
    0% { width: 100%; }
    100% { width: 0%; }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tool-card-header-icon {
      animation: none;
    }
    .tool-card-example::before {
      animation: none;
      display: none;
    }
    .tool-card-rich {
      transition: none;
    }
    .tool-card-rich:hover {
      transform: none;
    }
  }
</style>
