---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---
<a href={`/${tool.slug}/`} class="tool-card">
  <div class="tool-card-icon" style={`background:${tool.color}14;color:${tool.color};`}>
    <i class={`fa-solid ${tool.icon}`}></i>
  </div>
  <h3>{tool.title}</h3>
  <p>{tool.shortDescription || tool.description}</p>
  <div class="tool-card-arrow">Use tool <i class="fa-solid fa-arrow-right"></i></div>
</a>
