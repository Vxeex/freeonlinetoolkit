---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/categories';
import { toolBySlug, totalToolsCount } from '../data/tools';

const pageTitle = `${totalToolsCount} Free Online Calculators & Tools — Mortgage, BMI, & More | FreeOnlineToolkit`;
const pageDesc = `Access ${totalToolsCount} free online calculators and tools — mortgage calculator, BMI calculator, currency converter, password generator, and more. 100% free, no signup required. Use them instantly in your browser.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Free Online Toolkit",
    "description": pageDesc,
    "url": "https://freeonlinetoolkit.org/",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeOnlineToolkit",
    "url": "https://freeonlinetoolkit.org/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://freeonlinetoolkit.org/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
];
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>
  <Header />

  <main>
  <!-- ============ HERO ============ -->
  <section class="home-hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge animate-entrance animate-entrance-delay-1">
          <i class="fa-solid fa-bolt"></i>
          {totalToolsCount} Free Tools &mdash; No Signup Required
        </div>
        <h1 class="animate-entrance animate-entrance-delay-2"><span>{totalToolsCount} Free Online Calculators</span> for Every Need</h1>
        <p class="animate-entrance animate-entrance-delay-3">
          FreeOnlineToolkit gives you <strong>{totalToolsCount} free calculators and utilities</strong>
          for life's everyday questions &mdash; mortgage payments, BMI, passwords,
          currency conversions, and more. All 100% free, no signup required.
        </p>
        <div class="hero-actions animate-entrance animate-entrance-delay-4">
          <a href="#tools" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i> Explore Tools
          </a>
          <a href="/guides/" class="btn btn-secondary">
            <i class="fa-regular fa-compass"></i> Read Guides
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <div class="trust-bar animate-in">
    <div class="trust-bar-inner">
      <div class="trust-stat">
        <div class="trust-stat-number" data-count={totalToolsCount}>{totalToolsCount}</div>
        <div class="trust-stat-label">Free Online Tools</div>
      </div>
      <div class="trust-stat">
        <div class="trust-stat-number" data-count="100">100%</div>
        <div class="trust-stat-label">Free &mdash; No Hidden Fees</div>
      </div>
      <div class="trust-stat">
        <div class="trust-stat-number" data-count="0">0</div>
        <div class="trust-stat-label">Signups Required</div>
      </div>
    </div>
  </div>

  <!-- ============ SEARCH ============ -->
  <div class="search-section" id="tools">
    <div class="container">
      <div class="search-inner">
        <div class="search-label"><i class="fa-solid fa-magnifying-glass"></i> Find the right tool</div>
        <div class="search-bar">
          <i class="fa-solid fa-search search-bar-icon"></i>
          <input type="text" id="toolSearch" placeholder="Search tools..." autocomplete="off" />
          <span id="searchClear" class="search-clear"><i class="fa-solid fa-xmark"></i></span>
        </div>
        <div id="recentlyUsed" class="recently-used" style="display:none;">
          <div class="recently-used-label"><i class="fa-regular fa-clock"></i> Recently Used</div>
          <div id="recentToolsList" class="recent-tools-list"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ CATEGORY SECTIONS ============ -->
  {categories.map((cat) => {
    const catTools = cat.toolSlugs.map(s => toolBySlug[s]).filter(Boolean);
    if (catTools.length === 0) return null;
    return (
      <section class="cat-section">
        <div class="cat-section-inner">
          <div class="section-header animate-in">
            <div class="section-label"><i class={`fa-solid ${cat.icon}`}></i> {cat.name}</div>
            <h2>{cat.description}</h2>
          </div>
          <div class="tool-grid-home">
            {catTools.map((t, i) => (
              <a href={`/${t.slug}/`} class:list={['tool-card', 'animate-in', `animate-in-delay-${Math.min(i + 1, 10)}`]}>
                <div class="tool-card-icon" style={`background:${t.color}18;color:${t.color};`}>
                  <i class={`fa-solid ${t.icon}`}></i>
                </div>
                <h3>{t.title}</h3>
                <p>{t.shortDescription || t.description}</p>
                <div class="tool-card-arrow">Use tool <i class="fa-solid fa-arrow-right"></i></div>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ============ SEO CONTENT ============ -->
  <section class="seo-content animate-in">
    <div class="seo-content-inner">
      <h2>Free Online Calculators — No Signup, No Limits</h2>
      <p>FreeOnlineToolkit.org brings together <strong>{totalToolsCount} powerful online calculators and tools</strong> covering personal finance, health &amp; fitness, home improvement, business planning, and everyday utilities. Every calculator is completely free, works in your browser with instant results, and requires no account or signup.</p>
      <p>Whether you need a <a href="/mortgage-calculator/">mortgage calculator</a>, <a href="/bmi-calculator/">BMI calculator</a>, <a href="/currency-converter/">currency converter</a>, or <a href="/password-generator/">password generator</a> &mdash; you'll find accurate, reliable tools designed for speed and simplicity. Bookmark us for quick access whenever you need a calculation.</p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-section animate-in">
    <div class="cta-inner">
      <h2>Ready to simplify your day?</h2>
      <p>Try any tool in seconds &mdash; no account, no cost, no complications. Just fast, accurate results.</p>
      <a href="/mortgage-calculator/" class="btn btn-primary">
        <i class="fa-solid fa-arrow-right"></i> Try a Free Tool Now
      </a>
    </div>
  </section>

  </main>

  <Footer />

  <script>
    import { renderRecentTools } from '../utils/recent-tools';
    import { initScrollAnimations } from '../utils/scroll-animations';

    const path = window.location.pathname.replace(/\/$/, '') || '/';
    if (path === '/') {
      renderRecentTools('recentToolsList', 3);

      const searchInput = document.getElementById('toolSearch');
      const clearBtn = document.getElementById('searchClear');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          if (clearBtn) clearBtn.classList.toggle('visible', query.length > 0);
          document.querySelectorAll('.cat-section').forEach(section => {
            const cards = section.querySelectorAll('.tool-card');
            let hasVisible = false;
            cards.forEach(card => {
              const title = card.querySelector('h3');
              const match = !query || (title && title.textContent.toLowerCase().indexOf(query) !== -1);
              card.style.display = match ? '' : 'none';
              if (match) hasVisible = true;
            });
            section.style.display = hasVisible ? '' : 'none';
          });
        });
        clearBtn?.addEventListener('click', function() {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
          searchInput.focus();
        });
      }

      // Trust bar counter animation
      const trustBar = document.querySelector('.trust-bar');
      if (trustBar) {
        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              const counters = entry.target.querySelectorAll('[data-count]');
              counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-count'), 10);
                if (target === 0) return;
                const duration = 1200;
                const start = performance.now();
                function update(now) {
                  const elapsed = now - start;
                  const progress = Math.min(elapsed / duration, 1);
                  counter.textContent = Math.round(progress * target) + (target === 100 ? '%' : '');
                  if (progress < 1) requestAnimationFrame(update);
                  else counter.textContent = target + (target === 100 ? '%' : '');
                }
                requestAnimationFrame(update);
              });
              counterObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        counterObserver.observe(trustBar);
      }
    }

    initScrollAnimations();
  </script>
</BaseLayout>
