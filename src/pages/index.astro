---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import ToolCard from '../components/ToolCard.astro';
import CTASection from '../components/CTASection.astro';
import SEOContent from '../components/SEOContent.astro';
import { categories } from '../data/categories';
import { toolBySlug } from '../data/tools';
import { totalToolsCount } from '../data/tools';

const pageTitle = `FreeOnlineToolkit — ${totalToolsCount} Free Online Calculators & Everyday Tools`;
const pageDesc = `${totalToolsCount} free online calculators and tools for everyday use — mortgage, BMI, currency converter, password generator, and more. 100% free, no signup.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free Online Toolkit",
  "description": "Free online tools and calculators for everyday use.",
  "url": "https://freeonlinetoolkit.org/",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>
  <Header />

  <!-- Hero -->
  <section class="home-hero">
    <div class="home-hero-content animate-in">
      <div class="home-hero-badge">
        <i class="fa-solid fa-bolt"></i>
        {totalToolsCount} Free Tools &mdash; No Signup Required
      </div>
      <h1>Your pocket toolkit for <span>everyday math</span></h1>
      <p>FreeOnlineToolkit gives you <strong>{totalToolsCount} free calculators and utilities</strong> for life's everyday questions — mortgage payments, BMI, passwords, currency conversions, and more. All 100% free, no signup.</p>
      <div class="home-hero-actions">
        <a href="#tools" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Explore Tools</a>
        <a href="/guides/" class="btn btn-secondary"><i class="fa-regular fa-compass"></i> Read Guides</a>
      </div>
    </div>
    <div class="home-hero-visual animate-in animate-in-delay-2">
      <svg class="hero-illustration" viewBox="0 0 520 440" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="heroGrad1" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#c2410c" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#c2410c" stop-opacity="0.03"/>
          </linearGradient>
          <linearGradient id="heroGrad2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#d97706" stop-opacity="0.1"/>
            <stop offset="100%" stop-color="#d97706" stop-opacity="0.02"/>
          </linearGradient>
          <linearGradient id="cardGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffffff"/>
            <stop offset="100%" stop-color="#fdfaf7"/>
          </linearGradient>
          <filter id="heroShadow">
            <feDropShadow dx="0" dy="4" stdDeviation="24" flood-color="#c2410c" flood-opacity="0.08"/>
          </filter>
        </defs>
        <ellipse cx="260" cy="380" rx="240" ry="60" fill="url(#heroGrad1)"/>
        <ellipse cx="260" cy="60" rx="200" ry="50" fill="url(#heroGrad2)"/>
        <rect x="55" y="50" width="410" height="320" rx="20" fill="url(#cardGrad)" filter="url(#heroShadow)"/>
        <rect x="55" y="50" width="410" height="320" rx="20" stroke="#e6ddd4" stroke-width="1"/>
        <rect x="55" y="50" width="410" height="44" rx="20" fill="#c2410c" opacity="0.06"/>
        <rect x="55" y="70" width="410" height="24" fill="#c2410c" opacity="0.06"/>
        <circle cx="80" cy="72" r="4.5" fill="#ef4444" opacity="0.5"/>
        <circle cx="100" cy="72" r="4.5" fill="#f59e0b" opacity="0.5"/>
        <circle cx="120" cy="72" r="4.5" fill="#10b981" opacity="0.5"/>
        <text x="400" y="77" font-family="DM Sans, sans-serif" font-size="9" letter-spacing="1.5" text-anchor="end" fill="#c2410c" opacity="0.7" font-weight="600">PORTFOLIO OVERVIEW</text>
        <text x="80" y="118" font-family="DM Sans, sans-serif" font-size="8" fill="#b8a99c">0</text>
        <text x="80" y="158" font-family="DM Sans, sans-serif" font-size="8" fill="#b8a99c">10k</text>
        <text x="80" y="198" font-family="DM Sans, sans-serif" font-size="8" fill="#b8a99c">20k</text>
        <text x="80" y="238" font-family="DM Sans, sans-serif" font-size="8" fill="#b8a99c">30k</text>
        <text x="80" y="278" font-family="DM Sans, sans-serif" font-size="8" fill="#b8a99c">40k</text>
        <line x1="105" y1="115" x2="440" y2="115" stroke="#e6ddd4" stroke-width="0.5"/>
        <line x1="105" y1="155" x2="440" y2="155" stroke="#e6ddd4" stroke-width="0.5"/>
        <line x1="105" y1="195" x2="440" y2="195" stroke="#e6ddd4" stroke-width="0.5"/>
        <line x1="105" y1="235" x2="440" y2="235" stroke="#e6ddd4" stroke-width="0.5"/>
        <line x1="105" y1="275" x2="440" y2="275" stroke="#e6ddd4" stroke-width="0.5"/>
        <path d="M110,270 L130,230 L165,245 L200,200 L235,215 L270,175 L305,190 L340,150 L375,170 L410,145 L440,155 L440,280 L110,280 Z" fill="#c2410c" opacity="0.06"/>
        <path d="M110,270 L130,230 L165,245 L200,200 L235,215 L270,175 L305,190 L340,150 L375,170 L410,145 L440,155" stroke="#c2410c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
        <circle cx="200" cy="200" r="4" fill="white" stroke="#c2410c" stroke-width="2"/>
        <circle cx="270" cy="175" r="4" fill="white" stroke="#c2410c" stroke-width="2"/>
        <circle cx="340" cy="150" r="4" fill="white" stroke="#c2410c" stroke-width="2"/>
        <circle cx="410" cy="145" r="4" fill="white" stroke="#c2410c" stroke-width="2.5"/>
        <rect x="120" y="195" width="22" height="80" rx="3" fill="#c2410c" opacity="0.5"/>
        <rect x="155" y="210" width="22" height="65" rx="3" fill="#d97706" opacity="0.5"/>
        <rect x="190" y="165" width="22" height="110" rx="3" fill="#c2410c" opacity="0.35"/>
        <rect x="225" y="180" width="22" height="95" rx="3" fill="#d97706" opacity="0.35"/>
        <rect x="260" y="140" width="22" height="135" rx="3" fill="#c2410c" opacity="0.5"/>
        <rect x="295" y="155" width="22" height="120" rx="3" fill="#d97706" opacity="0.4"/>
        <rect x="330" y="115" width="22" height="160" rx="3" fill="#c2410c" opacity="0.65"/>
        <rect x="365" y="135" width="22" height="140" rx="3" fill="#c2410c" opacity="0.4"/>
        <rect x="400" y="110" width="22" height="165" rx="3" fill="#c2410c" opacity="0.75"/>
        <text x="120" y="300" font-family="DM Sans, sans-serif" font-size="8" text-anchor="middle" fill="#b8a99c">Jan</text>
        <text x="190" y="300" font-family="DM Sans, sans-serif" font-size="8" text-anchor="middle" fill="#b8a99c">Mar</text>
        <text x="260" y="300" font-family="DM Sans, sans-serif" font-size="8" text-anchor="middle" fill="#b8a99c">May</text>
        <text x="330" y="300" font-family="DM Sans, sans-serif" font-size="8" text-anchor="middle" fill="#b8a99c">Jul</text>
        <text x="400" y="300" font-family="DM Sans, sans-serif" font-size="8" text-anchor="middle" fill="#b8a99c">Sep</text>
        <rect x="80" y="315" width="170" height="40" rx="10" fill="white" stroke="#e6ddd4" stroke-width="1"/>
        <circle cx="100" cy="335" r="12" fill="#c2410c" opacity="0.1"/>
        <text x="100" y="339" font-family="DM Sans, sans-serif" font-size="10" fill="#c2410c" text-anchor="middle" font-weight="700">$</text>
        <text x="120" y="330" font-family="DM Sans, sans-serif" font-size="10" font-weight="600" fill="#1a1a1a">Total Value</text>
        <text x="120" y="346" font-family="JetBrains Mono, monospace" font-size="11" fill="#c2410c" font-weight="600">$284,500</text>
        <rect x="265" y="315" width="180" height="40" rx="10" fill="white" stroke="#e6ddd4" stroke-width="1"/>
        <circle cx="285" cy="335" r="12" fill="#d97706" opacity="0.1"/>
        <text x="285" y="339" font-family="DM Sans, sans-serif" font-size="9" fill="#d97706" text-anchor="middle" font-weight="700">%</text>
        <text x="305" y="330" font-family="DM Sans, sans-serif" font-size="10" font-weight="600" fill="#1a1a1a">Avg Return</text>
        <text x="305" y="346" font-family="JetBrains Mono, monospace" font-size="11" fill="#d97706" font-weight="600">+12.4%</text>
        <circle cx="40" cy="420" r="6" fill="#c2410c" opacity="0.06"/>
        <circle cx="490" cy="410" r="8" fill="#d97706" opacity="0.05"/>
        <circle cx="500" cy="65" r="5" fill="#c2410c" opacity="0.08"/>
        <circle cx="30" cy="130" r="7" fill="#d97706" opacity="0.04"/>
      </svg>
      <div class="hero-stat hero-stat-1">
        <div class="hero-stat-icon" style="background:var(--color-primary-bg);color:var(--color-primary);"><i class="fa-solid fa-calculator"></i></div>
        <div><strong>{totalToolsCount}</strong> Tools</div>
      </div>
      <div class="hero-stat hero-stat-2">
        <div class="hero-stat-icon" style="background:var(--color-accent-bg);color:var(--color-accent);"><i class="fa-solid fa-bolt"></i></div>
        <div><strong>100%</strong> Free</div>
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- Tools search -->
  <div id="tools"></div>
  <div class="tool-search-section">
    <div class="tool-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="toolSearch" placeholder="Search tools..." autocomplete="off" />
      <span id="searchClear" class="search-clear"><i class="fa-solid fa-xmark"></i></span>
    </div>
    <div id="recentlyUsed" class="recently-used" style="display:none;">
      <div class="recently-used-label"><i class="fa-regular fa-clock"></i> Recently Used</div>
      <div id="recentToolsList" class="recent-tools-list"></div>
    </div>
  </div>

  <!-- Category sections -->
  {categories.map((cat, idx) => {
    const catTools = cat.toolSlugs.map(s => toolBySlug[s]).filter(Boolean);
    if (catTools.length === 0) return null;
    return (
      <section class="cat-section">
        <div class="cat-section-inner">
          <div class="home-section-header animate-in">
            <div class="home-section-label"><i class={`fa-solid ${cat.icon}`}></i> Category</div>
            <h2>{cat.name}</h2>
            <p>{cat.description}</p>
          </div>
          <div class="tool-grid-home animate-in animate-in-delay-1">
            {catTools.map(t => <ToolCard tool={t} />)}
          </div>
        </div>
      </section>
    );
  })}

  <SEOContent />

  <CTASection />
  <Footer />

  <script>
    import { renderRecentTools, trackRecentTool } from '../utils/recent-tools';
    import { initScrollAnimations } from '../utils/scroll-animations';

    // Track current tool and init recent tools display
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    if (path === '/') {
      renderRecentTools('recentToolsList', 3);

      // Tool search filtering
      const searchInput = document.getElementById('toolSearch');
      const clearBtn = document.getElementById('searchClear');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          clearBtn.classList.toggle('visible', query.length > 0);
          document.querySelectorAll('.cat-section').forEach(section => {
            const cards = section.querySelectorAll('.tool-card');
            let hasVisible = false;
            cards.forEach(card => {
              const title = card.querySelector('h3');
              const match = !query || (title && title.textContent.toLowerCase().indexOf(query) !== -1);
              card.style.display = match ? '' : 'none';
              if (match) hasVisible = true;
            });
            section.style.display = hasVisible ? '' : 'none';
          });
        });
        clearBtn.addEventListener('click', function() {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
          searchInput.focus();
        });
      }
    }

    initScrollAnimations();
  </script>
</BaseLayout>
