---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { categories } from '../data/categories';
import { toolBySlug, totalToolsCount } from '../data/tools';

const popularSlugs = ['mortgage-calculator', 'bmi-calculator', 'compound-interest-calculator', 'salary-calculator', 'tip-calculator', 'password-generator'];
const popularTools = popularSlugs.map(s => toolBySlug[s]).filter(Boolean);

const pageTitle = `${totalToolsCount} Free Online Calculators & Tools — Mortgage, BMI, & More | FreeOnlineToolkit`;
const pageDesc = `Access ${totalToolsCount} free online calculators and tools — mortgage calculator, BMI calculator, currency converter, password generator, and more. 100% free, no signup required. Use them instantly in your browser.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Free Online Toolkit",
    "description": pageDesc,
    "url": "https://freeonlinetoolkit.org/",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeOnlineToolkit",
    "url": "https://freeonlinetoolkit.org/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://freeonlinetoolkit.org/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
];
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>

  <main>
  <!-- ============ HERO ============ -->
  <section class="home-hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge animate-entrance animate-entrance-delay-1">
          <i class="fa-solid fa-bolt"></i>
          {totalToolsCount} Free Tools &mdash; No Signup Required
        </div>
        <h1 class="animate-entrance animate-entrance-delay-2"><span>{totalToolsCount} Free Online Calculators</span> for Every Need</h1>
        <p class="animate-entrance animate-entrance-delay-3">
          Fast, accurate calculators and utilities for life's everyday questions &mdash;
          mortgage payments, BMI, passwords, currency conversions, and more.
          All 100% free, no signup required, works instantly in your browser.
        </p>
        <div class="hero-actions animate-entrance animate-entrance-delay-4">
          <a href="#tools" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i> Explore Tools
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SOCIAL PROOF BAR ============ -->
  <div class="social-proof animate-in">
    <div class="social-proof-inner">
      <div class="social-proof-item">
        <i class="fa-solid fa-wrench"></i>
        <span><strong>84</strong> Free Tools</span>
      </div>
      <div class="social-proof-divider"></div>
      <div class="social-proof-item">
        <i class="fa-solid fa-desktop"></i>
        <span><strong>100%</strong> Browser-Based</span>
      </div>
      <div class="social-proof-divider"></div>
      <div class="social-proof-item">
        <i class="fa-solid fa-shield-halved"></i>
        <span><strong>No</strong> Data Collection</span>
      </div>
      <div class="social-proof-divider"></div>
      <div class="social-proof-item">
        <i class="fa-solid fa-bolt"></i>
        <span><strong>Instant</strong> Results</span>
      </div>
    </div>
  </div>

  <!-- ============ SEARCH ============ -->
  <div class="search-section" id="tools">
    <div class="container">
      <div class="search-inner">
        <div class="search-label"><i class="fa-solid fa-magnifying-glass"></i> Find the right tool</div>
        <div class="search-bar">
          <i class="fa-solid fa-search search-bar-icon"></i>
          <input type="text" id="toolSearch" placeholder="Search tools..." autocomplete="off" />
          <span id="searchClear" class="search-clear"><i class="fa-solid fa-xmark"></i></span>
        </div>
        <div id="recentlyUsed" class="recently-used" style="display:none;">
          <div class="recently-used-label"><i class="fa-regular fa-clock"></i> Recently Used</div>
          <div id="recentToolsList" class="recent-tools-list"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ POPULAR TOOLS ============ -->
  <section class="popular-section animate-in" id="popular">
    <div class="popular-section-inner">
      <div class="section-header">
        <div class="section-label">
          <i class="fa-solid fa-fire-flame-curved"></i> Most Popular
        </div>
        <h2>Most Popular</h2>
      </div>
      <div class="popular-grid">
        {popularTools.map((t, i) => (
          <ToolCard tool={t} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CATEGORY SECTIONS ============ -->
  {categories.map((cat) => {
    const catTools = cat.toolSlugs.map(s => toolBySlug[s]).filter(Boolean);
    if (catTools.length === 0) return null;
    return (
      <section class="cat-section">
        <div class="cat-section-inner">
          <div class="section-header animate-in">
            <div class="section-label">
              <i class={`fa-solid ${cat.icon}`}></i> {cat.name}
              <a href={`/category/${cat.id}/`} class="section-view-all">View all <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <h2>{cat.description}</h2>
          </div>
          <div class="tool-grid-home">
            {catTools.map((t, i) => (
              <ToolCard tool={t} index={i} />
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ============ SEO CONTENT ============ -->
  <section class="seo-content animate-in">
    <div class="seo-content-inner">
      <h2>Free Online Calculators — No Signup, No Limits</h2>
      <p>FreeOnlineToolkit.org brings together <strong>{totalToolsCount} powerful online calculators and tools</strong> covering personal finance, health &amp; fitness, home improvement, business planning, and everyday utilities. Every calculator is completely free, works in your browser with instant results, and requires no account or signup. Your data never leaves your device, and there are no usage limits — use each tool as many times as you need.</p>
      <p>Whether you need a <a href="/mortgage-calculator/">mortgage calculator</a>, <a href="/bmi-calculator/">BMI calculator</a>, <a href="/currency-converter/">currency converter</a>, or <a href="/password-generator/">password generator</a> &mdash; you'll find accurate, reliable tools designed for speed and simplicity. Bookmark us for quick access whenever you need a calculation.</p>
      <p>Our tools are organized into <a href="/category/financial/">financial calculators</a>, <a href="/category/health-wellness/">health and wellness tools</a>, <a href="/category/utility/">everyday utilities</a>, <a href="/category/business-finance/">business planning resources</a>, and <a href="/category/education/">educational tools</a>. Each category groups related calculators so you can find what you need without searching through unrelated tools. You can also browse all tools by name using the search bar above.</p>
      <p>For deeper understanding, our <a href="/guides/">guides library</a> offers in-depth articles covering the concepts behind our most popular calculators. Each guide explains the methodology, provides real-world examples, and offers practical tips for applying the results to your situation. Our editorial team regularly reviews and updates both the tools and guides to ensure accuracy.</p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta-section animate-in">
    <div class="cta-inner">
      <h2>Ready to simplify your day?</h2>
      <p>Try any tool in seconds &mdash; no account, no cost, no complications. Just fast, accurate results. Our entire collection of {totalToolsCount} free tools is available to you right now, no strings attached.</p>
      <a href="/mortgage-calculator/" class="btn btn-primary">
        <i class="fa-solid fa-arrow-right"></i> Try a Free Tool Now
      </a>
    </div>
  </section>

  </main>

  <script>
    import { renderRecentTools } from '../utils/recent-tools';
    import { initScrollAnimations } from '../utils/scroll-animations';

    const path = window.location.pathname.replace(/\/$/, '') || '/';
    if (path === '/') {
      renderRecentTools('recentToolsList', 3);

      const searchInput = document.getElementById('toolSearch');
      const clearBtn = document.getElementById('searchClear');
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          if (clearBtn) clearBtn.classList.toggle('visible', query.length > 0);
          document.querySelectorAll('.cat-section').forEach(section => {
            const cards = section.querySelectorAll('.tool-card');
            let hasVisible = false;
            cards.forEach(card => {
              const title = card.querySelector('h3');
              const match = !query || (title && title.textContent.toLowerCase().indexOf(query) !== -1);
              card.style.display = match ? '' : 'none';
              if (match) hasVisible = true;
            });
            section.style.display = hasVisible ? '' : 'none';
          });
        });
        clearBtn?.addEventListener('click', function() {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
          searchInput.focus();
        });
      }
    }

    initScrollAnimations();
  </script>
</BaseLayout>
