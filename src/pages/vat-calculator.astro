---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['vat-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "VAT Explained: Rates, Rules & Free Calculator",
    "description": "Understand Value Added Tax (VAT) rates around the world, how VAT works in the supply chain, and use our free calculator to add or remove VAT from any amount.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2025-01-01",
    "dateModified": "2025-01-01",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate VAT",
    "description": "Add or remove VAT from any amount with customizable VAT rates.",
    "step": [
      { "@type": "HowToStep", "text": "Enter the amount (net or gross)" },
      { "@type": "HowToStep", "text": "Select the VAT rate percentage" },
      { "@type": "HowToStep", "text": "Choose whether to add or remove VAT" },
      { "@type": "HowToStep", "text": "Click Calculate to see the result" },
    ],
  },
];
---

<ToolLayout title="VAT Explained: Rates, Rules & Free Calculator — FreeOnlineToolkit" description="Understand Value Added Tax (VAT) rates around the world, how VAT works, and use our free calculator to add or remove VAT from any amount." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>VAT Explained: Rates, Rules & Free Calculator</h1></fragment>
  <fragment slot="intro">
    <div class="key-takeaways">
      <h2>Key Takeaways</h2>
      <ul>
        <li>VAT (Value Added Tax) is a <strong>consumption tax collected at every stage</strong> of the supply chain, ultimately paid by the end consumer</li>
        <li>Over <strong>170 countries</strong> use VAT — it is the most common type of consumption tax worldwide, though the US uses sales tax instead</li>
        <li>Standard VAT rates range from <strong>5% (UAE, Singapore) to 27% (Hungary)</strong>, with most European countries charging 19-25%</li>
        <li>To add VAT: multiply by (1 + rate). To <strong>reverse-calculate VAT</strong>: divide by (1 + rate) — the formulas are not the same in both directions</li>
        <li>Businesses can typically <strong>reclaim VAT</strong> on their inputs, making it a tax on value added at each stage rather than a cascading tax</li>
      </ul>
    </div>

    <p>Value Added Tax (VAT) is one of the most significant sources of government revenue worldwide. Unlike sales tax, which is collected only at the final point of sale, VAT is collected at every step of the production and distribution chain. When a manufacturer sells raw materials to a factory, VAT is charged. When the factory sells finished goods to a retailer, VAT is charged again — but only on the <em>value added</em> at that stage. This mechanism makes VAT extremely difficult to evade and generates steady revenue for governments across more than 170 countries.</p>

    <p>Understanding how VAT works is essential for anyone running a business, freelancing internationally, or shopping across borders. If you sell goods or services in a VAT country, you must charge VAT on your sales, file regular VAT returns, and remit the tax to the government. On the flip side, you can usually reclaim the VAT you paid on business inputs (raw materials, equipment, services), so the net effect is that you only pay tax on the value your business added. For consumers, VAT is embedded in the sticker price — the amount on the tag already includes the tax.</p>

    <p>VAT rates vary significantly by country and by product category. Most countries have a <strong>standard rate</strong> (applied to most goods and services) and one or more <strong>reduced rates</strong> (applied to essentials like food, children's clothing, books, and medical supplies). The United Kingdom charges 20% standard and 5% reduced. Germany charges 19% standard and 7% reduced. Some items — like education, healthcare, and financial services — are often <strong>VAT-exempt</strong>, meaning no VAT is charged but the supplier cannot reclaim input VAT either.</p>

    <p>The math behind VAT is straightforward but has an important subtlety. When you <strong>add VAT</strong> to a net price, the formula is: Gross = Net × (1 + VAT Rate). When you need to <strong>extract VAT</strong> from a gross price (to find the net amount), the formula reverses: Net = Gross ÷ (1 + VAT Rate). This distinction matters for invoicing, bookkeeping, and pricing — a common mistake is to simply subtract the VAT percentage from the gross price, which gives an incorrect result. The calculator below handles both directions accurately.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>VAT Calculator</h2>
      <div class="form-group">
        <label for="vatAmount">Amount ($)</label>
        <input type="number" id="vatAmount" value="100" min="0" step="0.01">
      </div>
      <div class="form-group">
        <label for="vatRate">VAT Rate (%)</label>
        <input type="number" id="vatRate" value="20" min="0" max="100" step="0.5">
      </div>
      <div class="form-group">
        <label>Calculation Type</label>
        <div style="display:flex;gap:14px;">
          <label style="display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="radio" name="vatType" value="add" checked> Add VAT</label>
          <label style="display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="radio" name="vatType" value="remove"> Remove VAT</label>
        </div>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="vatResult">
        <div class="result-value" id="vatTotal">$0.00</div>
        <div class="result-label" id="vatTotalLabel">Gross Amount (including VAT)</div>
        <div class="result-details">
          <div><span class="label">Net Amount</span><span class="value" id="vatNet">$0.00</span></div>
          <div><span class="label">VAT Amount</span><span class="value" id="vatAmountDisplay">$0.00</span></div>
          <div><span class="label">VAT Rate</span><span class="value" id="vatRateDisplay">0%</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This VAT calculator handles both directions: <strong>adding VAT</strong> to a net amount (for pricing and invoicing) and <strong>removing VAT</strong> from a gross amount (for bookkeeping and reclaim calculations). It shows the net amount, VAT amount, and gross amount, so you can see exactly how the tax breaks down for any rate.</p>
    </div>

    <div class="content-section">
      <h2>How to Use the VAT Calculator</h2>
      <p>Enter an <strong>amount</strong> and the <strong>VAT rate</strong> (default 20%). Choose <strong>Add VAT</strong> to calculate the gross amount including tax, or <strong>Remove VAT</strong> to find the net amount before tax.</p>
      <p>This is useful for businesses creating invoices, checking VAT on receipts, or pricing products and services.</p>
    </div>

    <div class="content-section">
      <h2>Common VAT Rates by Country</h2>
      <ul>
        <li><strong>United Kingdom:</strong> 20% standard, 5% reduced</li>
        <li><strong>Germany:</strong> 19% standard, 7% reduced</li>
        <li><strong>France:</strong> 20% standard, 10% reduced</li>
        <li><strong>Australia (GST):</strong> 10%</li>
        <li><strong>Singapore (GST):</strong> 9%</li>
        <li><strong>UAE:</strong> 5%</li>
      </ul>
    </div>

    <div class="content-section">
      <h2>Next Steps</h2>
      <ul>
        <li><strong>Check your country's current VAT rate</strong> — rates change periodically, and reduced rates vary by product category</li>
        <li><strong>Register for VAT</strong> if your business turnover exceeds the threshold in your country (e.g., £90,000 in the UK as of 2024)</li>
        <li><strong>Keep VAT invoices</strong> for every business purchase — you need them to reclaim input VAT on your returns</li>
        <li><strong>Use accounting software</strong> that automatically calculates and tracks VAT for compliance</li>
        <li><strong>Consult a tax advisor</strong> if you trade internationally, as cross-border VAT rules can be complex</li>
      </ul>
    </div>

    <FAQ items={[
      { question: "What is VAT?", answer: "VAT (Value Added Tax) is a consumption tax added to the price of goods and services. It is collected at each stage of the supply chain and ultimately paid by the end consumer." },
      { question: "How do I calculate VAT manually?", answer: "To add VAT: multiply the net amount by (1 + VAT rate). To remove VAT: divide the gross amount by (1 + VAT rate)." },
      { question: "Is VAT the same as sales tax?", answer: "VAT and sales tax are similar but work differently. VAT is collected at each stage of production, while sales tax is collected only at the point of sale to the consumer." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="vat-calculator" category="financial" />
  </fragment>
</ToolLayout>

<script>
import { getNum, formatCurrency, showResult, hideResult } from '../utils/calculator-utils';

function calcVAT() {
  const amount = getNum('vatAmount')!;
  const rate = getNum('vatRate')!;
  const isAdd = (document.querySelector('input[name="vatType"]:checked') as HTMLInputElement).value === 'add';

  if (!amount || rate === null) return;

  let net: number, vatAmt: number, total: number, label: string;

  if (isAdd) {
    net = amount;
    vatAmt = amount * (rate / 100);
    total = amount + vatAmt;
    label = 'Gross Amount (including VAT)';
  } else {
    total = amount;
    net = amount / (1 + rate / 100);
    vatAmt = amount - net;
    label = 'Net Amount (excluding VAT)';
  }

  document.getElementById('vatTotal')!.textContent = formatCurrency(total);
  document.getElementById('vatTotalLabel')!.textContent = label;
  document.getElementById('vatNet')!.textContent = formatCurrency(net);
  document.getElementById('vatAmountDisplay')!.textContent = formatCurrency(vatAmt);
  document.getElementById('vatRateDisplay')!.textContent = rate + '%';
  showResult('vatResult');
}

function resetVAT() {
  (document.getElementById('vatAmount') as HTMLInputElement).value = '100';
  (document.getElementById('vatRate') as HTMLInputElement).value = '20';
  (document.querySelector('input[name="vatType"][value="add"]') as HTMLInputElement).checked = true;
  hideResult('vatResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcVAT);
document.getElementById('resetBtn')!.addEventListener('click', resetVAT);
document.addEventListener('DOMContentLoaded', calcVAT);
</script>
