---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ToolVisualization from '../components/ToolVisualization.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['compound-interest-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Compound Interest: How Your Money Grows & Free Calculator",
    "description": "Learn how compound interest works, why Einstein allegedly called it the eighth wonder of the world, and how to harness it for long-term wealth building.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.com/compound-interest-calculator" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Compound Interest",
    "description": "Calculate how your investments grow with compound interest over time.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your initial principal or investment amount" },
      { "@type": "HowToStep", "text": "Input the annual interest rate as a percentage" },
      { "@type": "HowToStep", "text": "Choose the compounding frequency" },
      { "@type": "HowToStep", "text": "Set the investment time period in years" },
      { "@type": "HowToStep", "text": "Click Calculate to see the final amount and total interest earned" },
    ],
  },
];
---

<ToolLayout title="Compound Interest: How Your Money Grows & Free Calculator" description="Learn how compound interest works, why Einstein allegedly called it the eighth wonder of the world, and how to harness it for long-term wealth building." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Compound Interest: How Your Money Grows & Free Calculator</h1></fragment>
  <fragment slot="intro">
    <div class="takeaway-box" style="background:var(--color-surface-alt, #f0f7ff);border-left:4px solid var(--color-primary,#2563eb);padding:16px 20px;border-radius:8px;margin-bottom:24px;">
      <h2 style="margin:0 0 10px;font-size:1rem;">Key Takeaways</h2>
      <ul style="margin:0;padding-left:20px;line-height:1.8;">
        <li>Compound interest means you earn <strong>interest on your interest</strong> — creating exponential growth over time.</li>
        <li>Time is the most powerful factor. Starting 10 years earlier can mean <strong>double the final balance</strong>, even with the same contributions.</li>
        <li>Monthly contributions supercharge compounding — regular investing of even small amounts adds up dramatically over decades.</li>
        <li>The difference between daily and yearly compounding is small, but the difference between <strong>starting now vs. later</strong> is enormous.</li>
        <li>Compound interest works against you on debt (credit cards, loans) just as powerfully as it works for you on investments.</li>
      </ul>
    </div>

    <p>Albert Einstein reportedly called compound interest "the eighth wonder of the world." Whether or not he actually said it, the math backs up the sentiment. Compound interest is the single most powerful force in personal finance — and understanding it is the difference between building wealth and watching it stagnate.</p>

    <p>Here's the core concept: with simple interest, you earn returns only on your original investment. With compound interest, you earn returns on your original investment <em>plus</em> all the interest you've already earned. It's a snowball effect. In year one, the difference is negligible. By year 20 or 30, it's staggering. $10,000 invested at 7% grows to about $19,672 with simple interest over 30 years. With compound interest (monthly), it grows to $81,165 — more than four times as much.</p>

    <p>The three levers of compounding are <strong>rate</strong>, <strong>time</strong>, and <strong>contributions</strong>. You can't always control the rate — markets fluctuate, and savings account rates change. But you can control when you start and how much you add. A 25-year-old who invests $200/month at 7% will have roughly $525,000 by age 65. A 35-year-old making the same contributions will have about $243,000. That 10-year head start is worth more than $280,000 — and the early investor didn't contribute a single dollar more per month.</p>

    <p>Compounding also works against you. Credit card debt compounds daily at rates of 18-25%, which is why a $5,000 balance can balloon to $8,000+ if you only make minimum payments. Understanding compounding is essential for both sides of your financial life — growing your savings and shrinking your debt.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Compound Interest Calculator</h2>
      <div class="form-group">
        <label for="principal">Initial Principal ($)</label>
        <input type="number" id="principal" value="10000" min="0" step="100">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="rate">Annual Interest Rate (%)</label>
          <input type="number" id="rate" value="7" min="0" step="0.1">
        </div>
        <div class="form-group">
          <label for="years">Time Period (Years)</label>
          <input type="number" id="years" value="10" min="1" max="100">
        </div>
      </div>
      <div class="form-group">
        <label for="compoundFreq">Compound Frequency</label>
        <select id="compoundFreq">
          <option value="365">Daily</option>
          <option value="12" selected>Monthly</option>
          <option value="4">Quarterly</option>
          <option value="1">Yearly</option>
        </select>
      </div>
      <div class="form-group">
        <label for="monthlyAdd">Monthly Additional Contribution ($)</label>
        <input type="number" id="monthlyAdd" value="0" min="0" step="50">
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="compoundResult">
        <div class="result-value" id="futureValue">$0.00</div>
        <div class="result-label">Future Value (Total After Growth)</div>
        <div class="result-details">
          <div><span class="label">Total Contributions</span><span class="value" id="totalContrib">$0</span></div>
          <div><span class="label">Total Interest Earned</span><span class="value" id="interestEarned">$0</span></div>
          <div><span class="label">Effective Annual Rate</span><span class="value" id="effectiveRate">0%</span></div>
        </div>
      </div>
    </div>

    <ToolVisualization
      type="bar"
      color={tool.color}
      title="$10,000 Growth Over Time (7% compounded monthly)"
      data={[
        { label: "5 Years", value: "$14,176", pct: 17 },
        { label: "10 Years", value: "$20,097", pct: 25 },
        { label: "20 Years", value: "$40,387", pct: 50 },
        { label: "30 Years", value: "$81,165", pct: 100 }
      ]}
    />
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This calculator projects how your money grows with compound interest, factoring in your initial investment, the interest rate, compounding frequency, and any regular contributions you plan to make. The bar chart illustrates the exponential nature of compounding — notice how the growth accelerates dramatically in later years. Use it to compare different scenarios and see why starting early matters so much.</p>
    </div>

    <div class="content-section">
      <h2>The Compound Interest Formula</h2>
      <div class="formula-box">
        A = P(1 + r/n)^nt + PMT × [((1 + r/n)^nt - 1) / (r/n)]
      </div>
      <p>Where: <strong>A</strong> = future value, <strong>P</strong> = principal, <strong>r</strong> = annual rate, <strong>n</strong> = compounding periods per year, <strong>t</strong> = years, and <strong>PMT</strong> = monthly contribution.</p>
    </div>

    <div class="content-section">
      <h2>Why Compounding Frequency Matters</h2>
      <p>The more frequently interest compounds, the faster your money grows. Daily compounding yields the highest return, followed by monthly, quarterly, and yearly. For example, $10,000 invested at 7% for 10 years grows to:</p>
      <ul>
        <li><strong>$20,116</strong> with daily compounding</li>
        <li><strong>$20,097</strong> with monthly compounding</li>
        <li><strong>$20,030</strong> with quarterly compounding</li>
        <li><strong>$19,672</strong> with yearly compounding</li>
      </ul>
      <p>The differences are small because compounding frequency has a diminishing effect. What matters far more is the rate itself and how long you stay invested.</p>
    </div>

    <div class="content-section">
      <h2>The Rule of 72: A Quick Mental Shortcut</h2>
      <p>Want to know how long it takes to double your money? Divide 72 by the annual interest rate. At 7%, your money doubles in roughly 72 ÷ 7 = <strong>10.3 years</strong>. At 10%, it's about 7.2 years. This rule works surprisingly well for rates between 4% and 15% and gives you a quick way to compare investment options without a calculator.</p>
    </div>

    <div class="content-section">
      <h2>Compound Interest and Debt: The Other Side</h2>
      <p>Compounding isn't always your friend. Credit cards compound interest daily on your unpaid balance, which means debt grows exponentially if you only make minimum payments. A $5,000 credit card balance at 22% APR, paid at $100/month, costs over $2,400 in interest and takes 6+ years to pay off. The same debt paid at $200/month is gone in 2.5 years with only $730 in interest. Understanding compounding helps you prioritize which debts to pay off first.</p>
    </div>

    <FAQ items={[
      { question: "What is compound interest?", answer: "Compound interest is interest calculated on both your initial principal and the accumulated interest from previous periods. This creates a snowball effect where your money grows exponentially over time." },
      { question: "How often should interest compound?", answer: "More frequent compounding means slightly more growth. Daily compounding yields the highest return, followed by monthly, quarterly, and yearly. Most high-yield savings accounts compound daily." },
      { question: "What's the difference between APR and APY?", answer: "APR (Annual Percentage Rate) is the simple interest rate without compounding. APY (Annual Percentage Yield) includes the effect of compounding. APY is always higher than APR when compounding occurs more than once per year." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Now that you understand the power of compounding, put it to work:</p>
      <ul style="line-height:1.8;">
        <li><strong>Start now, even with small amounts.</strong> The biggest factor in compounding is time. Even $50/month invested at 25 grows to over $100,000 by 65 at 7% returns.</li>
        <li><strong>Automate your contributions.</strong> Set up automatic transfers to a high-yield savings account or investment account. Consistency beats timing.</li>
        <li><strong>Choose the right vehicle.</strong> For short-term savings (under 5 years), use a high-yield savings account. For long-term goals, index funds in a tax-advantaged account (401k, IRA) historically offer higher returns.</li>
        <li><strong>Don't interrupt the compounding.</strong> Withdrawing money or stopping contributions resets the snowball. Let it roll.</li>
        <li><strong>Attack high-interest debt first.</strong> If you have credit card debt at 20%+, paying it off is a guaranteed 20% return — better than any investment.</li>
      </ul>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="compound-interest-calculator" category="financial" />
  </fragment>
</ToolLayout>

<script>
import { getNum, formatCurrency, showResult, hideResult } from '../utils/calculator-utils';

function calcCompound() {
  const P = getNum('principal')!;
  const r = getNum('rate')! / 100;
  const t = getNum('years')!;
  const n = parseInt((document.getElementById('compoundFreq') as HTMLSelectElement).value);
  const PMT = getNum('monthlyAdd') || 0;

  if (!P || !r || !t) return;

  const fvPrincipal = P * Math.pow(1 + r / n, n * t);
  let fvContributions = 0;
  if (PMT > 0) {
    const i = r / n;
    const periods = n * t;
    if (r > 0) {
      const pmtPerPeriod = PMT * 12 / n;
      fvContributions = pmtPerPeriod * (Math.pow(1 + i, periods) - 1) / i;
    } else {
      fvContributions = PMT * 12 * t;
    }
  }

  const total = fvPrincipal + fvContributions;
  const totalContrib = P + (PMT * 12 * t);
  const interest = total - totalContrib;
  const effectiveRate = (Math.pow(1 + r / n, n) - 1) * 100;

  document.getElementById('futureValue')!.textContent = formatCurrency(total);
  document.getElementById('totalContrib')!.textContent = formatCurrency(totalContrib);
  document.getElementById('interestEarned')!.textContent = formatCurrency(interest);
  document.getElementById('effectiveRate')!.textContent = effectiveRate.toFixed(2) + '%';
  showResult('compoundResult');
}

function resetCompound() {
  (document.getElementById('principal') as HTMLInputElement).value = '10000';
  (document.getElementById('rate') as HTMLInputElement).value = '7';
  (document.getElementById('years') as HTMLInputElement).value = '10';
  (document.getElementById('compoundFreq') as HTMLSelectElement).value = '12';
  (document.getElementById('monthlyAdd') as HTMLInputElement).value = '0';
  hideResult('compoundResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcCompound);
document.getElementById('resetBtn')!.addEventListener('click', resetCompound);
document.addEventListener('DOMContentLoaded', calcCompound);
</script>
