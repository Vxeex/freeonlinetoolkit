---
import InfoLayout from '../layouts/InfoLayout.astro';

const team = [
  {
    name: 'Sarah Chen',
    role: 'Lead Calculator Analyst',
    bio: 'Sarah has spent over 8 years in the fintech industry, building and validating financial calculators for major banking platforms. She specializes in mortgage, loan, and investment tools, ensuring every formula meets industry standards. Her background in applied mathematics and data science drives the accuracy behind every calculator on FreeOnlineToolkit.',
    expertise: ['Mortgage & Loan Calculators', 'Financial Modeling', 'Data Validation', 'Fintech UX Research'],
    icon: 'fa-chart-line',
  },
  {
    name: 'Marcus Williams',
    role: 'Health & Wellness Editor',
    bio: 'Marcus is a registered dietitian and certified personal trainer with over 10 years of experience in clinical nutrition and fitness programming. He reviews all health-related tools on FreeOnlineToolkit to ensure they align with current medical guidelines and evidence-based practices. His passion is making health metrics accessible and actionable for everyday people.',
    expertise: ['BMI & Body Composition', 'Nutrition Science', 'Fitness Programming', 'Medical Guidelines Review'],
    icon: 'fa-heart-pulse',
  },
  {
    name: 'Priya Sharma',
    role: 'Finance & Tax Specialist',
    bio: 'Priya is a Certified Public Accountant (CPA) with expertise in personal income tax, corporate finance, and financial planning. She has worked with Big Four accounting firms and now focuses on making complex tax and financial concepts understandable for a general audience. She ensures all tax-related calculators reflect current IRS guidelines and rates.',
    expertise: ['Federal & State Tax Law', 'Personal Finance Planning', 'Salary & Payroll Analysis', 'Financial Education'],
    icon: 'fa-calculator',
  },
];
---

<InfoLayout title="Our Editorial Team | FreeOnlineToolkit" description="Meet the expert editorial team behind FreeOnlineToolkit's calculators and tools. Our team of analysts, editors, and specialists ensures every tool is accurate, up-to-date, and easy to use.">

  <div class="editors-page">
    <div class="editors-header">
      <h1>Our Editorial Team</h1>
      <p class="editors-intro">
        Every calculator and tool on FreeOnlineToolkit is reviewed by our expert team to ensure accuracy, clarity, and real-world usefulness. Meet the people behind the numbers.
      </p>
    </div>

    <div class="team-grid">
      {team.map((member) => (
        <div class="team-card">
          <div class="team-avatar">
            <i class={`fas ${member.icon}`}></i>
          </div>
          <div class="team-content">
            <h2 class="team-name">{member.name}</h2>
            <span class="team-role">{member.role}</span>
            <p class="team-bio">{member.bio}</p>
            <div class="team-expertise">
              <span class="expertise-label">Areas of Expertise</span>
              <ul class="expertise-list">
                {member.expertise.map((area) => (
                  <li>{area}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="editors-commitment">
      <h2>Our Commitment to Quality</h2>
      <p>
        Every tool on FreeOnlineToolkit undergoes a rigorous review process before publication. Our editorial team verifies formulas against industry standards, checks data sources for accuracy, and tests each calculator with real-world scenarios. We update our tools regularly to reflect changes in tax law, interest rates, medical guidelines, and other time-sensitive data.
      </p>
      <p>
        Have feedback or suggestions? <a href="/contact/">Get in touch</a> — we read every message.
      </p>
    </div>
  </div>

  <style>
    .editors-page {
      max-width: 860px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
    }
    .editors-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .editors-header h1 {
      font-size: 1.75rem;
      margin-bottom: 0.5rem;
    }
    .editors-intro {
      font-size: 1rem;
      color: var(--color-text-secondary);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.65;
    }
    .team-grid {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }
    .team-card {
      display: flex;
      gap: 1.25rem;
      padding: 1.25rem;
      background: var(--color-surface, #fff);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md, 10px);
    }
    .team-avatar {
      flex-shrink: 0;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-primary);
      color: #fff;
      border-radius: 50%;
      font-size: 1.25rem;
    }
    .team-content {
      flex: 1;
      min-width: 0;
    }
    .team-name {
      font-size: 1.1rem;
      margin: 0 0 0.15rem;
    }
    .team-role {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--color-primary);
      margin-bottom: 0.5rem;
    }
    .team-bio {
      font-size: 0.88rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
      margin-bottom: 0.75rem;
    }
    .expertise-label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--color-text-muted);
      display: block;
      margin-bottom: 0.3rem;
    }
    .expertise-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .expertise-list li {
      font-size: 0.75rem;
      padding: 0.2rem 0.55rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border-light);
      border-radius: 4px;
      color: var(--color-text-secondary);
    }
    .editors-commitment {
      padding: 1.25rem;
      background: var(--color-surface, #fff);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md, 10px);
    }
    .editors-commitment h2 {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
    }
    .editors-commitment p {
      font-size: 0.88rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
      margin-bottom: 0.75rem;
    }
    .editors-commitment a {
      color: var(--color-primary);
      font-weight: 600;
    }
    @media (max-width: 600px) {
      .team-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .expertise-list {
        justify-content: center;
      }
    }
  </style>
</InfoLayout>
