---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['micro-saas-profit-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Micro SaaS Profit",
    "description": "Estimate your micro SaaS net income based on monthly recurring revenue, churn rate, and operating costs.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your number of monthly paying users" },
      { "@type": "HowToStep", "text": "Enter your average monthly price per user" },
      { "@type": "HowToStep", "text": "Enter your monthly churn rate" },
      { "@type": "HowToStep", "text": "Enter your monthly operating costs and annual salary draw" },
      { "@type": "HowToStep", "text": "Click Calculate to see your MRR, profit, and net income" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is a good MRR for a micro SaaS?", "acceptedAnswer": { "@type": "Answer", "text": "A good MRR depends on your goals. For a solo founder, $3,000-$10,000 MRR can provide a decent side income, while $10,000-$50,000 MRR is considered a sustainable full-time micro SaaS. Many bootstrapped SaaS companies reach profitability between $1,000 and $3,000 MRR." } },
      { "@type": "Question", "name": "What is an acceptable churn rate?", "acceptedAnswer": { "@type": "Answer", "text": "For most SaaS businesses, a monthly churn rate below 5% is acceptable, and below 3% is good. Top-performing SaaS companies achieve under 2% monthly churn. For micro SaaS products with lower price points, 5-7% monthly churn is common, while higher-priced products tend to have lower churn rates." } },
      { "@type": "Question", "name": "How much can a micro SaaS founder earn?", "acceptedAnswer": { "@type": "Answer", "text": "Micro SaaS founder earnings vary widely. A profitable micro SaaS with 200-500 users at $29/month can generate $5,800-$14,500 MRR. After operating costs and taxes, many solo founders take home $40,000-$120,000 per year. The key is keeping operating costs low and focusing on a niche audience." } },
    ],
  },
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">Estimate your micro SaaS net income based on monthly recurring revenue (MRR), churn rate, operating costs, and founder salary. See if your SaaS idea is financially sustainable.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>SaaS Profit Calculator</h2>
      <div class="form-group">
        <label for="saasUsers">Monthly Paying Users</label>
        <input type="number" id="saasUsers" value="100" min="0">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="saasPrice">Average Monthly Price ($)</label>
          <input type="number" id="saasPrice" value="29" min="0" step="1">
        </div>
        <div class="form-group">
          <label for="saasChurn">Monthly Churn Rate (%)</label>
          <input type="number" id="saasChurn" value="5" min="0" step="0.1">
        </div>
      </div>
      <div class="form-group">
        <label for="saasCosts">Monthly Operating Costs ($) <span style="font-weight:400;font-size:0.85rem;color:var(--color-text-muted);">(hosting, tools, subscriptions)</span></label>
        <input type="number" id="saasCosts" value="2000" min="0" step="50">
      </div>
      <div class="form-group">
        <label for="saasSalary">Annual Salary Draw ($) <span style="font-weight:400;font-size:0.85rem;color:var(--color-text-muted);">(what you pay yourself)</span></label>
        <input type="number" id="saasSalary" value="60000" min="0" step="1000">
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn">Reset</button>
      </div>

      <div class="result-box" id="saasResult">
        <div style="font-weight:600;font-size:1.05rem;margin-bottom:10px;color:var(--color-text);">Revenue & Profit Summary</div>
        <div class="result-details">
          <div><span class="label">Monthly Recurring Revenue (MRR)</span><span class="value" id="saasMRR">$0</span></div>
          <div><span class="label">Annual Recurring Revenue (ARR)</span><span class="value" id="saasARR">$0</span></div>
          <div><span class="label">Monthly Churned Revenue</span><span class="value" id="saasChurnedRev" style="color:var(--color-danger);">$0</span></div>
          <div><span class="label">Net MRR (after churn)</span><span class="value" id="saasNetMRR">$0</span></div>
          <div><span class="label">Monthly Operating Profit</span><span class="value" id="saasOpProfit">$0</span></div>
          <div><span class="label">Annual Operating Profit</span><span class="value" id="saasAnnOpProfit">$0</span></div>
          <div><span class="label">Net Income After Salary</span><span class="value" id="saasNetIncome" style="font-weight:700;">$0</span></div>
          <div><span class="label">Monthly Customers Lost</span><span class="value" id="saasLost">0</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How to Use</h2>
      <p>This micro SaaS profit calculator helps you model the financial health of your SaaS business. Start by entering your <strong>monthly paying users</strong> and <strong>average monthly price</strong> to calculate your MRR. Then add your <strong>churn rate</strong> to see how much revenue you lose each month.</p>
      <p>Include your <strong>monthly operating costs</strong> (hosting, SaaS tools, payment processing, etc.) and your <strong>annual salary draw</strong> to determine whether your business is sustainable. The calculator shows both your operating profit and your net income after paying yourself.</p>
      <p>If the net income is negative, it means your business is not covering your salary — a sign that you need to grow revenue, reduce churn, or cut costs.</p>
    </div>

    <div class="content-section">
      <h2>Key SaaS Metrics Explained</h2>
      <ul>
        <li><strong>MRR (Monthly Recurring Revenue):</strong> Your predictable monthly revenue from paying users. Calculated as users &times; average price.</li>
        <li><strong>ARR (Annual Recurring Revenue):</strong> Your MRR multiplied by 12. A key metric investors look at to gauge business size.</li>
        <li><strong>Churned Revenue:</strong> The revenue you lose each month due to cancellations. Keeping this low is critical for growth.</li>
        <li><strong>Net MRR:</strong> What remains after churn. This is your true monthly revenue before expenses.</li>
        <li><strong>Operating Profit:</strong> Net MRR minus operating costs. This shows whether your core business covers its expenses.</li>
      </ul>
    </div>

    <div class="content-section">
      <h2>SaaS Profit Formulas</h2>
      <div class="formula-box">
        <strong>MRR</strong> = Users &times; Price<br>
        <strong>ARR</strong> = MRR &times; 12<br>
        <strong>Churned Revenue</strong> = MRR &times; (Churn Rate / 100)<br>
        <strong>Net MRR</strong> = MRR &minus; Churned Revenue<br>
        <strong>Operating Profit</strong> = Net MRR &minus; Operating Costs<br>
        <strong>Annual Operating Profit</strong> = Operating Profit &times; 12<br>
        <strong>Net Income</strong> = Annual Operating Profit &minus; Salary Draw<br>
        <strong>Customers Lost</strong> = Users &times; (Churn Rate / 100)
      </div>
    </div>

    <FAQ items={[
      { question: "What is a good MRR for a micro SaaS?", answer: "A good MRR depends on your goals. For a solo founder, $3,000-$10,000 MRR can provide a decent side income, while $10,000-$50,000 MRR is considered a sustainable full-time micro SaaS. Many bootstrapped SaaS companies reach profitability between $1,000 and $3,000 MRR." },
      { question: "What is an acceptable churn rate?", answer: "For most SaaS businesses, a monthly churn rate below 5% is acceptable, and below 3% is good. Top-performing SaaS companies achieve under 2% monthly churn. For micro SaaS products with lower price points, 5-7% monthly churn is common, while higher-priced products tend to have lower churn rates." },
      { question: "How much can a micro SaaS founder earn?", answer: "Micro SaaS founder earnings vary widely. A profitable micro SaaS with 200-500 users at $29/month can generate $5,800-$14,500 MRR. After operating costs and taxes, many solo founders take home $40,000-$120,000 per year. The key is keeping operating costs low and focusing on a niche audience." },
      { question: "What are typical micro SaaS operating costs?", answer: "Typical monthly operating costs for a micro SaaS include hosting ($20-$200), third-party APIs ($50-$500), domain and email ($10-$50), analytics and monitoring ($20-$100), and payment processing fees (2.9% + $0.30 per transaction). Total monthly costs typically range from $100 to $2,000." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="micro-saas-profit-calculator" category="saas" />
  </fragment>
</ToolLayout>

<script>
import { getNum, formatCurrency, showResult, hideResult } from '../utils/calculator-utils';

function calcSaaS() {
  let users = getNum('saasUsers') || 0;
  let price = getNum('saasPrice') || 0;
  let churn = getNum('saasChurn') || 0;
  let costs = getNum('saasCosts') || 0;
  let salary = getNum('saasSalary') || 0;

  const mrr = users * price;
  const arr = mrr * 12;
  const churnedRev = mrr * (churn / 100);
  const netMRR = mrr - churnedRev;
  const opProfit = netMRR - costs;
  const annOpProfit = opProfit * 12;
  const netIncome = annOpProfit - salary;
  const lost = users * (churn / 100);

  document.getElementById('saasMRR').textContent = formatCurrency(mrr);
  document.getElementById('saasARR').textContent = formatCurrency(arr);
  document.getElementById('saasChurnedRev').textContent = formatCurrency(churnedRev);
  document.getElementById('saasNetMRR').textContent = formatCurrency(netMRR);
  document.getElementById('saasOpProfit').textContent = formatCurrency(opProfit);
  document.getElementById('saasAnnOpProfit').textContent = formatCurrency(annOpProfit);

  const netEl = document.getElementById('saasNetIncome');
  if (netIncome < 0) {
    netEl.textContent = '-' + formatCurrency(Math.abs(netIncome));
    (netEl as HTMLElement).style.color = '#dc2626';
  } else {
    netEl.textContent = formatCurrency(netIncome);
    (netEl as HTMLElement).style.color = '#059669';
  }

  document.getElementById('saasLost').textContent = lost.toFixed(1);
  showResult('saasResult');
}

function resetSaaS() {
  (document.getElementById('saasUsers') as HTMLInputElement).value = '100';
  (document.getElementById('saasPrice') as HTMLInputElement).value = '29';
  (document.getElementById('saasChurn') as HTMLInputElement).value = '5';
  (document.getElementById('saasCosts') as HTMLInputElement).value = '2000';
  (document.getElementById('saasSalary') as HTMLInputElement).value = '60000';
  hideResult('saasResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcSaaS);
document.getElementById('resetBtn')!.addEventListener('click', resetSaaS);
document.addEventListener('DOMContentLoaded', calcSaaS);
</script>
