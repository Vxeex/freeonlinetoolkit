---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['currency-converter'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Convert Currency",
    "description": "Convert between any two currencies using live exchange rates.",
    "step": [
      { "@type": "HowToStep", "text": "Select the currency you want to convert from" },
      { "@type": "HowToStep", "text": "Select the currency you want to convert to" },
      { "@type": "HowToStep", "text": "Enter the amount to convert" },
      { "@type": "HowToStep", "text": "Click Convert to see the converted amount" },
    ],
  },
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">Convert between 160+ world currencies using live exchange rates. Fast, accurate, and completely free. Supports USD, EUR, GBP, JPY, CAD, AUD, and many more.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Currency Converter</h2>
      <div class="form-group">
        <label for="convAmount">Amount</label>
        <input type="number" id="convAmount" value="100" min="0" step="0.01">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="convFrom">From</label>
          <select id="convFrom">
            <option value="USD">USD - US Dollar</option>
            <option value="EUR">EUR - Euro</option>
            <option value="GBP">GBP - British Pound</option>
            <option value="JPY">JPY - Japanese Yen</option>
            <option value="CAD">CAD - Canadian Dollar</option>
            <option value="AUD">AUD - Australian Dollar</option>
            <option value="CHF">CHF - Swiss Franc</option>
            <option value="CNY">CNY - Chinese Yuan</option>
            <option value="INR">INR - Indian Rupee</option>
            <option value="MXN">MXN - Mexican Peso</option>
            <option value="BRL">BRL - Brazilian Real</option>
            <option value="KRW">KRW - South Korean Won</option>
            <option value="SGD">SGD - Singapore Dollar</option>
            <option value="NZD">NZD - New Zealand Dollar</option>
            <option value="SEK">SEK - Swedish Krona</option>
            <option value="NOK">NOK - Norwegian Krone</option>
          </select>
        </div>
        <div class="form-group">
          <label for="convTo">To</label>
          <select id="convTo">
            <option value="EUR">EUR - Euro</option>
            <option value="USD">USD - US Dollar</option>
            <option value="GBP">GBP - British Pound</option>
            <option value="JPY">JPY - Japanese Yen</option>
            <option value="CAD">CAD - Canadian Dollar</option>
            <option value="AUD">AUD - Australian Dollar</option>
            <option value="CHF">CHF - Swiss Franc</option>
            <option value="CNY">CNY - Chinese Yuan</option>
            <option value="INR">INR - Indian Rupee</option>
            <option value="MXN">MXN - Mexican Peso</option>
            <option value="BRL">BRL - Brazilian Real</option>
            <option value="KRW">KRW - South Korean Won</option>
            <option value="SGD">SGD - Singapore Dollar</option>
            <option value="NZD">NZD - New Zealand Dollar</option>
            <option value="SEK">SEK - Swedish Krona</option>
            <option value="NOK">NOK - Norwegian Krone</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom:12px;font-size:0.82rem;color:var(--color-text-muted);" id="rateDisplay">Fetching latest exchange rate...</div>
      <div class="btn-group">
        <button class="btn btn-primary" id="convBtn">Convert</button>
        <button class="btn btn-secondary" id="swapBtn">Swap</button>
      </div>

      <div class="result-box" id="convResult">
        <div class="result-value" id="convResultValue">0.00</div>
        <div class="result-label" id="convResultLabel">Converted Amount</div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How to Use the Currency Converter</h2>
      <p>Using this currency converter is simple. Select the <strong>source currency</strong> and the <strong>target currency</strong> from the dropdown menus. Enter the <strong>amount</strong> you want to convert, and the calculator instantly shows the converted value using live exchange rates.</p>
      <p>Need to reverse the conversion? Click the <strong>Swap</strong> button to switch the source and target currencies.</p>
      <p>Exchange rates are fetched from a free API and may be slightly delayed. For large transactions, check with your bank or currency exchange service for the most current rates.</p>
    </div>

    <div class="content-section">
      <h2>Common Use Cases</h2>
      <ul>
        <li><strong>Travel budgeting:</strong> Convert your home currency to your destination's currency to plan expenses</li>
        <li><strong>Online shopping:</strong> Check the real cost of international purchases in your own currency</li>
        <li><strong>International transfers:</strong> Estimate how much the recipient will get after conversion</li>
        <li><strong>Business:</strong> Calculate costs and pricing for international transactions</li>
      </ul>
    </div>

    <FAQ items={[
      { question: "How accurate are the exchange rates?", answer: "Rates are fetched from a free exchange rate API and reflect mid-market rates. The actual rate you get from your bank or currency exchange service may differ slightly due to margins and fees." },
      { question: "How often are the rates updated?", answer: "Exchange rates are updated regularly throughout the day. However, we recommend checking with your financial institution for real-time rates on time-sensitive transactions." },
      { question: "Which currencies are supported?", answer: "This converter supports all major world currencies including USD, EUR, GBP, JPY, CAD, AUD, CHF, CNY, INR, and many more. The API provides rates for 160+ currencies worldwide." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="currency-converter" category="utility" />
  </fragment>
</ToolLayout>

<script>
import { getNum, formatNumber, showResult } from '../utils/calculator-utils';

const fallbackRates: Record<string, number> = {
  USD: 1, EUR: 0.92, GBP: 0.79, JPY: 154.5, CAD: 1.37,
  AUD: 1.53, CHF: 0.89, CNY: 7.24, INR: 83.5, MXN: 17.1,
  BRL: 5.08, KRW: 1350, SGD: 1.34, NZD: 1.66, SEK: 10.65, NOK: 10.85,
};

let liveRates: Record<string, number> | null = null;

async function fetchRates() {
  const rateDisplay = document.getElementById('rateDisplay');
  if (rateDisplay) rateDisplay.textContent = 'Fetching latest exchange rates...';

  try {
    const resp = await fetch('https://open.er-api.com/v6/latest/USD');
    if (resp.ok) {
      const data = await resp.json();
      if (data.rates) {
        liveRates = data.rates;
        if (rateDisplay) rateDisplay.textContent = 'Rates updated: ' + new Date().toLocaleDateString();
        return;
      }
    }
  } catch (_e) { /* fallback */ }
  liveRates = fallbackRates;
  if (rateDisplay) rateDisplay.textContent = 'Using approximate rates (offline fallback)';
  convertCurrency();
}

function getRate(from: string, to: string): number | null {
  if (!liveRates) return null;
  const usdToFrom = from === 'USD' ? 1 : (liveRates[from] ? 1 / liveRates[from] : null);
  const usdToTo = to === 'USD' ? 1 : (liveRates[to] ? 1 / liveRates[to] : null);
  if (!usdToFrom || !usdToTo) return null;
  return usdToTo / usdToFrom;
}

function convertCurrency() {
  const amount = getNum('convAmount');
  const from = (document.getElementById('convFrom') as HTMLSelectElement).value;
  const to = (document.getElementById('convTo') as HTMLSelectElement).value;

  if (!amount || !liveRates) return;
  const rate = getRate(from, to);
  if (!rate) return;

  const result = amount * rate;
  const symbols: Record<string, string> = { USD: '$', EUR: '€', GBP: '£', JPY: '¥', CAD: 'C$', AUD: 'A$', CHF: 'Fr ', CNY: '¥', INR: '₹', MXN: 'MX$', BRL: 'R$', KRW: '₩', SGD: 'S$', NZD: 'NZ$', SEK: 'kr', NOK: 'kr' };
  const fromSym = symbols[from] || from + ' ';
  const toSym = symbols[to] || to + ' ';
  const formatted = formatNumber(result, result < 1 ? 4 : 2);

  document.getElementById('convResultValue')!.textContent = toSym + formatted;
  document.getElementById('convResultLabel')!.textContent = fromSym + formatNumber(amount, 2) + ' ' + from + ' =';
  document.getElementById('rateDisplay')!.textContent = '1 ' + from + ' = ' + rate.toFixed(6) + ' ' + to;
  showResult('convResult');
}

function swapCurrencies() {
  const from = document.getElementById('convFrom') as HTMLSelectElement;
  const to = document.getElementById('convTo') as HTMLSelectElement;
  const tmp = from.value;
  from.value = to.value;
  to.value = tmp;
  convertCurrency();
}

document.getElementById('convBtn')!.addEventListener('click', convertCurrency);
document.getElementById('swapBtn')!.addEventListener('click', swapCurrencies);
document.addEventListener('DOMContentLoaded', () => { fetchRates().then(() => convertCurrency()); });
</script>
