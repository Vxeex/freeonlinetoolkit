---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['pizza-dough-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Pizza Dough: Perfect Recipe with Baker's Percentages",
    "description": "Pizza Dough — comprehensive guide with free online calculator. Baker's percentages express every ingredient as a percentage of the flour weight (which is always 100%), making it easy to scale recipes to any batch size. Hydration percentage (water relative to flour) is the most important variable: 60% produces firm, easy-to-handle dough, while 75–80% creates airy, open-crumb doughs that require more skill.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/pizza-dough-calculator/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Pizza Dough with Baker's Percentages",
    "description": "Get exact flour, water, yeast, and salt amounts for perfect pizza dough using baker's percentages.",
    "step": [
      { "@type": "HowToStep", "text": "Choose your pizza style (Neapolitan, New York, Sicilian, Pan, or Custom)" },
      { "@type": "HowToStep", "text": "Enter the number of pizzas and select hydration level" },
      { "@type": "HowToStep", "text": "Click Calculate to see exact ingredient amounts" },
      { "@type": "HowToStep", "text": "Weigh ingredients and follow the recommended rise time" },
    ],
  },
];
---

<ToolLayout title="Pizza Dough: Perfect Recipe with Baker's Percentages | FreeOnlineToolkit" description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Pizza Dough: Perfect Recipe with Baker's Percentages</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>Baker's percentages express every ingredient as a percentage of the flour weight (which is always 100%), making it easy to scale recipes to any batch size.</li>
      <li>Hydration percentage (water relative to flour) is the most important variable: 60% produces firm, easy-to-handle dough, while 75–80% creates airy, open-crumb doughs that require more skill.</li>
      <li>Cold fermentation in the fridge for 24–72 hours develops far more complex flavours than a same-day room-temperature rise.</li>
      <li>The four essential ingredients are flour, water, yeast (~0.5–1%), and salt (~2–3%) — everything else is optional.</li>
    </ul>
  </div>

  <p>Making great pizza dough at home is surprisingly simple once you understand baker's percentages — a system professional bakers use to express recipes as ratios rather than fixed quantities. Once you know the ratios, you can scale a recipe from a single pizza to a hundred without guessing, and you can adjust hydration, yeast, and salt to match your preferred style.</p>

  <p>The concept is elegant: flour is always 100%, and every other ingredient is expressed as a percentage of the flour weight. So 65% hydration means the water weighs 65% of the flour weight. If you are using 500g of flour, you need 325g of water (500 × 0.65). Salt at 2% means 10g. Yeast at 0.6% means 3g. This system scales perfectly — double the flour, double everything else.</p>

  <p>Different pizza styles call for different hydration levels. Neapolitan pizza (the classic thin-crust style from Naples) typically uses 60–65% hydration and is cooked at extremely high temperatures (800–900°F). New York style uses 63–67% hydration for a foldable, slightly chewy crust. Sicilian and Detroit styles use 70–80% hydration for an airy, focaccia-like crumb.</p>

  <p>The flour you use matters as much as the hydration. "00" flour (doppio zero) is finely milled and traditional for Neapolitan pizza, producing a soft, extensible dough. Bread flour (12–13% protein) provides more gluten structure and works well for New York and pan styles. All-purpose flour is a reasonable substitute for home ovens that cannot reach the extreme temperatures of professional pizza ovens.</p>


  <fragment slot="intro">
    <p class="tool-intro">Get the perfect pizza dough recipe using baker's percentages. Choose your style, dough ball size, and number of pizzas for exact ingredient amounts.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Pizza Dough &amp; Baker's Percentage Calculator</h2>

      <div class="form-row">
        <div class="form-group">
          <label for="pizzaStyle">Pizza Style</label>
          <select id="pizzaStyle">
            <option value="neapolitan">Neapolitan (12", 250g ball)</option>
            <option value="ny" selected>New York (14", 350g ball)</option>
            <option value="sicilian">Sicilian / Detroit (10x14", 600g)</option>
            <option value="pan">Pan / Deep Dish (10", 400g ball)</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div class="form-group">
          <label for="pizzaCount">Number of Pizzas</label>
          <input type="number" id="pizzaCount" value="2" min="1" max="50" step="1">
        </div>
      </div>

      <div id="customRow" style="display:none;">
        <div class="form-group">
          <label for="ballWeight">Dough Ball Weight (grams)</label>
          <input type="number" id="ballWeight" value="350" min="100" max="1000" step="10">
        </div>
      </div>

      <div class="form-group">
        <label for="hydration">Hydration (%)</label>
        <select id="hydration">
          <option value="60">60% (firm, easy to handle)</option>
          <option value="65" selected>65% (balanced)</option>
          <option value="70">70% (airy, slightly sticky)</option>
          <option value="75">75% (high hydration, advanced)</option>
          <option value="80">80% (very high, expert level)</option>
        </select>
      </div>

      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="doughResult">
        <div class="result-value" id="doughResultValue">Recipe</div>
        <div class="result-label" id="doughResultLabel">Ingredients for your dough</div>
        <div class="result-details" id="doughResultDetails"></div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">

    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This calculator provides exact ingredient amounts (flour, water, salt, yeast) based on your chosen pizza style, number of pizzas, and hydration level. It includes presets for Neapolitan, New York, Sicilian, and Pan/Deep Dish styles with their traditional dough ball weights and hydration levels.</p>
    </div>
    <div class="content-section">
      <h2>How to Use the Pizza Dough Calculator</h2>
      <p>Baker's percentages are based on the flour weight being 100%. All other ingredients are calculated as a percentage of the flour. This method scales perfectly to any batch size.</p>
      <ul>
        <li><strong>Flour:</strong> 100% (your base amount)</li>
        <li><strong>Water:</strong> 60-80% depending on style (hydration)</li>
        <li><strong>Yeast:</strong> ~0.5-1% (active dry or instant)</li>
        <li><strong>Salt:</strong> ~2-3% for flavor and gluten structure</li>
      </ul>
    </div>

    <div class="content-section">
      <h2>Pizza Styles Compared</h2>
      <p><strong>Neapolitan</strong> is the classic thin-crust style cooked at very high heat (800-900&deg;F). <strong>New York style</strong> is hand-tossed with a foldable slice. <strong>Sicilian/Detroit</strong> is a thick, rectangular pan pizza. <strong>Pan/Deep dish</strong> uses higher hydration dough baked in a deep pan with lots of oil.</p>
    </div>

    <FAQ items={[
      { question: "What is baker's percentage?", answer: "Baker's percentage expresses every ingredient's weight as a percentage of the total flour weight. So 65% hydration means the water weighs 65% of the flour weight. This makes it easy to scale recipes up or down." },
      { question: "Can I use bread flour instead of pizza flour?", answer: "Yes. Bread flour (12-13% protein) works great for pizza dough and gives excellent structure. '00' flour is finer-milled and traditional for Neapolitan, but bread flour is a fine substitute for home ovens." },
      { question: "How long should the dough rise?", answer: "Room temperature: 2-4 hours. Cold ferment in the fridge: 24-72 hours for better flavor and digestibility. Cold fermentation develops more complex flavors as the yeast slowly breaks down the dough." },
    ]} />
  
    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Choose your pizza style and start with the recommended hydration. Weigh your ingredients with a kitchen scale for accuracy — volume measurements (cups) are unreliable for flour. Try cold fermentation: mix your dough, let it rise at room temperature for 2 hours, then refrigerate for 24–72 hours for significantly better flavour.</p>
    </div>
</fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="pizza-dough-calculator" category="food" />
  </fragment>
</ToolLayout>

<script>
import { showResult, hideResult } from '../utils/calculator-utils';

const styles: Record<string, { weight: number }> = {
  neapolitan: { weight: 250 },
  ny: { weight: 350 },
  sicilian: { weight: 600 },
  pan: { weight: 400 },
  custom: { weight: 350 }
};

function updateStyle() {
  const style = (document.getElementById('pizzaStyle') as HTMLSelectElement).value;
  document.getElementById('customRow')!.style.display = style === 'custom' ? 'block' : 'none';
  if (style !== 'custom' && styles[style]) {
    (document.getElementById('ballWeight') as HTMLInputElement).value = String(styles[style].weight);
  }
}

function calcDough() {
  const style = (document.getElementById('pizzaStyle') as HTMLSelectElement).value;
  const count = parseInt((document.getElementById('pizzaCount') as HTMLInputElement).value) || 1;
  const hydration = parseInt((document.getElementById('hydration') as HTMLSelectElement).value);
  const ballWeight = style === 'custom'
    ? parseFloat((document.getElementById('ballWeight') as HTMLInputElement).value)
    : styles[style].weight;

  if (isNaN(ballWeight) || ballWeight < 50) return;

  const totalDough = ballWeight * count;
  const totalPercent = 100 + hydration + 2 + 0.6;
  const flour = totalDough / (totalPercent / 100);
  const water = flour * (hydration / 100);
  const salt = flour * 0.02;
  const yeast = flour * 0.006;

  document.getElementById('doughResultValue')!.textContent = Math.round(flour / 10) * 10 + 'g flour';
  document.getElementById('doughResultLabel')!.textContent = 'For ' + count + ' pizza' + (count > 1 ? 's' : '') + ' (' + Math.round(totalDough) + 'g total)';
  document.getElementById('doughResultDetails')!.innerHTML =
    '<div><span class="label">Flour (100%)</span><span class="value">' + Math.round(flour) + ' g</span></div>' +
    '<div><span class="label">Water (' + hydration + '%)</span><span class="value">' + Math.round(water) + ' g</span></div>' +
    '<div><span class="label">Salt (2%)</span><span class="value">' + Math.round(salt * 10) / 10 + ' g</span></div>' +
    '<div><span class="label">Yeast (0.6%)</span><span class="value">' + (yeast < 1 ? (yeast * 10).toFixed(1) + ' g (use pinch)' : Math.round(yeast) + ' g') + '</span></div>' +
    '<div><span class="label">Dough balls</span><span class="value">' + count + ' &times; ' + Math.round(ballWeight) + ' g</span></div>';
  showResult('doughResult');
}

function resetDough() {
  (document.getElementById('pizzaStyle') as HTMLSelectElement).value = 'ny';
  (document.getElementById('pizzaCount') as HTMLInputElement).value = '2';
  (document.getElementById('hydration') as HTMLSelectElement).value = '65';
  (document.getElementById('ballWeight') as HTMLInputElement).value = '350';
  updateStyle();
  hideResult('doughResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcDough);
document.getElementById('resetBtn')!.addEventListener('click', resetDough);
document.getElementById('pizzaStyle')!.addEventListener('change', updateStyle);
document.addEventListener('DOMContentLoaded', function() { updateStyle(); calcDough(); });
</script>
