---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['json-formatter'];
const defaultJson = JSON.stringify({ name: "John Doe", email: "john@example.com", age: 30, city: "New York" }, null, 2);
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "JSON Formatter: Validate & Beautify JSON",
    "description": "JSON Formatter: Validate & Beautify JSON. Free online calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/json-formatter/" }
  }
];
---

<ToolLayout title="JSON Formatter: Validate & Beautify JSON | FreeOnlineToolkit" description="JSON Formatter: Validate & Beautify JSON. Free online calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>JSON Formatter: Validate & Beautify JSON</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>JSON (JavaScript Object Notation) is the universal data interchange format used by virtually every modern API, configuration file, and data pipeline.</li>
      <li>Formatting (pretty-printing) JSON with indentation makes it human-readable and helps spot structural errors that minified JSON hides.</li>
      <li>Common JSON errors include trailing commas, single quotes instead of double quotes, unescaped characters, and mismatched brackets - a good formatter catches these instantly.</li>
      <li>Minifying JSON removes all unnecessary whitespace, reducing file size for network transmission and storage.</li>
      <li>All formatting happens locally in your browser - your data is never sent to any server.</li>
    </ul>
  </div>

    <p>JSON has become the de facto standard for data exchange on the web. Every time a mobile app loads data, a website fetches content from an API, or a configuration file is read by a software tool, JSON is almost certainly the format being used. Its simplicity - built on just six data types (strings, numbers, booleans, null, arrays, and objects) - makes it easy for humans to read and machines to parse. Yet despite this simplicity, working with raw JSON can be surprisingly frustrating when it arrives as a single unformatted line or contains subtle syntax errors.</p>

    <p>A <strong>JSON formatter</strong> (also called a JSON beautifier or pretty-printer) solves this by adding consistent indentation and line breaks, transforming a wall of text into a structured, navigable document. This is essential when debugging API responses - a malformed JSON response from a REST endpoint can take minutes to diagnose by eye, but a formatter reveals the problem in seconds. The indentation also makes it easy to understand deeply nested structures, which are common in complex API responses from services like Stripe, Shopify, or OpenAI.</p>

    <p><strong>Validation</strong> is the other critical function. JSON has strict syntax rules that are easy to violate: every key must be a double-quoted string, trailing commas are forbidden, and all brackets and braces must be balanced. A single missing comma or extra brace causes a parse error that can crash an application. Modern JSON formatters provide clear, specific error messages - often pointing to the exact line and character where the error occurs - saving developers significant debugging time.</p>

    <p>On the production side, <strong>minifying</strong> JSON is the opposite operation: stripping all whitespace and indentation to produce the smallest possible representation. While human-readable JSON with 2-space indentation adds roughly 20-30% overhead in file size, minified JSON is used for API responses, CDN-delivered configuration files, and any context where bandwidth or storage matters. Both operations - formatting and minifying - are complementary tools in every developer's workflow.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calculator below to get instant results. Read on for a full guide to the topic, key formulas, and expert tips.</p>
  </fragment>

<fragment slot="calculator">
    <div class="calc-card">
      <h2>JSON Formatter</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div>
          <label style="font-size:0.88rem;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;display:block;">Input JSON</label>
          <textarea id="jsonInput" style="width:100%;min-height:350px;padding:12px;border:1px solid var(--color-border);border-radius:8px;font-family:'Courier New',monospace;font-size:0.85rem;line-height:1.5;resize:vertical;background:var(--color-surface);color:var(--color-text);" placeholder='Paste your JSON here...'>{defaultJson}</textarea>
        </div>
        <div>
          <label style="font-size:0.88rem;font-weight:500;color:var(--color-text-secondary);margin-bottom:4px;display:block;">Formatted Output</label>
          <textarea id="jsonOutput" style="width:100%;min-height:350px;padding:12px;border:1px solid var(--color-border);border-radius:8px;font-family:'Courier New',monospace;font-size:0.85rem;line-height:1.5;resize:vertical;background:var(--color-bg);color:var(--color-text);" readonly placeholder="Formatted JSON will appear here..."></textarea>
        </div>
      </div>
      <div id="jsonError" style="color:var(--color-danger);font-size:0.88rem;margin-top:8px;display:none;"></div>
      <div class="btn-group" style="margin-top:12px;">
        <button class="btn btn-primary" id="formatBtn">Format</button>
        <button class="btn btn-secondary" id="minifyBtn">Minify</button>
        <button class="btn btn-secondary" id="copyBtn">Copy Output</button>
        <button class="btn btn-secondary" id="clearBtn">Clear</button>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This JSON formatter provides a side-by-side interface with <strong>input</strong> (paste your raw JSON) and <strong>output</strong> (formatted result). Click <strong>Format</strong> to pretty-print with 2-space indentation, <strong>Minify</strong> to compress to a single line, or <strong>Copy Output</strong> to clipboard. If your JSON contains syntax errors, a clear error message appears highlighting the issue.</p>
    </div>

<div class="content-section">
      <h2>How to Use the JSON Formatter</h2>
      <p><strong>Paste</strong> your JSON data into the left text area and click <strong>Format</strong> to beautify it with proper indentation. If your JSON is invalid, the tool shows a clear error message. Use <strong>Minify</strong> to compress into a single line, or <strong>Copy</strong> to copy the output.</p>
    </div>

    <div class="content-section">
      <h2>What is JSON?</h2>
      <p>JSON (JavaScript Object Notation) is a lightweight data-interchange format. It supports strings, numbers, booleans, null, arrays, and objects. Valid JSON requires double quotes around keys and strings, and no trailing commas.</p>
    </div>

    <FAQ items={[
      { question: "What makes JSON invalid?", answer: "Common JSON errors include: trailing commas, using single quotes instead of double quotes, missing quotes around keys, extra commas, unescaped special characters, and mismatched brackets or braces." },
      { question: "What's the difference between Format and Minify?", answer: "Format adds proper indentation and line breaks to make JSON human-readable. Minify removes all whitespace and compresses the JSON into the smallest possible form for faster network transmission." },
      { question: "Is my JSON data sent to any server?", answer: "No. All processing happens in your browser. Your JSON data is never transmitted to any server." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Paste your JSON data into the input area above and click <strong>Format</strong> to beautify it instantly. Use this tool whenever you receive minified API responses, need to debug configuration files, or want to verify that your JSON output is syntactically valid before sending it to a client or service.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="json-formatter" category="utility" />
  </fragment>
</ToolLayout>


<script>
function formatJSON() {
  const input = (document.getElementById('jsonInput') as HTMLTextAreaElement).value;
  const errorEl = document.getElementById('jsonError') as HTMLElement;
  const output = document.getElementById('jsonOutput') as HTMLTextAreaElement;

  try {
    const parsed = JSON.parse(input);
    output.value = JSON.stringify(parsed, null, 2);
    errorEl.style.display = 'none';
  } catch (e: any) {
    errorEl.textContent = 'JSON Error: ' + e.message;
    errorEl.style.display = 'block';
    output.value = '';
  }
}

function minifyJSON() {
  const input = (document.getElementById('jsonInput') as HTMLTextAreaElement).value;
  const errorEl = document.getElementById('jsonError') as HTMLElement;
  const output = document.getElementById('jsonOutput') as HTMLTextAreaElement;

  try {
    const parsed = JSON.parse(input);
    output.value = JSON.stringify(parsed);
    errorEl.style.display = 'none';
  } catch (e: any) {
    errorEl.textContent = 'JSON Error: ' + e.message;
    errorEl.style.display = 'block';
    output.value = '';
  }
}

function copyJSON() {
  const output = document.getElementById('jsonOutput') as HTMLTextAreaElement;
  if (!output.value) return;
  navigator.clipboard.writeText(output.value);
}

function clearJSON() {
  (document.getElementById('jsonInput') as HTMLTextAreaElement).value = '';
  (document.getElementById('jsonOutput') as HTMLTextAreaElement).value = '';
  (document.getElementById('jsonError') as HTMLElement).style.display = 'none';
}

document.getElementById('formatBtn')!.addEventListener('click', formatJSON);
document.getElementById('minifyBtn')!.addEventListener('click', minifyJSON);
document.getElementById('copyBtn')!.addEventListener('click', copyJSON);
document.getElementById('clearBtn')!.addEventListener('click', clearJSON);
document.addEventListener('DOMContentLoaded', formatJSON);
</script>
