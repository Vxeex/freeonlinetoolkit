function toRad(deg: number): number {
  return deg * Math.PI / 180;
}

function haversine(lat1: number, lng1: number, lat2: number, lng2: number): number {
  const R = 6371; // Earth's radius in km
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a = Math.sin(dLat / 2) ** 2 +
            Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
            Math.sin(dLng / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

function fmtDuration(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = Math.round(minutes % 60);
  return h + 'h ' + m + 'min';
}

function getRouteKey(from: string, to: string): string {
  return from + '-' + to;
}

function findAirlines(fromCode: string, toCode: string): string[] | null {
  // Check both directions
  const fwd = routeAirlines.find(r => r.from === fromCode && r.to === toCode);
  if (fwd) return fwd.airlines;
  const rev = routeAirlines.find(r => r.from === toCode && r.to === fromCode);
  if (rev) return rev.airlines;
  return null;
}

function formatTzOffset(hours: number): string {
  if (hours === 0) return 'UTC';
  const abs = Math.abs(hours);
  const whole = Math.floor(abs);
  const frac = Math.round((abs - whole) * 60);
  const sign = hours > 0 ? '+' : '-';
  return 'UTC' + sign + whole + (frac ? ':' + String(frac).padStart(2, '0') : '');
}

function calcFlight() {
  const fromCode = (document.getElementById('flightFrom') as HTMLSelectElement).value;
  const toCode = (document.getElementById('flightTo') as HTMLSelectElement).value;

  if (!fromCode || !toCode) return;
  if (fromCode === toCode) { alert('Departure and arrival airports must be different.'); return; }

  const fromAirport = airports.find(a => a.code === fromCode);
  const toAirport = airports.find(a => a.code === toCode);
  if (!fromAirport || !toAirport) return;

  const distKm = haversine(fromAirport.lat, fromAirport.lng, toAirport.lat, toAirport.lng);
  const distMi = distKm * 0.621371;

  // Flight time at 900 km/h cruise + 30 min buffer
  const cruiseSpeed = 900; // km/h
  const buffer = 30; // minutes
  const flightMin = (distKm / cruiseSpeed) * 60 + buffer;

  const airlines = findAirlines(fromCode, toCode);
  const tzDiff = toAirport.tz - fromAirport.tz;
  const tzStr = (tzDiff >= 0 ? '+' : '') + tzDiff + 'h (' + formatTzOffset(toAirport.tz) + ' vs ' + formatTzOffset(fromAirport.tz) + ')';

  (document.getElementById('flightTimeDisplay') as HTMLElement).textContent = fmtDuration(flightMin);
  (document.getElementById('flightDistance') as HTMLElement).textContent = distKm.toFixed(0) + ' km (' + distMi.toFixed(0) + ' mi)';
  (document.getElementById('flightDepDisplay') as HTMLElement).textContent = fromAirport.code + ' — ' + fromAirport.city + ', ' + fromAirport.country;
  (document.getElementById('flightArrDisplay') as HTMLElement).textContent = toAirport.code + ' — ' + toAirport.city + ', ' + toAirport.country;
  (document.getElementById('flightTzDiff') as HTMLElement).textContent = tzStr;
  (document.getElementById('flightAirlines') as HTMLElement).textContent = airlines ? airlines.join(', ') : 'Multiple airlines available — check with your preferred carrier';

  showResult('flightResult');
}

function swapAirports() {
  const from = document.getElementById('flightFrom') as HTMLSelectElement;
  const to = document.getElementById('flightTo') as HTMLSelectElement;
  const tmp = from.value;
  from.value = to.value;
  to.value = tmp;
  calcFlight();
}

function populateAirports() {
  const fromSel = document.getElementById('flightFrom') as HTMLSelectElement;
  const toSel = document.getElementById('flightTo') as HTMLSelectElement;
  let fromHtml = '<option value="">Select departure airport...</option>';
  let toHtml = '<option value="">Select arrival airport...</option>';

  // Group by continent/region for better UX
  const regions: { label: string; codes: string[] }[] = [
    { label: 'North America', codes: ['ATL','BOS','BWI','CLT','DEN','DFW','DTW','EWR','FLL','HNL','IAD','JFK','LAS','LAX','MCO','MIA','MSP','ORD','PDX','PHL','PHX','SAN','SEA','SFO','SLC','TPA','YUL','YVR','YYZ','MEX'] },
    { label: 'Europe', codes: ['AMS','ARN','BCN','BER','BRU','CDG','CPH','DUB','FCO','FRA','GVA','HEL','LGW','LHR','LIS','MAD','MAN','MUC','MXP','NCE','OSL','PRG','VIE','WAW','ZRH','ATH','BUD','KEF','AGP','PMI'] },
    { label: 'Asia', codes: ['BKK','DEL','DXB','HKG','ICN','KUL','MNL','NRT','HND','PEK','PVG','SIN','TPE','CTS','FUK','HKT','DPS','CGK','SGN','CAN','CMB','MLE'] },
    { label: 'Middle East', codes: ['AUH','DOH','IST','RUH','JED','TLV'] },
    { label: 'Oceania', codes: ['AKL','BNE','MEL','PER','SYD','CHC','WLG'] },
    { label: 'Africa', codes: ['CAI','CPT','JNB','LOS','NBO','DAR','ADD','TUN'] },
    { label: 'South America', codes: ['BOG','EZE','GIG','GRU','LIM','SCL','PTY','UIO'] },
  ];

  for (const region of regions) {
    fromHtml += '<optgroup label="' + region.label + '">';
    toHtml += '<optgroup label="' + region.label + '">';
    for (const code of region.codes) {
      const ap = airports.find(a => a.code === code);
      if (ap) {
        const label = ap.code + ' — ' + ap.city + ', ' + ap.country;
        fromHtml += '<option value="' + ap.code + '">' + label + '</option>';
        toHtml += '<option value="' + ap.code + '">' + label + '</option>';
      }
    }
    fromHtml += '</optgroup>';
    toHtml += '</optgroup>';
  }

  fromSel.innerHTML = fromHtml;
  toSel.innerHTML = toHtml;
  fromSel.value = 'JFK';
  toSel.value = 'LHR';
}

document.getElementById('calcBtn')!.addEventListener('click', calcFlight);
document.getElementById('swapBtn')!.addEventListener('click', swapAirports);
document.addEventListener('DOMContentLoaded', () => { populateAirports(); calcFlight(); });
</script>
