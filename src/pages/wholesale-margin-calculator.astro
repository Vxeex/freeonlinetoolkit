---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['wholesale-margin-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Wholesale Margin: Price Products for Profit & Free Calculator",
    "description": "Wholesale Margin: Price Products for Profit & Free Calculator. Free online calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/wholesale-margin-calculator/" }
  }
];
---

<ToolLayout title="Wholesale Margin: Price Products for Profit & Free Calculator | FreeOnlineToolkit" description="Wholesale Margin: Price Products for Profit & Free Calculator. Free online calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Wholesale Margin: Price Products for Profit & Free Calculator</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>Wholesale margin is the profit percentage a wholesaler earns: (Wholesale Price - Cost) / Wholesale Price x 100. Healthy margins range from 20-40%.</li>
      <li>Keystone pricing (100% markup, doubling the wholesale price) is the standard retail pricing strategy in most industries.</li>
      <li>The difference between margin and markup is crucial: margin is profit as a percentage of selling price, while markup is profit as a percentage of cost.</li>
      <li>Setting wholesale prices at 2-3x your production cost is a common starting point, but competitive research and industry norms should guide final pricing.</li>
      <li>Wholesale pricing must leave room for both the wholesaler's profit AND the retailer's profit - if the retail price exceeds market rates, retailers will not buy.</li>
    </ul>
  </div>

    <p>Wholesale pricing is the art of setting prices that work for three parties simultaneously: the manufacturer (who needs to cover production costs), the wholesaler (who needs a profit margin for distribution), and the retailer (who needs markup space to sell at a competitive retail price). Getting this balance right is the foundation of successful B2B commerce.</p>

    <p>The key distinction between <strong>margin and markup</strong> confuses many new wholesalers. Margin is the profit expressed as a percentage of the selling price: (Price - Cost) / Price x 100. Markup is the profit expressed as a percentage of the cost: (Price - Cost) / Cost x 100. A product that costs $10 and sells for $20 has a 50% margin but a 100% markup. Understanding which metric your industry uses is essential for accurate pricing and negotiation.</p>

    <p><strong>Keystone pricing</strong> - setting the retail price at double the wholesale price (100% markup) - is the most common retail pricing convention. This means a product wholesaled at $15 retails for $30. The retailer earns $15 per unit (50% margin), and the wholesaler earns their margin on the $15 wholesale price. This convention is so deeply embedded in retail culture that buyers expect it.</p>

    <p>Setting <strong>optimal wholesale pricing</strong> requires researching your competitive landscape, understanding your target retailers' margin expectations, and accurately accounting for your own costs. A common formula is: Wholesale Price = Total Cost Per Unit / (1 - Desired Margin%). For example, if your total cost is $10 and you want a 30% margin: $10 / 0.70 = $14.29 wholesale price.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calculator below to get instant results. Read on for a full guide to the topic, key formulas, and expert tips.</p>
  </fragment>

<fragment slot="calculator">
    <div class="calc-card">
      <h2>Wholesale Margin Calculator</h2>
      <div class="form-group">
        <label for="wsCost">Product Cost ($)</label>
        <div class="input-wrap">
          <span class="prefix">$</span>
          <input type="number" id="wsCost" class="prefixed" value="10" min="1" step="0.5">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="wsMargin">Desired Wholesale Margin (%)</label>
          <input type="number" id="wsMargin" value="30" min="1" max="90" step="1">
        </div>
        <div class="form-group">
          <label for="wsMarkup">Retail Markup (%)</label>
          <input type="number" id="wsMarkup" value="100" min="0" max="500" step="5">
        </div>
      </div>
      <div class="form-group">
        <label for="wsQuantity">Order Quantity</label>
        <input type="number" id="wsQuantity" value="100" min="1" step="10">
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="wsResult">
        <div class="result-value" id="wsWholesalePrice">$0.00</div>
        <div class="result-label">Wholesale Price Per Unit</div>
        <div class="result-details">
          <div><span class="label">Wholesale Profit Per Unit</span><span class="value" id="wsWholesaleProfit">$0.00</span></div>
          <div><span class="label">Recommended Retail Price</span><span class="value" id="wsRetailPrice">$0.00</span></div>
          <div><span class="label">Retail Profit Per Unit</span><span class="value" id="wsRetailProfit">$0.00</span></div>
          <div><span class="label">Total Order Revenue</span><span class="value" id="wsTotalRev">$0.00</span></div>
          <div><span class="label">Total Order Profit</span><span class="value" id="wsTotalProfit">$0.00</span></div>
          <div><span class="label">Margin on Retail</span><span class="value" id="wsRetailMargin">0.0%</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This wholesale margin calculator computes your <strong>wholesale price per unit</strong>, <strong>wholesale profit per unit</strong>, <strong>recommended retail price</strong>, <strong>retail profit for your buyers</strong>, <strong>total order revenue and profit</strong>, and the <strong>margin on retail</strong> - ensuring your pricing works for both you and your retail partners.</p>
    </div>

<div class="content-section">
      <h2>How to Use</h2>
      <p>This wholesale margin calculator makes B2B pricing straightforward. Start by entering your <strong>product cost</strong> (what you pay the manufacturer). Then set your <strong>desired wholesale margin</strong> &mdash; the profit percentage you want to earn as a wholesaler.</p>
      <p>Enter the <strong>retail markup</strong> your retailers will apply. The default of 100% is keystone pricing, standard in most retail industries. Finally, enter the <strong>order quantity</strong> to see totals for the full order.</p>
      <p>The calculator shows your wholesale price, per-unit profit, recommended retail price, retail profit for your buyers, and the total revenue and profit for the entire order.</p>
    </div>

    <div class="content-section">
      <h2>Wholesale vs. Retail Pricing</h2>
      <div class="formula-box">
        Wholesale Price = Cost / (1 &minus; Desired Margin / 100)
      </div>
      <div class="formula-box">
        Wholesale Profit = Wholesale Price &minus; Cost
      </div>
      <div class="formula-box">
        Retail Price = Wholesale Price &times; (1 + Retail Markup / 100)
      </div>
      <div class="formula-box">
        Margin on Retail = (Retail Price &minus; Cost) / Retail Price &times; 100
      </div>
    </div>

    <FAQ items={[
      { question: "What is wholesale margin?", answer: "Wholesale margin is the profit percentage a wholesaler earns when selling products to retailers. It is calculated as (Wholesale Price - Cost) / Wholesale Price * 100. A healthy wholesale margin is typically 20-40%, depending on the industry and product type." },
      { question: "What is keystone pricing?", answer: "Keystone pricing is a retail pricing strategy where the retail price is set at double the wholesale price (a 100% markup). It is a standard practice in many retail industries and is the default retail markup used in this calculator." },
      { question: "What is the difference between margin and markup?", answer: "Margin (profit margin) is the percentage of the selling price that is profit: (Price - Cost) / Price * 100. Markup is the percentage added to the cost to determine the selling price: (Price - Cost) / Cost * 100." },
      { question: "How do I set wholesale pricing?", answer: "To set wholesale pricing, start with your product cost, add operating expenses per unit, then add your desired profit margin. Research competitor pricing and industry standards. A common approach is to set wholesale price at 2-3 times your cost." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Enter your product cost, desired margin, and retail markup above to calculate optimal wholesale pricing. Research your industry's standard margins and check competitor pricing before finalising. Remember: your wholesale price must leave room for retailers to earn their margin while keeping the final retail price competitive in the market.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="wholesale-margin-calculator" category="ecommerce" />
  </fragment>
</ToolLayout>


<script>
import { showResult, hideResult } from '../utils/calculator-utils';

function calcWS(): void {
  var cost = parseFloat((document.getElementById('wsCost') as HTMLInputElement).value);
  var margin = parseFloat((document.getElementById('wsMargin') as HTMLInputElement).value);
  var markup = parseFloat((document.getElementById('wsMarkup') as HTMLInputElement).value);
  var quantity = parseFloat((document.getElementById('wsQuantity') as HTMLInputElement).value);

  if (!cost || !margin || !markup || !quantity) return;

  var wholesalePrice = cost / (1 - margin / 100);
  var wholesaleProfit = wholesalePrice - cost;
  var retailPrice = wholesalePrice * (1 + markup / 100);
  var retailProfit = retailPrice - cost;
  var totalRev = wholesalePrice * quantity;
  var totalProfit = wholesaleProfit * quantity;
  var retailMargin = ((retailPrice - cost) / retailPrice) * 100;

  document.getElementById('wsWholesalePrice')!.textContent = '$' + wholesalePrice.toFixed(2);
  document.getElementById('wsWholesaleProfit')!.textContent = '$' + wholesaleProfit.toFixed(2);
  document.getElementById('wsRetailPrice')!.textContent = '$' + retailPrice.toFixed(2);
  document.getElementById('wsRetailProfit')!.textContent = '$' + retailProfit.toFixed(2);
  document.getElementById('wsTotalRev')!.textContent = '$' + totalRev.toFixed(2);
  document.getElementById('wsTotalProfit')!.textContent = '$' + totalProfit.toFixed(2);
  document.getElementById('wsRetailMargin')!.textContent = retailMargin.toFixed(1) + '%';
  showResult('wsResult');
}

function resetWS(): void {
  (document.getElementById('wsCost') as HTMLInputElement).value = '10';
  (document.getElementById('wsMargin') as HTMLInputElement).value = '30';
  (document.getElementById('wsMarkup') as HTMLInputElement).value = '100';
  (document.getElementById('wsQuantity') as HTMLInputElement).value = '100';
  hideResult('wsResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcWS);
document.getElementById('resetBtn')!.addEventListener('click', resetWS);
document.addEventListener('DOMContentLoaded', calcWS);
</script>
