---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ToolVisualization from '../components/ToolVisualization.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['calorie-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Calorie Counting: Complete Guide to Daily Needs & Free Calculator",
    "description": "Understand how calories work, how many you need daily, and the science behind BMR and TDEE. Learn to use calorie counting for weight management. Free calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/calorie-calculator/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Daily Calorie Needs",
    "description": "Calculate your Total Daily Energy Expenditure (TDEE) based on your personal metrics and activity level.",
    "step": [
      { "@type": "HowToStep", "text": "Select your gender and age" },
      { "@type": "HowToStep", "text": "Enter your height and weight" },
      { "@type": "HowToStep", "text": "Choose your activity level" },
      { "@type": "HowToStep", "text": "Select your goal (maintain, lose, or gain weight)" },
      { "@type": "HowToStep", "text": "Click Calculate to see your daily calorie needs" },
    ],
  }
];
---

<ToolLayout title="Calorie Counting: Complete Guide to Daily Needs & Free Calculator | FreeOnlineToolkit" description="Understand how calories work, how many you need daily, and the science behind BMR and TDEE. Learn to use calorie counting for weight management. Free calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Calorie Counting: Complete Guide to Daily Needs & Free Calculator</h1></fragment>

  <div class="key-takeaways" style="background:#fef3c7;border:1px solid #fcd34d;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#92400e;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>A calorie is a unit of energy — your body needs a specific number each day to maintain basic functions and fuel activity.</li>
      <li>Your Basal Metabolic Rate (BMR) accounts for 60–75% of daily calorie burn and is calculated using your age, gender, height, and weight.</li>
      <li>Total Daily Energy Expenditure (TDEE) = BMR × activity factor, and represents the total calories you burn in a day.</li>
      <li>A deficit of 500 calories per day leads to roughly 0.5 kg (1 lb) of weight loss per week — a safe, sustainable pace.</li>
      <li>Calorie counting is a tool, not an obsession — food quality, macronutrient balance, and consistency matter as much as the total number.</li>
    </ul>
  </div>

  <p>Calories are the fundamental unit of energy that powers every function in your body — from breathing and circulating blood to running a marathon. Every food and drink you consume provides calories, and every activity you perform burns them. When you consume more calories than you burn, the excess is stored as body fat. When you burn more than you consume, your body taps into those stores for energy. This simple energy balance is the foundation of all weight management, regardless of which diet philosophy you follow.</p>

  <p>Your body burns calories through three main channels. <strong>Basal Metabolic Rate (BMR)</strong> accounts for 60–75% of your daily expenditure — it's the energy your body needs just to stay alive: keeping your heart beating, lungs breathing, brain functioning, and cells repairing. The <strong>thermic effect of food</strong> accounts for about 10% — digesting, absorbing, and processing nutrients actually burns calories. The remaining energy comes from <strong>physical activity</strong>, which is the most variable component and the one you have the most control over.</p>

  <p>Several equations exist for estimating BMR, but the <strong>Mifflin-St Jeor equation</strong> is considered the most accurate for the general population (within about 10% of measured values for most adults). It accounts for the fact that men and women have different metabolic rates, primarily due to differences in body composition — muscle tissue burns more energy at rest than fat tissue. Age also matters: metabolic rate gradually declines (about 1–2% per decade after age 20) as muscle mass naturally decreases.</p>

  <p>The practical application of calorie counting is straightforward but requires honesty and consistency. You need to know your TDEE (which the calculator below estimates), then decide whether to maintain, lose, or gain weight. For weight loss, a moderate deficit of 300–500 calories per day produces steady results without the extreme hunger and metabolic adaptation that crash diets cause. For weight gain (particularly muscle gain), a surplus of 250–500 calories combined with resistance training is the evidence-based approach. The most common mistake is overestimating activity level — if you sit at a desk most of the day, "sedentary" or "lightly active" is your correct category regardless of that gym session three times a week.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calorie calculator below to find your daily calorie needs based on your personal metrics and activity level. Adjust the inputs to see how different goals affect your target.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Daily Calorie Calculator</h2>
      <div class="form-group">
        <label>Gender</label>
        <div style="display:flex;gap:14px;">
          <label style="display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="radio" name="calGender" value="male" checked> Male</label>
          <label style="display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="radio" name="calGender" value="female"> Female</label>
        </div>
      </div>
      <div class="form-group">
        <label for="calAge">Age (years)</label>
        <input type="number" id="calAge" value="30" min="10" max="120">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="calHeight">Height (cm)</label>
          <input type="number" id="calHeight" value="175" min="50" max="300">
        </div>
        <div class="form-group">
          <label for="calWeight">Weight (kg)</label>
          <input type="number" id="calWeight" value="70" min="10" max="500">
        </div>
      </div>
      <div class="form-group">
        <label for="calActivity">Activity Level</label>
        <select id="calActivity">
          <option value="1.2">Sedentary (little or no exercise)</option>
          <option value="1.375">Light (1-3 days/week)</option>
          <option value="1.55" selected>Moderate (3-5 days/week)</option>
          <option value="1.725">Active (6-7 days/week)</option>
          <option value="1.9">Very Active (intense daily / physical job)</option>
        </select>
      </div>
      <div class="form-group">
        <label for="calGoal">Goal</label>
        <select id="calGoal">
          <option value="maintain">Maintain weight</option>
          <option value="lose">Lose weight (500 cal deficit)</option>
          <option value="gain">Gain weight (500 cal surplus)</option>
        </select>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="calResult">
        <div class="result-value" id="calTDEE">0</div>
        <div class="result-label">Daily Calories Needed: <span id="calGoalLabel">Maintain weight</span></div>
        <div class="result-details">
          <div><span class="label">Basal Metabolic Rate (BMR)</span><span class="value" id="calBMR">0</span></div>
          <div><span class="label">TDEE (Total Daily Energy Expenditure)</span><span class="value" id="calTDEEFull">0</span></div>
          <div><span class="label">Goal Calories per Day</span><span class="value" id="calGoalValue">0</span></div>
        </div>
      </div>
    </div>

    <ToolVisualization
      type="scale"
      color={tool.color}
      title="TDEE by Activity Level (30yr male, 175cm, 70kg)"
      data={{
        markerPct: 57,
        markerLabel: "Moderate: 2,556 cal",
        segments: [
          { label: "Sedentary", color: "#6b7280", startPct: 0, endPct: 20 },
          { label: "Light", color: "#3b82f6", startPct: 20, endPct: 40 },
          { label: "Moderate", color: "#10b981", startPct: 40, endPct: 60 },
          { label: "Active", color: "#f59e0b", startPct: 60, endPct: 80 },
          { label: "Very Active", color: "#ef4444", startPct: 80, endPct: 100 }
        ]
      }}
    />
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Tool Shows</h2>
      <p>This calculator estimates your BMR using the Mifflin-St Jeor equation and multiplies it by your activity level to produce your TDEE — the total calories you burn daily. Select a goal to see how adjusting your intake by 500 calories supports steady weight loss or gain.</p>
    </div>

    <div class="content-section">
      <h2>The Formula Behind the Calculator</h2>
      <p>This calculator uses the <strong>Mifflin-St Jeor equation</strong>, considered the most accurate BMR formula for the general population:</p>
      <div class="formula-box">
        <strong>Male:</strong> BMR = 10 × weight(kg) + 6.25 × height(cm) - 5 × age(y) + 5<br>
        <strong>Female:</strong> BMR = 10 × weight(kg) + 6.25 × height(cm) - 5 × age(y) - 161
      </div>
      <p>TDEE = BMR × Activity Factor (1.2 to 1.9 depending on activity level).</p>
    </div>

    <div class="content-section">
      <h2>Calorie Quality Matters Too</h2>
      <p>Not all calories are created equal when it comes to health and satiety. A 200-calorie serving of Greek yoghurt with berries provides protein, calcium, and fibre that keep you full for hours. A 200-calorie handful of candy provides a sugar spike followed by a crash and more hunger. While total calorie intake determines weight change, the <strong>quality</strong> of those calories affects energy levels, hunger, muscle retention, and long-term health.</p>
      <p>Focus on <strong>protein</strong> (0.7–1g per pound of body weight for active individuals), <strong>fibre-rich carbohydrates</strong> (vegetables, whole grains, legumes), and <strong>healthy fats</strong> (olive oil, nuts, avocado). These nutrients promote satiety, support muscle maintenance, and provide the micronutrients your body needs to function optimally — even during a calorie deficit.</p>
    </div>

    <div class="content-section">
      <h2>Common Calorie Counting Mistakes</h2>
      <ul>
        <li><strong>Overestimating activity level:</strong> Most people overestimate how active they are. If you have a desk job, "sedentary" or "light" is usually correct.</li>
        <li><strong>Not counting cooking oils and sauces:</strong> A tablespoon of olive oil is 120 calories. Sauces, dressings, and condiments add up quickly.</li>
        <li><strong>Ignoring liquid calories:</strong> Sodas, juices, alcohol, and fancy coffee drinks can add hundreds of invisible calories.</li>
        <li><strong>Being too aggressive:</strong> A deficit greater than 750–1000 calories/day risks muscle loss, metabolic slowdown, and binge cycles.</li>
        <li><strong>Giving up after one bad day:</strong> Weight fluctuates 1–2 kg daily due to water, sodium, and digestion. One day over budget is irrelevant — weekly averages matter.</li>
      </ul>
    </div>

    <FAQ items={[
      { question: "How accurate is this calorie calculator?", answer: "The Mifflin-St Jeor equation has an accuracy of about 85-90% in the general population. Individual factors like muscle mass, genetics, and metabolic health can cause variations. Use this as a starting point and adjust based on your actual results." },
      { question: "How many calories should I eat to lose weight?", answer: "A deficit of 300-500 calories per day typically leads to safe, sustainable weight loss of about 0.5 kg per week. We recommend not going below 1,200 calories per day for women or 1,500 for men without medical supervision." },
      { question: "What's the difference between BMR and TDEE?", answer: "BMR (Basal Metabolic Rate) is the number of calories your body needs at complete rest to maintain vital functions. TDEE (Total Daily Energy Expenditure) is your BMR plus all the calories burned through daily activity, exercise, and digesting food." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Enter your details in the calculator above to get your personalised calorie target. Track your intake for at least two weeks using an app like MyFitnessPal, Cronometer, or a simple food journal. Weigh yourself under the same conditions each morning and track weekly averages — daily fluctuations are noise. Adjust your intake by 100–200 calories if you're not seeing the expected results after 2–3 weeks. Consider consulting a registered dietitian for personalised nutrition guidance.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="calorie-calculator" category="health-wellness" />
  </fragment>
</ToolLayout>

<script>
import { getNum, showResult, hideResult } from '../utils/calculator-utils';

function calcCalories() {
  const gender = (document.querySelector('input[name="calGender"]:checked') as HTMLInputElement).value;
  const age = getNum('calAge')!;
  const height = getNum('calHeight')!;
  const weight = getNum('calWeight')!;
  const activity = parseFloat((document.getElementById('calActivity') as HTMLSelectElement).value);
  const goal = (document.getElementById('calGoal') as HTMLSelectElement).value;

  if (!age || !height || !weight) return;

  let bmr: number;
  if (gender === 'male') {
    bmr = 10 * weight + 6.25 * height - 5 * age + 5;
  } else {
    bmr = 10 * weight + 6.25 * height - 5 * age - 161;
  }

  const tdee = bmr * activity;
  let goalCals = tdee;
  let goalLabel = 'Maintain weight';
  if (goal === 'lose') { goalCals = tdee - 500; goalLabel = 'Lose weight'; }
  else if (goal === 'gain') { goalCals = tdee + 500; goalLabel = 'Gain weight'; }

  document.getElementById('calTDEE')!.textContent = Math.round(goalCals).toString();
  document.getElementById('calGoalLabel')!.textContent = goalLabel;
  document.getElementById('calBMR')!.textContent = Math.round(bmr).toString();
  document.getElementById('calTDEEFull')!.textContent = Math.round(tdee).toString();
  document.getElementById('calGoalValue')!.textContent = Math.round(goalCals).toString();
  showResult('calResult');
}

function resetCalories() {
  (document.getElementById('calAge') as HTMLInputElement).value = '30';
  (document.getElementById('calHeight') as HTMLInputElement).value = '175';
  (document.getElementById('calWeight') as HTMLInputElement).value = '70';
  (document.getElementById('calActivity') as HTMLSelectElement).value = '1.55';
  (document.getElementById('calGoal') as HTMLSelectElement).value = 'maintain';
  hideResult('calResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcCalories);
document.getElementById('resetBtn')!.addEventListener('click', resetCalories);
document.addEventListener('DOMContentLoaded', calcCalories);
</script>
