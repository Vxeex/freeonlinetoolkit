---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ToolVisualization from '../components/ToolVisualization.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['calorie-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Daily Calorie Needs",
    "description": "Calculate your Total Daily Energy Expenditure (TDEE) based on your personal metrics and activity level.",
    "step": [
      { "@type": "HowToStep", "text": "Select your gender and age" },
      { "@type": "HowToStep", "text": "Enter your height and weight" },
      { "@type": "HowToStep", "text": "Choose your activity level" },
      { "@type": "HowToStep", "text": "Select your goal (maintain, lose, or gain weight)" },
      { "@type": "HowToStep", "text": "Click Calculate to see your daily calorie needs" },
    ],
  }
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">Find out how many calories you need each day based on your age, height, weight, activity level, and fitness goals. This calculator uses the Mifflin-St Jeor equation, the most accurate method for estimating BMR and TDEE.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Daily Calorie Calculator</h2>
      <div class="form-group">
        <label>Gender</label>
        <div style="display:flex;gap:14px;">
          <label style="display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="radio" name="calGender" value="male" checked> Male</label>
          <label style="display:flex;align-items:center;gap:4px;cursor:pointer;"><input type="radio" name="calGender" value="female"> Female</label>
        </div>
      </div>
      <div class="form-group">
        <label for="calAge">Age (years)</label>
        <input type="number" id="calAge" value="30" min="10" max="120">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="calHeight">Height (cm)</label>
          <input type="number" id="calHeight" value="175" min="50" max="300">
        </div>
        <div class="form-group">
          <label for="calWeight">Weight (kg)</label>
          <input type="number" id="calWeight" value="70" min="10" max="500">
        </div>
      </div>
      <div class="form-group">
        <label for="calActivity">Activity Level</label>
        <select id="calActivity">
          <option value="1.2">Sedentary (little or no exercise)</option>
          <option value="1.375">Light (1-3 days/week)</option>
          <option value="1.55" selected>Moderate (3-5 days/week)</option>
          <option value="1.725">Active (6-7 days/week)</option>
          <option value="1.9">Very Active (intense daily / physical job)</option>
        </select>
      </div>
      <div class="form-group">
        <label for="calGoal">Goal</label>
        <select id="calGoal">
          <option value="maintain">Maintain weight</option>
          <option value="lose">Lose weight (500 cal deficit)</option>
          <option value="gain">Gain weight (500 cal surplus)</option>
        </select>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="calResult">
        <div class="result-value" id="calTDEE">0</div>
        <div class="result-label">Daily Calories Needed: <span id="calGoalLabel">Maintain weight</span></div>
        <div class="result-details">
          <div><span class="label">Basal Metabolic Rate (BMR)</span><span class="value" id="calBMR">0</span></div>
          <div><span class="label">TDEE (Total Daily Energy Expenditure)</span><span class="value" id="calTDEEFull">0</span></div>
          <div><span class="label">Goal Calories per Day</span><span class="value" id="calGoalValue">0</span></div>
        </div>
      </div>
    </div>

    <ToolVisualization
      type="scale"
      color={tool.color}
      title="TDEE by Activity Level (30yr male, 175cm, 70kg)"
      data={{
        markerPct: 57,
        markerLabel: "Moderate: 2,556 cal",
        segments: [
          { label: "Sedentary", color: "#6b7280", startPct: 0, endPct: 20 },
          { label: "Light", color: "#3b82f6", startPct: 20, endPct: 40 },
          { label: "Moderate", color: "#10b981", startPct: 40, endPct: 60 },
          { label: "Active", color: "#f59e0b", startPct: 60, endPct: 80 },
          { label: "Very Active", color: "#ef4444", startPct: 80, endPct: 100 }
        ]
      }}
    />
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How to Use the Calorie Calculator</h2>
      <p>This calorie calculator estimates your <strong>Total Daily Energy Expenditure (TDEE)</strong> — the number of calories your body burns each day. Start by selecting your <strong>gender</strong>, then enter your <strong>age</strong>, <strong>height</strong> (in centimeters), and <strong>weight</strong> (in kilograms).</p>
      <p>Choose your <strong>activity level</strong> honestly for the most accurate results. Finally, select your <strong>goal</strong> — maintain, lose, or gain weight. For weight loss, we subtract 500 calories from your TDEE; for weight gain, we add 500 calories.</p>
    </div>

    <div class="content-section">
      <h2>The Formula Behind the Calculator</h2>
      <p>This calculator uses the <strong>Mifflin-St Jeor equation</strong>, considered the most accurate BMR formula:</p>
      <div class="formula-box">
        <strong>Male:</strong> BMR = 10 × weight(kg) + 6.25 × height(cm) - 5 × age(y) + 5<br>
        <strong>Female:</strong> BMR = 10 × weight(kg) + 6.25 × height(cm) - 5 × age(y) - 161
      </div>
      <p>TDEE = BMR × Activity Factor (1.2 to 1.9 depending on activity level).</p>
    </div>

    <FAQ items={[
      { question: "How accurate is this calorie calculator?", answer: "The Mifflin-St Jeor equation has an accuracy of about 85-90% in the general population. Individual factors like muscle mass, genetics, and metabolic health can cause variations. Use this as a starting point and adjust based on your actual results." },
      { question: "How many calories should I eat to lose weight?", answer: "A deficit of 300-500 calories per day typically leads to safe, sustainable weight loss of about 0.5 kg per week. We recommend not going below 1,200 calories per day for women or 1,500 for men without medical supervision." },
      { question: "What's the difference between BMR and TDEE?", answer: "BMR (Basal Metabolic Rate) is the number of calories your body needs at complete rest to maintain vital functions. TDEE (Total Daily Energy Expenditure) is your BMR plus all the calories burned through daily activity, exercise, and digesting food." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="calorie-calculator" category="health-wellness" />
  </fragment>
</ToolLayout>

<script>
import { getNum, showResult, hideResult } from '../utils/calculator-utils';

function calcCalories() {
  const gender = (document.querySelector('input[name="calGender"]:checked') as HTMLInputElement).value;
  const age = getNum('calAge')!;
  const height = getNum('calHeight')!;
  const weight = getNum('calWeight')!;
  const activity = parseFloat((document.getElementById('calActivity') as HTMLSelectElement).value);
  const goal = (document.getElementById('calGoal') as HTMLSelectElement).value;

  if (!age || !height || !weight) return;

  let bmr: number;
  if (gender === 'male') {
    bmr = 10 * weight + 6.25 * height - 5 * age + 5;
  } else {
    bmr = 10 * weight + 6.25 * height - 5 * age - 161;
  }

  const tdee = bmr * activity;
  let goalCals = tdee;
  let goalLabel = 'Maintain weight';
  if (goal === 'lose') { goalCals = tdee - 500; goalLabel = 'Lose weight'; }
  else if (goal === 'gain') { goalCals = tdee + 500; goalLabel = 'Gain weight'; }

  document.getElementById('calTDEE')!.textContent = Math.round(goalCals).toString();
  document.getElementById('calGoalLabel')!.textContent = goalLabel;
  document.getElementById('calBMR')!.textContent = Math.round(bmr).toString();
  document.getElementById('calTDEEFull')!.textContent = Math.round(tdee).toString();
  document.getElementById('calGoalValue')!.textContent = Math.round(goalCals).toString();
  showResult('calResult');
}

function resetCalories() {
  (document.getElementById('calAge') as HTMLInputElement).value = '30';
  (document.getElementById('calHeight') as HTMLInputElement).value = '175';
  (document.getElementById('calWeight') as HTMLInputElement).value = '70';
  (document.getElementById('calActivity') as HTMLSelectElement).value = '1.55';
  (document.getElementById('calGoal') as HTMLSelectElement).value = 'maintain';
  hideResult('calResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcCalories);
document.getElementById('resetBtn')!.addEventListener('click', resetCalories);
document.addEventListener('DOMContentLoaded', calcCalories);
</script>
