---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['workers-comp-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Workers Comp Settlement: Estimate Your Claim",
    "description": "Workers Comp Settlement: Estimate Your Claim. Free online calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/workers-comp-calculator/" }
  }
];
---

<ToolLayout title="Workers Comp Settlement: Estimate Your Claim | FreeOnlineToolkit" description="Workers Comp Settlement: Estimate Your Claim. Free online calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Workers Comp Settlement: Estimate Your Claim</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>Workers' compensation provides wage replacement (typically 66.7% of your pre-injury wage) and medical coverage for work-related injuries - regardless of who was at fault.</li>
      <li>Permanent partial disability (PPD) ratings are assigned as a percentage by your doctor and directly determine the value of your settlement or award.</li>
      <li>Workers' comp attorney fees are capped at 10-20% in most states (lower than personal injury's typical 33%), and many attorneys offer free initial consultations.</li>
      <li>State maximum benefit durations vary widely - California caps temporary disability at 104 weeks while New York allows up to 260 weeks.</li>
      <li>You can receive both workers' compensation and Social Security Disability (SSDI), but SSDI may be reduced if combined benefits exceed 80% of your average earnings.</li>
    </ul>
  </div>

    <p>Workers' compensation is a no-fault insurance system that provides benefits to employees who suffer work-related injuries or illnesses. Unlike personal injury claims, you do not need to prove your employer was negligent - if the injury happened in the course of employment, you are generally eligible for benefits. The system is designed to be faster and simpler than litigation, but understanding how settlements are calculated is essential for ensuring you receive fair compensation.</p>

    <p>Workers' comp benefits fall into three main categories. <strong>Temporary Total Disability (TTD)</strong> payments replace lost wages while you are completely unable to work, typically at 66.7% (two-thirds) of your pre-injury average weekly wage. TTD payments continue until you reach "maximum medical improvement" (MMI) - the point at which your condition has stabilised. Each state sets a maximum number of weeks for TTD benefits, ranging from 104 weeks to 260 weeks or more for certain injury types.</p>

    <p><strong>Permanent Partial Disability (PPD)</strong> compensation addresses the lasting impact of your injury. After reaching MMI, your treating physician assigns a PPD rating - a percentage that quantifies your permanent impairment. This rating is based on medical guidelines and considers factors like loss of range of motion, chronic pain, and functional limitations. The PPD rating directly determines the value of your permanent disability award.</p>

    <p>The settlement process involves negotiation between you (or your attorney), your employer's insurance company, and sometimes a workers' compensation judge. Insurance companies often try to settle claims quickly for less than they are worth, which is why many injured workers benefit from legal representation. Workers' comp attorney fees are notably lower than personal injury fees - most states cap them at 10-20% of the settlement or award.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calculator below to get instant results. Read on for a full guide to the topic, key formulas, and expert tips.</p>
  </fragment>

<fragment slot="calculator">
    <div class="calc-card">
      <h2>Workers Comp Settlement Calculator</h2>
      <div class="form-group">
        <label for="weeklyWage">Weekly Wage ($)</label>
        <div class="input-wrap">
          <span class="prefix">$</span>
          <input type="number" id="weeklyWage" class="prefixed" value="1000" min="0" step="50">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="injuryType">Injury Type</label>
          <select id="injuryType">
            <option value="minor">Minor (muscle strains, contusions) &mdash;5% impairment</option>
            <option value="moderate" selected>Moderate (fractures, sprains) &mdash;15% impairment</option>
            <option value="severe">Severe (herniated disc, torn ligaments) &mdash;30% impairment</option>
            <option value="catastrophic">Catastrophic (spinal cord, brain injury) &mdash;60% impairment</option>
          </select>
        </div>
        <div class="form-group">
          <label for="ppdRating">PPD Rating (%) <span class="optional">0-100</span></label>
          <input type="number" id="ppdRating" value="15" min="0" max="100" step="1">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="ttdWeeks">Weeks of TTD</label>
          <input type="number" id="ttdWeeks" value="12" min="0" max="520">
        </div>
        <div class="form-group">
          <label for="medicalCosts">Medical Costs to Date ($)</label>
          <div class="input-wrap">
            <span class="prefix">$</span>
            <input type="number" id="medicalCosts" class="prefixed" value="5000" min="0" step="500">
          </div>
        </div>
      </div>
      <div class="form-group">
        <label for="wcState">State</label>
        <select id="wcState">
          <option value="CA" selected>California (max 104 TTD weeks)</option>
          <option value="FL">Florida (max 104 TTD weeks)</option>
          <option value="NY">New York (max 260 TTD weeks)</option>
          <option value="TX">Texas (max 104 TTD weeks)</option>
          <option value="IL">Illinois (max 130 TTD weeks)</option>
        </select>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="wcResult">
        <div class="result-value" id="wcTotal">$0.00</div>
        <div class="result-label">Total Estimated Settlement</div>
        <div class="result-details">
          <div><span class="label">Temporary Total Disability Payment</span><span class="value" id="wcTTD">$0</span></div>
          <div><span class="label">Permanent Partial Disability Award</span><span class="value" id="wcPPD">$0</span></div>
          <div><span class="label">Medical Cost Reimbursement</span><span class="value" id="wcMedical">$0</span></div>
          <div><span class="label">Net After Attorney Fee (15%)</span><span class="value" id="wcNetAfterFee">$0</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This workers' comp settlement estimator calculates your <strong>Temporary Total Disability (TTD) payment</strong>, <strong>Permanent Partial Disability (PPD) award</strong>, <strong>medical cost reimbursement</strong>, total settlement, and <strong>net amount after a standard 15% attorney fee</strong>. It applies your state's maximum TTD benefit duration and adjusts for your specific injury type and PPD rating.</p>
    </div>

<div class="content-section">
      <h2>How to Use the Workers Comp Settlement Estimator</h2>
      <p>Start by entering your <strong>weekly wage</strong> before the injury. Select your <strong>injury type</strong> from the dropdown &mdash;each type has a preset impairment rating that serves as a starting point. You can also manually enter a <strong>PPD rating</strong> (permanent partial disability percentage from 0 to 100) if you have one from your doctor.</p>
      <p>Enter the number of <strong>weeks of temporary total disability (TTD)</strong> &mdash;this is the time you were completely unable to work. Add your <strong>medical costs to date</strong> including hospital bills, surgery, therapy, and medications. Select your <strong>state</strong> to apply the correct maximum TTD benefit duration.</p>
    </div>

    <div class="content-section">
      <h2>Workers Comp Settlement Formula</h2>
      <div class="formula-box">
        TTD Benefit = Weekly Wage &times; 66.7% (capped at state maximum)
      </div>
      <div class="formula-box">
        TTD Payment = TTD Benefit &times; TTD Weeks (capped at state max weeks)
      </div>
      <div class="formula-box">
        PPD Value = PPD Rating% &times; 500 weeks &times; Weekly Wage &times; 66.7%
      </div>
      <div class="formula-box">
        Total Settlement = TTD Payment + PPD Value + Medical Costs
      </div>
    </div>

    <FAQ items={[
      { question: "What is a permanent partial disability (PPD) rating?", answer: "A PPD rating is a percentage assigned by your doctor that measures the permanent impairment caused by your work injury. It is based on medical guidelines and considers factors like loss of range of motion, pain, and functional limitations. The rating is used to calculate your permanent disability award." },
      { question: "Do I need a lawyer for a workers comp claim?", answer: "For straightforward claims with clear liability and prompt payment of benefits, you may not need a lawyer. However, if your claim is denied, you have a permanent disability, your employer disputes the injury, or you are being pressured to settle for less than you deserve, a workers' compensation attorney can be invaluable." },
      { question: "How are workers comp attorney fees calculated?", answer: "Workers' comp attorney fees are typically lower than personal injury fees. Many states cap workers comp attorney fees at 10-20% of the settlement or award, often around 15%. In some states, the fee must be approved by the workers' compensation board." },
      { question: "Can I receive both workers comp and Social Security disability?", answer: "Yes, you can receive both, but there may be offsets. Social Security Disability Insurance (SSDI) benefits may be reduced if your workers comp payments exceed 80% of your average current earnings. This is known as the workers comp offset." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Enter your weekly wage, injury type, and medical costs above to estimate your workers' comp settlement. If your claim has been denied or you have a significant permanent disability, consult a workers' compensation attorney - most offer free consultations and charge only 10-20% of your settlement.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="workers-comp-calculator" category="legal" />
  </fragment>
</ToolLayout>


<script>
import { showResult, hideResult } from '../utils/calculator-utils';

const STATE_MAX_TTD: Record<string, number> = {
  CA: 104,
  FL: 104,
  NY: 260,
  TX: 104,
  IL: 130
};

const INJURY_IMPAIRMENT: Record<string, number> = {
  minor: 5,
  moderate: 15,
  severe: 30,
  catastrophic: 60
};

function calcWorkersComp(): void {
  const wage = parseFloat((document.getElementById('weeklyWage') as HTMLInputElement).value) || 0;
  const injuryType = (document.getElementById('injuryType') as HTMLSelectElement).value;
  const ppdInput = parseFloat((document.getElementById('ppdRating') as HTMLInputElement).value) || 0;
  const ttdWeeks = parseFloat((document.getElementById('ttdWeeks') as HTMLInputElement).value) || 0;
  const medical = parseFloat((document.getElementById('medicalCosts') as HTMLInputElement).value) || 0;
  const state = (document.getElementById('wcState') as HTMLSelectElement).value;

  const ppdRating = ppdInput > 0 ? ppdInput : INJURY_IMPAIRMENT[injuryType];

  const ttdBenefitRate = wage * 0.667;
  const maxTtdWeeks = STATE_MAX_TTD[state];
  const cappedTtdWeeks = Math.min(ttdWeeks, maxTtdWeeks);
  const ttdPayment = ttdBenefitRate * cappedTtdWeeks;

  const ppdValue = (ppdRating / 100) * 500 * ttdBenefitRate;

  const total = ttdPayment + ppdValue + medical;
  const netAfterFee = total * 0.85;

  document.getElementById('wcTotal')!.textContent = '$' + total.toFixed(2);
  document.getElementById('wcTTD')!.textContent = '$' + ttdPayment.toFixed(2);
  document.getElementById('wcPPD')!.textContent = '$' + ppdValue.toFixed(2);
  document.getElementById('wcMedical')!.textContent = '$' + medical.toFixed(2);
  document.getElementById('wcNetAfterFee')!.textContent = '$' + netAfterFee.toFixed(2);

  showResult('wcResult');
}

function resetWorkersComp(): void {
  (document.getElementById('weeklyWage') as HTMLInputElement).value = '1000';
  (document.getElementById('injuryType') as HTMLSelectElement).value = 'moderate';
  (document.getElementById('ppdRating') as HTMLInputElement).value = '15';
  (document.getElementById('ttdWeeks') as HTMLInputElement).value = '12';
  (document.getElementById('medicalCosts') as HTMLInputElement).value = '5000';
  (document.getElementById('wcState') as HTMLSelectElement).value = 'CA';
  hideResult('wcResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcWorkersComp);
document.getElementById('resetBtn')!.addEventListener('click', resetWorkersComp);
document.addEventListener('DOMContentLoaded', calcWorkersComp);
</script>
