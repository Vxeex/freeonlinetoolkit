---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['age-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Age Calculator: Exact Age Between Dates",
    "description": "Calculate your exact age in years, months, and days between any two dates. Free age calculator with leap year accuracy and total days breakdown.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/age-calculator/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Age",
    "description": "Calculate exact age in years, months, and days between any two dates.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your date of birth" },
      { "@type": "HowToStep", "text": "Optionally set a second date for age calculation" },
      { "@type": "HowToStep", "text": "Click Calculate to see the exact age" },
    ],
  },
];
---

<ToolLayout title="Age Calculator: Exact Age Between Dates | FreeOnlineToolkit" description="Calculate your exact age in years, months, and days between any two dates. Free age calculator with leap year accuracy and total days breakdown." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Age Calculator: Exact Age Between Dates</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>Age calculators account for leap years, varying month lengths, and calendar irregularities to give a precise result in years, months, and days.</li>
      <li>You can calculate the time between any two dates — not just age from birth, but also anniversaries, project durations, and historical time spans.</li>
      <li>Legal age thresholds (drinking, voting, retirement) are calculated differently in some jurisdictions — some count the day before the birthday as the qualifying day.</li>
      <li>The total days count is useful for financial calculations like interest accrual, contract durations, and statute of limitations tracking.</li>
    </ul>
  </div>

  <p>Knowing your exact age might seem straightforward, but the calculation is more nuanced than most people realise. A year isn't always 365 days — leap years add an extra day every four years (with exceptions for century years not divisible by 400). Months vary from 28 to 31 days. When you need precision — for legal documents, medical records, financial calculations, or simply curiosity — a reliable age calculator eliminates the guesswork.</p>

  <p>Age calculations matter in everyday life more than you might think. Retirement eligibility is tied to exact age (typically 62 for early Social Security benefits in the US, 66–67 for full benefits). Insurance premiums are age-rated, and even a one-day difference can change your rate tier. School enrollment cut-off dates, sports league age divisions, and visa/immigration timelines all depend on precise age calculations.</p>

  <p>Beyond personal age, calculating the <strong>duration between any two dates</strong> has practical applications. Project managers track elapsed time between milestones. Historians measure intervals between events. Couples count down to anniversaries. The ability to compute exact day-level differences — accounting for every leap year and irregular month — is a deceptively complex task that a calculator handles instantly.</p>

  <p>This tool also displays the <strong>total number of days</strong> between dates, which is particularly useful for financial contexts. Interest calculations, contract terms, and legal deadlines are often expressed in days rather than months or years. Knowing that a contract is exactly 1,095 days old (3 years including a leap day) versus "about 3 years" can make a real difference in legal or financial disputes.</p>

  <fragment slot="intro">
    <p class="tool-intro">Calculate your exact age in years, months, and days. This free age calculator also works for calculating the time between any two dates.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Age Calculator</h2>
      <div class="form-group">
        <label for="ageBirth">Date of Birth</label>
        <input type="date" id="ageBirth">
      </div>
      <div class="form-group">
        <label for="ageAsOf">As of Date (optional, defaults to today)</label>
        <input type="date" id="ageAsOf">
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn">Calculate Age</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="ageResult">
        <div class="result-value" id="ageDisplay">0 years</div>
        <div class="result-label">Exact Age</div>
        <div class="result-details">
          <div><span class="label">Years</span><span class="value" id="ageYears">0</span></div>
          <div><span class="label">Months</span><span class="value" id="ageMonths">0</span></div>
          <div><span class="label">Days</span><span class="value" id="ageDays">0</span></div>
          <div><span class="label">Total Days</span><span class="value" id="ageTotalDays">0</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>Enter your <strong>date of birth</strong> and click Calculate to see your exact age. You can also enter a second date to calculate the age between any two dates — useful for anniversaries, project timelines, or historical events.</p>
      <p>The calculator shows the age in <strong>years</strong>, <strong>months</strong>, and <strong>days</strong>, as well as the total number of days. It accounts for leap years and varying month lengths to give you the most accurate result possible.</p>
    </div>

    <FAQ items={[
      { question: "How is age calculated exactly?", answer: "Age is calculated by finding the difference between two dates. The calculator accounts for leap years and different month lengths to give the most accurate result." },
      { question: "Is the date of birth included in the age?", answer: "Yes, the calculator uses a precise day-by-day calculation. If today is your birthday, you are exactly X years old." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Use this calculator to check eligibility dates for retirement benefits, plan milestone celebrations, or verify dates for legal documents. If you need to calculate dates for financial planning, try our <a href="/compound-interest-calculator/">Compound Interest Calculator</a> or <a href="/retirement-calculator/">Retirement Calculator</a> to project future values based on your exact age and timeline.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="age-calculator" category="health-wellness" />
  </fragment>
</ToolLayout>

<script>
import { showResult, hideResult } from '../utils/calculator-utils';

function calcAge() {
  const birthStr = (document.getElementById('ageBirth') as HTMLInputElement).value;
  if (!birthStr) return;

  const birth = new Date(birthStr);
  const asOfStr = (document.getElementById('ageAsOf') as HTMLInputElement).value;
  const asOf = asOfStr ? new Date(asOfStr) : new Date();

  if (isNaN(birth.getTime()) || isNaN(asOf.getTime())) return;

  let years = asOf.getFullYear() - birth.getFullYear();
  let months = asOf.getMonth() - birth.getMonth();
  let days = asOf.getDate() - birth.getDate();

  if (days < 0) {
    months--;
    const prevMonth = new Date(asOf.getFullYear(), asOf.getMonth(), 0);
    days += prevMonth.getDate();
  }
  if (months < 0) {
    years--;
    months += 12;
  }

  const totalDays = Math.floor((asOf.getTime() - birth.getTime()) / (1000 * 60 * 60 * 24));

  document.getElementById('ageDisplay')!.textContent = years + ' years, ' + months + ' months, ' + days + ' days';
  document.getElementById('ageYears')!.textContent = years.toString();
  document.getElementById('ageMonths')!.textContent = months.toString();
  document.getElementById('ageDays')!.textContent = days.toString();
  document.getElementById('ageTotalDays')!.textContent = totalDays.toString();
  showResult('ageResult');
}

function resetAge() {
  (document.getElementById('ageBirth') as HTMLInputElement).value = '';
  (document.getElementById('ageAsOf') as HTMLInputElement).value = '';
  hideResult('ageResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcAge);
document.getElementById('resetBtn')!.addEventListener('click', resetAge);
</script>
