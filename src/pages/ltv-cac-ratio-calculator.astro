---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['ltv-cac-ratio-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "LTV:CAC Ratio: SaaS Unit Economics Calculator",
    "description": "LTV:CAC Ratio: SaaS Unit Economics Calculator. Free online calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/ltv-cac-ratio-calculator/" }
  }
];
---

<ToolLayout title="LTV:CAC Ratio: SaaS Unit Economics Calculator | FreeOnlineToolkit" description="LTV:CAC Ratio: SaaS Unit Economics Calculator. Free online calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>LTV:CAC Ratio: SaaS Unit Economics Calculator</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>The LTV:CAC ratio measures how much value you extract from a customer versus what it costs to acquire them - the gold standard benchmark is 3:1 or higher.</li>
      <li>A ratio below 1:1 means you lose money on every customer acquired - the business is fundamentally unsustainable without change.</li>
      <li>CAC payback period (months to recover acquisition cost) should be under 12 months for healthy SaaS - enterprise SaaS can stretch to 18 months.</li>
      <li>LTV = ARPU x Gross Margin x Customer Lifetime - reducing churn (extending lifetime) has a more powerful effect on LTV than increasing price.</li>
      <li>An LTV:CAC above 5:1 may actually signal under-investment in growth - you have room to spend more aggressively on acquisition.</li>
    </ul>
  </div>

    <p>The LTV:CAC ratio is the most important single metric in SaaS unit economics. It answers the fundamental question: does your business model work? If you spend $500 to acquire a customer (CAC) and that customer generates $1,500 in lifetime profit (LTV), your ratio is 3:1 - meaning every dollar spent on acquisition returns three dollars in value.</p>

    <p><strong>Customer Lifetime Value (LTV)</strong> is the total gross profit you expect to earn from a customer over their entire relationship with your business. The formula is: LTV = Average Revenue Per User (ARPU) x Gross Margin % x Customer Lifetime. Customer Lifetime = 1 / Monthly Churn Rate. Small changes in churn have outsized effects: reducing churn from 5% to 3% extends lifetime from 20 to 33 months, increasing LTV by 67%.</p>

    <p><strong>Customer Acquisition Cost (CAC)</strong> is the total cost of sales and marketing divided by the number of new customers acquired. If you spend $10,000/month on marketing and sales and acquire 50 new customers, your CAC is $200. CAC includes all marketing spend, sales team salaries and commissions, and any costs directly attributable to customer acquisition.</p>

    <p>The <strong>payback period</strong> - how many months it takes to recover your CAC from a customer's gross profit - is the companion metric. For a $200 CAC, $50 ARPU, 80% margin: payback = $200 / $40 = 5 months. Investors generally want payback under 12 months because shorter payback means faster reinvestment in growth.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calculator below to get instant results. Read on for a full guide to the topic, key formulas, and expert tips.</p>
  </fragment>

<fragment slot="calculator">
    <div class="calc-card">
      <h2>LTV:CAC Calculator</h2>
      <div class="form-row">
        <div class="form-group">
          <label for="ltvArpu">Avg Revenue Per User/Month ($)</label>
          <input type="number" id="ltvArpu" value="50" min="0" step="1">
        </div>
        <div class="form-group">
          <label for="ltvMargin">Gross Margin (%)</label>
          <input type="number" id="ltvMargin" value="80" min="0" step="1">
        </div>
      </div>
      <div class="form-group">
        <label for="ltvChurn">Monthly Churn Rate (%)</label>
        <input type="number" id="ltvChurn" value="4" min="0.1" step="0.1">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="ltvCac">Customer Acquisition Cost ($)</label>
          <input type="number" id="ltvCac" value="500" min="0" step="10">
        </div>
        <div class="form-group">
          <label for="ltvCustomers">Number of Customers Acquired</label>
          <input type="number" id="ltvCustomers" value="100" min="1">
        </div>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="ltvResult">
        <div style="font-weight:600;font-size:1.05rem;margin-bottom:10px;color:var(--color-text);">LTV & CAC Analysis</div>
        <div class="result-details">
          <div><span class="label">Customer Lifetime</span><span class="value" id="ltvLifetime">0 months</span></div>
          <div><span class="label">LTV (per customer)</span><span class="value" id="ltvLTV">$0.00</span></div>
          <div><span class="label">CAC (per customer)</span><span class="value" id="ltvCAC">$0.00</span></div>
          <div><span class="label">LTV:CAC Ratio</span><span class="value" id="ltvRatio" style="font-weight:700;">0.00</span></div>
          <div><span class="label">Total LTV (all customers)</span><span class="value" id="ltvTotalLTV">$0.00</span></div>
          <div><span class="label">Total CAC Spent</span><span class="value" id="ltvTotalCAC">$0.00</span></div>
          <div><span class="label">Payback Period</span><span class="value" id="ltvPayback">0 months</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This calculator computes your <strong>customer lifetime</strong> (months), <strong>LTV</strong> (per customer), <strong>CAC</strong>, <strong>LTV:CAC ratio</strong> (with colour-coded health indicator), <strong>total LTV and CAC across all customers</strong>, and <strong>payback period</strong> (months to recover acquisition cost). Enter your ARPU, margin, churn, and CAC to see your unit economics at a glance.</p>
    </div>

<div class="content-section">
      <h2>How to Use</h2>
      <p>This LTV:CAC ratio calculator helps you evaluate the efficiency of your customer acquisition strategy. Start by entering your <strong>average revenue per user per month</strong> (ARPU) and your <strong>gross margin</strong> — the percentage of revenue you keep after direct costs like hosting and payment processing.</p>
      <p>Enter your <strong>monthly churn rate</strong> to automatically calculate customer lifetime (1 divided by churn rate). Then provide your <strong>customer acquisition cost</strong> and the <strong>number of customers acquired</strong> to see total figures.</p>
      <p>The results show your LTV:CAC ratio (aim for at least 3:1), the payback period (how long it takes to recover your acquisition costs), and total values across all customers.</p>
    </div>

    <div class="content-section">
      <h2>What Is a Good LTV:CAC Ratio?</h2>
      <ul>
        <li><strong>Below 1:1</strong> — Unsustainable. You spend more to acquire a customer than they generate in profit.</li>
        <li><strong>1:1 to 3:1</strong> — Breaking even or minimally profitable. Work on reducing churn or CAC.</li>
        <li><strong>3:1 to 5:1</strong> — Good. This is the benchmark for healthy SaaS businesses.</li>
        <li><strong>Above 5:1</strong> — Excellent. Strong unit economics. Consider investing more in growth.</li>
      </ul>
    </div>

    <div class="content-section">
      <h2>LTV:CAC Formulas</h2>
      <div class="formula-box">
        <strong>Customer Lifetime</strong> = 1 / (Churn Rate / 100) months<br>
        <strong>LTV</strong> = ARPU &times; Gross Margin% &times; Lifetime<br>
        <strong>CAC</strong> = Given value (total marketing & sales spend / customers acquired)<br>
        <strong>LTV:CAC Ratio</strong> = LTV / CAC<br>
        <strong>Payback Period</strong> = CAC / (ARPU &times; Gross Margin%) months<br>
        <strong>Total LTV</strong> = LTV &times; Number of Customers<br>
        <strong>Total CAC</strong> = CAC &times; Number of Customers
      </div>
    </div>

    <FAQ items={[
      { question: "What is a good LTV:CAC ratio?", answer: "A good LTV:CAC ratio is above 3:1. A ratio of 1:1 means you break even on each customer. Below 1:1 means you lose money on every customer you acquire. Industry benchmarks: 3:1 is considered good, 5:1 is excellent, and above 10:1 suggests you may be under-investing in growth." },
      { question: "What is a healthy payback period?", answer: "A healthy payback period is under 12 months for most SaaS businesses. For high-value enterprise SaaS, 12-18 months is acceptable. For low-cost consumer SaaS, under 6 months is ideal." },
      { question: "How do I lower my CAC?", answer: "To lower your CAC, focus on content marketing and SEO for organic traffic, improve your website conversion rate, optimize ad campaigns, implement referral programs, and reduce sales cycle friction." },
      { question: "How do I increase my LTV?", answer: "To increase LTV, reduce churn by improving your product and customer support, implement expansion revenue through upsells and cross-sells, introduce annual plans, and consider price optimization. Even a small reduction in churn can significantly boost LTV." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Calculate your LTV:CAC ratio above. If it is below 3:1, focus on either reducing churn (to increase LTV) or improving acquisition efficiency (to lower CAC). If it is above 5:1, you may have room to invest more aggressively in growth. Track this ratio monthly - it is the single best indicator of whether your SaaS business model is healthy and scalable.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="ltv-cac-ratio-calculator" category="saas" />
  </fragment>
</ToolLayout>


<script>
import { getNum, formatCurrency, showResult, hideResult } from '../utils/calculator-utils';

function calcLTV() {
  const arpu = getNum('ltvArpu');
  const margin = getNum('ltvMargin');
  const churn = getNum('ltvChurn');
  const cac = getNum('ltvCac');
  const customers = getNum('ltvCustomers');

  if (!arpu || arpu <= 0) return;
  if (margin === null) return;
  if (!churn || churn <= 0) return;
  if (!cac || cac <= 0) return;
  if (!customers || customers <= 0) return;

  const marginDecimal = margin / 100;
  const churnDecimal = churn / 100;
  const lifetime = 1 / churnDecimal;
  const ltv = arpu * marginDecimal * lifetime;
  const ratio = ltv / cac;
  const totalLTV = ltv * customers;
  const totalCAC = cac * customers;
  const payback = cac / (arpu * marginDecimal);

  document.getElementById('ltvLifetime').textContent = lifetime.toFixed(1) + ' months';
  document.getElementById('ltvLTV').textContent = formatCurrency(ltv);
  document.getElementById('ltvCAC').textContent = formatCurrency(cac);
  document.getElementById('ltvTotalLTV').textContent = formatCurrency(totalLTV);
  document.getElementById('ltvTotalCAC').textContent = formatCurrency(totalCAC);
  document.getElementById('ltvPayback').textContent = payback.toFixed(1) + ' months';

  const ratioEl = document.getElementById('ltvRatio');
  ratioEl.textContent = ratio.toFixed(2);
  if (ratio < 1) {
    (ratioEl as HTMLElement).style.color = '#dc2626';
  } else if (ratio < 3) {
    (ratioEl as HTMLElement).style.color = '#d97706';
  } else {
    (ratioEl as HTMLElement).style.color = '#059669';
  }

  showResult('ltvResult');
}

function resetLTV() {
  (document.getElementById('ltvArpu') as HTMLInputElement).value = '50';
  (document.getElementById('ltvMargin') as HTMLInputElement).value = '80';
  (document.getElementById('ltvChurn') as HTMLInputElement).value = '4';
  (document.getElementById('ltvCac') as HTMLInputElement).value = '500';
  (document.getElementById('ltvCustomers') as HTMLInputElement).value = '100';
  hideResult('ltvResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcLTV);
document.getElementById('resetBtn')!.addEventListener('click', resetLTV);
document.addEventListener('DOMContentLoaded', calcLTV);
</script>
