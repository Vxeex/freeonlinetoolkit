---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['unit-converter'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Unit Converter: Length, Weight, Volume & More",
    "description": "Unit Converter: Length, Weight, Volume & More. Free online calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/unit-converter/" }
  }
];
---

<ToolLayout title="Unit Converter: Length, Weight, Volume & More | FreeOnlineToolkit" description="Unit Converter: Length, Weight, Volume & More. Free online calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Unit Converter: Length, Weight, Volume & More</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>The metric system (SI) is used by 95% of the world's population - the US, Myanmar, and Liberia are the only countries that have not officially adopted it.</li>
      <li>Key conversions to memorise: 1 inch = 2.54 cm, 1 mile = 1.609 km, 1 kg = 2.205 lbs, 1 US gallon = 3.785 litres.</li>
      <li>Temperature conversion uses the formulas C = (F - 32) x 5/9 and F = (C x 9/5) + 32 - no simple ratio like other unit types.</li>
      <li>Confusing US and Imperial gallons is a common mistake - a US gallon is 3.785 litres while a UK Imperial gallon is 4.546 litres, a 20% difference.</li>
      <li>All conversion factors use internationally accepted standards based on SI definitions.</li>
    </ul>
  </div>

    <p>Unit conversion is one of those everyday tasks that sounds simple until you actually need to do it. Whether you are following a recipe that uses metric measurements in a country that uses cups and Fahrenheit, reading an engineering specification in a different unit system, or converting between measurement units for international shipping, accurate conversion is essential. Errors in unit conversion have caused real disasters - the Mars Climate Orbiter was lost in 1999 because one team used metric units and another used Imperial.</p>

    <p>The <strong>metric system</strong> (formally the International System of Units, or SI) was developed in France during the 1790s and is now used by virtually every country on Earth. Its power lies in its decimal structure: units scale by factors of 10, 100, or 1,000, making conversion as simple as moving a decimal point. A kilometre is 1,000 metres; a milligram is 1/1,000 of a gram. The US Customary system, by contrast, uses irregular conversion factors (12 inches in a foot, 3 feet in a yard, 5,280 feet in a mile) that require memorisation or lookup.</p>

    <p><strong>Temperature</strong> is unique among unit types because it cannot be converted with a simple multiplication factor. Celsius and Fahrenheit have different zero points and different scale sizes. Water freezes at 0C (32F) and boils at 100C (212F), giving each degree Celsius equal to 1.8 degrees Fahrenheit. The Kelvin scale, used in scientific work, starts at absolute zero (-273.15C) and has the same degree size as Celsius. Understanding these relationships is crucial for scientists, engineers, cooks, and anyone working across measurement systems.</p>

    <p>For <strong>volume conversions</strong>, one of the most common sources of confusion is the difference between US and Imperial measurements. A US fluid ounce (29.57 mL) is slightly larger than a UK Imperial fluid ounce (28.41 mL), but a US gallon (3.785 L) is smaller than a UK Imperial gallon (4.546 L) because the US system defines a gallon as 128 fluid ounces while the Imperial system uses 160. This 20% difference has caused costly mistakes in industries from pharmaceuticals to fuel trading, making it essential to specify which system you are using.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calculator below to get instant results. Read on for a full guide to the topic, key formulas, and expert tips.</p>
  </fragment>

<fragment slot="calculator">
    <div class="calc-card">
      <h2>Unit Converter</h2>

      <div class="form-group">
        <label for="ucCategory">Category</label>
        <select id="ucCategory">
          <option value="length">Length</option>
          <option value="weight">Weight & Mass</option>
          <option value="volume">Volume</option>
          <option value="temperature">Temperature</option>
          <option value="area">Area</option>
          <option value="speed">Speed</option>
        </select>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="ucFrom">From</label>
          <select id="ucFrom"></select>
        </div>
        <div class="form-group">
          <label for="ucTo">To</label>
          <select id="ucTo"></select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="ucValue">Value</label>
          <input type="number" id="ucValue" value="1" min="0" step="any">
        </div>
        <div class="form-group" style="display:flex;align-items:flex-end;">
          <button class="btn btn-primary" id="convertBtn" style="width:100%;">Convert</button>
        </div>
      </div>

      <div class="result-box" id="ucResult" style="display:block;">
        <div class="result-value" id="ucResultValue">1.000</div>
        <div class="result-label" id="ucResultLabel">Result</div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This unit converter covers six categories: <strong>Length</strong>, <strong>Weight & Mass</strong>, <strong>Volume</strong>, <strong>Temperature</strong>, <strong>Area</strong>, and <strong>Speed</strong>. Select a category, choose the source and target units, enter a value, and click Convert to see the result with full precision. Both metric and Imperial units are supported in every category.</p>
    </div>

<div class="content-section">
      <h2>How to Use the Unit Converter</h2>
      <p>Select a <strong>category</strong>, then choose the units you want to convert <strong>from</strong> and <strong>to</strong>. Enter the value and click <strong>Convert</strong> to see the result instantly. The converter supports both metric and imperial units across all categories.</p>
    </div>

    <div class="content-section">
      <h2>Conversion Reference</h2>
      <p><strong>Length:</strong> 1 inch = 2.54 cm, 1 foot = 0.3048 m, 1 mile = 1.609 km</p>
      <p><strong>Weight:</strong> 1 kg = 2.20462 lbs, 1 ounce = 28.3495 g</p>
      <p><strong>Volume:</strong> 1 gallon (US) = 3.78541 L, 1 fl oz = 29.5735 mL</p>
      <p><strong>Temperature:</strong> &deg;C = (&deg;F - 32) &times; 5/9</p>
    </div>

    <FAQ items={[
      { question: "Are the conversion factors accurate?", answer: "Yes. All conversion factors use internationally accepted standard definitions based on the international yard definition and SI standard definitions." },
      { question: "Can I convert between metric and imperial?", answer: "Yes, the converter supports both metric and imperial units in every category — meters to feet, kilograms to pounds, liters to gallons, and more." },
      { question: "What's the difference between US and Imperial gallons?", answer: "A US gallon equals 3.78541 liters, while a UK imperial gallon equals 4.54609 liters. This converter uses US liquid volume units." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Select your category and units above to start converting. For quick reference, bookmark the conversion factors in the reference section below the calculator. If you are working across measurement systems regularly, consider memorising the core conversions: 1 inch = 2.54 cm, 1 kg = 2.205 lbs, and 1 US gallon = 3.785 L.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="unit-converter" category="utility" />
  </fragment>
</ToolLayout>


<script>
import { formatNumber } from '../utils/calculator-utils';

const unitData: Record<string, { units: string[]; toBase: (number | string)[] }> = {
  length: {
    units: ['Meters', 'Kilometers', 'Centimeters', 'Millimeters', 'Miles', 'Yards', 'Feet', 'Inches', 'Nautical Miles'],
    toBase: [1, 1000, 0.01, 0.001, 1609.344, 0.9144, 0.3048, 0.0254, 1852]
  },
  weight: {
    units: ['Kilograms', 'Grams', 'Milligrams', 'Metric Tons', 'Pounds', 'Ounces', 'Stones', 'US Tons'],
    toBase: [1, 0.001, 0.000001, 1000, 0.453592, 0.0283495, 6.35029, 907.185]
  },
  volume: {
    units: ['Liters', 'Milliliters', 'Cubic Meters', 'US Gallons', 'US Quarts', 'US Pints', 'US Cups', 'Fluid Ounces (US)', 'Cubic Feet'],
    toBase: [1, 0.001, 1000, 3.78541, 0.946353, 0.473176, 0.236588, 0.0295735, 28.3168]
  },
  temperature: {
    units: ['Celsius', 'Fahrenheit', 'Kelvin'],
    toBase: ['C', 'F', 'K']
  },
  area: {
    units: ['Square Meters', 'Square Kilometers', 'Square Feet', 'Square Inches', 'Acres', 'Hectares', 'Square Miles', 'Square Yards'],
    toBase: [1, 1000000, 0.092903, 0.00064516, 4046.86, 10000, 2589988, 0.836127]
  },
  speed: {
    units: ['km/h', 'mph', 'm/s', 'Knots', 'ft/s'],
    toBase: [0.277778, 0.44704, 1, 0.514444, 0.3048]
  }
};

function updateUnits() {
  const cat = (document.getElementById('ucCategory') as HTMLSelectElement).value;
  const data = unitData[cat];
  const fromSel = document.getElementById('ucFrom') as HTMLSelectElement;
  const toSel = document.getElementById('ucTo') as HTMLSelectElement;
  fromSel.innerHTML = '';
  toSel.innerHTML = '';
  for (let i = 0; i < data.units.length; i++) {
    fromSel.innerHTML += '<option value="' + i + '">' + data.units[i] + '</option>';
    toSel.innerHTML += '<option value="' + i + '">' + data.units[i] + '</option>';
  }
  if (data.units.length > 1) toSel.value = '1';
  convertUnit();
}

function convertTemp(val: number, from: string, to: string): number {
  let celsius: number;
  if (from === 'C') celsius = val;
  else if (from === 'F') celsius = (val - 32) * 5 / 9;
  else celsius = val - 273.15;

  if (to === 'C') return celsius;
  if (to === 'F') return (celsius * 9 / 5) + 32;
  return celsius + 273.15;
}

function convertUnit() {
  const cat = (document.getElementById('ucCategory') as HTMLSelectElement).value;
  const fromIdx = parseInt((document.getElementById('ucFrom') as HTMLSelectElement).value);
  const toIdx = parseInt((document.getElementById('ucTo') as HTMLSelectElement).value);
  const val = parseFloat((document.getElementById('ucValue') as HTMLInputElement).value);
  if (isNaN(val)) return;

  const data = unitData[cat];
  let result: number;

  if (cat === 'temperature') {
    result = convertTemp(val, data.toBase[fromIdx] as string, data.toBase[toIdx] as string);
  } else {
    const baseVal = val * (data.toBase[fromIdx] as number);
    result = baseVal / (data.toBase[toIdx] as number);
  }

  const fromUnit = data.units[fromIdx];
  const toUnit = data.units[toIdx];
  (document.getElementById('ucResultValue') as HTMLElement).textContent = formatNumber(result, 4);
  (document.getElementById('ucResultLabel') as HTMLElement).textContent = val + ' ' + fromUnit + ' = ' + result.toFixed(4) + ' ' + toUnit;
}

document.getElementById('ucCategory')!.addEventListener('change', updateUnits);
document.getElementById('convertBtn')!.addEventListener('click', convertUnit);
document.addEventListener('DOMContentLoaded', updateUnits);
</script>
