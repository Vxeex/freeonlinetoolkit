---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['recipe-nutrition-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Recipe Nutrition Facts",
    "description": "Get nutrition facts for any recipe by adding ingredients and setting servings.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your recipe name and number of servings" },
      { "@type": "HowToStep", "text": "Select ingredients from the dropdown and add them to your recipe" },
      { "@type": "HowToStep", "text": "Click Calculate Nutrition to see calories, protein, carbs, fat, and more per serving" },
    ],
  },
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">Add your ingredients and get a complete nutrition facts label for your recipe. Calories, protein, carbs, fat, and more per serving.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Recipe Nutrition Label Generator</h2>

      <div class="form-group">
        <label for="recipeName">Recipe Name</label>
        <input type="text" id="recipeName" value="My Recipe" placeholder="Enter recipe name">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="servings">Servings</label>
          <input type="number" id="servings" value="4" min="1" max="100" step="1">
        </div>
        <div class="form-group">
          <label for="ingredientSelect">Add an Ingredient</label>
          <select id="ingredientSelect">
            <option value="">-- Select ingredient --</option>
            <optgroup label="Produce">
              <option value='{"cal":52,"pro":0.3,"fat":0.2,"car":14,"fib":2.4,"sod":1,"name":"Apples"}'>Apples (1 medium)</option>
              <option value='{"cal":89,"pro":1.1,"fat":0.3,"car":23,"fib":2.6,"sod":1,"name":"Banana"}'>Banana (1 medium)</option>
              <option value='{"cal":41,"pro":0.9,"fat":0.2,"car":9,"fib":1.2,"sod":7,"name":"Broccoli"}'>Broccoli (1 cup)</option>
              <option value='{"cal":16,"pro":0.7,"fat":0.2,"car":3,"fib":1,"sod":3,"name":"Carrots"}'>Carrots (1 cup)</option>
              <option value='{"cal":18,"pro":1.4,"fat":0.2,"car":3,"fib":1.6,"sod":6,"name":"Celery"}'>Celery (1 cup)</option>
              <option value='{"cal":24,"pro":0.8,"fat":0.2,"car":6,"fib":0.7,"sod":2,"name":"Cucumber"}'>Cucumber (1 cup)</option>
              <option value='{"cal":31,"pro":1,"fat":0.3,"car":6,"fib":2.8,"sod":4,"name":"Kale"}'>Kale (1 cup)</option>
              <option value='{"cal":22,"pro":0.6,"fat":0.1,"car":5,"fib":2,"sod":2,"name":"Mushrooms"}'>Mushrooms (1 cup)</option>
              <option value='{"cal":46,"pro":1.2,"fat":0.1,"car":11,"fib":2.4,"sod":3,"name":"Onion"}'>Onion (1 medium)</option>
              <option value='{"cal":28,"pro":0.9,"fat":0.3,"car":6,"fib":1.7,"sod":5,"name":"Bell Pepper"}'>Bell Pepper (1 cup)</option>
              <option value='{"cal":32,"pro":1,"fat":0.4,"car":7,"fib":2.2,"sod":5,"name":"Spinach"}'>Spinach (1 cup)</option>
              <option value='{"cal":18,"pro":0.8,"fat":0.2,"car":4,"fib":1.2,"sod":9,"name":"Tomato"}'>Tomato (1 medium)</option>
              <option value='{"cal":77,"pro":2,"fat":0.1,"car":17,"fib":3,"sod":6,"name":"Sweet Potato"}'>Sweet Potato (1 medium)</option>
              <option value='{"cal":113,"pro":2,"fat":0.1,"car":26,"fib":1.8,"sod":8,"name":"Potato"}'>Potato (1 medium)</option>
            </optgroup>
            <optgroup label="Protein">
              <option value='{"cal":165,"pro":31,"fat":3.6,"car":0,"fib":0,"sod":74,"name":"Chicken Breast"}'>Chicken Breast (4 oz)</option>
              <option value='{"cal":232,"pro":21,"fat":15,"car":0,"fib":0,"sod":62,"name":"Ground Beef 80/20"}'>Ground Beef 80/20 (4 oz)</option>
              <option value='{"cal":175,"pro":22,"fat":9,"car":0,"fib":0,"sod":64,"name":"Salmon"}'>Salmon (4 oz)</option>
              <option value='{"cal":85,"pro":20,"fat":0.9,"car":0,"fib":0,"sod":58,"name":"Shrimp"}'>Shrimp (4 oz)</option>
              <option value='{"cal":143,"pro":17,"fat":8,"car":0,"fib":0,"sod":56,"name":"Eggs"}'>Eggs (2 large)</option>
              <option value='{"cal":61,"pro":1.4,"fat":4.8,"car":4,"fib":0,"sod":45,"name":"Tofu"}'>Tofu (3 oz)</option>
            </optgroup>
            <optgroup label="Grains & Legumes">
              <option value='{"cal":130,"pro":2.7,"fat":0.3,"car":28,"fib":0.4,"sod":1,"name":"White Rice"}'>White Rice (1 cup cooked)</option>
              <option value='{"cal":216,"pro":5,"fat":1.8,"car":44,"fib":3.5,"sod":4,"name":"Brown Rice"}'>Brown Rice (1 cup cooked)</option>
              <option value='{"cal":182,"pro":6,"fat":0.8,"car":39,"fib":2,"sod":3,"name":"Pasta"}'>Pasta (1 cup cooked)</option>
              <option value='{"cal":113,"pro":8,"fat":0.4,"car":20,"fib":5.6,"sod":2,"name":"Black Beans"}'>Black Beans (1 cup)</option>
              <option value='{"cal":245,"pro":10,"fat":4,"car":46,"fib":12,"sod":2,"name":"Lentils"}'>Lentils (1 cup cooked)</option>
              <option value='{"cal":80,"pro":3,"fat":0.5,"car":15,"fib":2,"sod":190,"name":"White Bread"}'>White Bread (2 slices)</option>
            </optgroup>
            <optgroup label="Dairy & Alternatives">
              <option value='{"cal":113,"pro":8,"fat":9,"car":1.5,"fib":0,"sod":84,"name":"Cheddar Cheese"}'>Cheddar Cheese (1 oz)</option>
              <option value='{"cal":50,"pro":3.4,"fat":1,"car":5,"fib":0,"sod":63,"name":"Milk 2%"}'>Milk 2% (1 cup)</option>
              <option value='{"cal":100,"pro":10,"fat":5,"car":4,"fib":0,"sod":113,"name":"Greek Yogurt"}'>Greek Yogurt (6 oz)</option>
              <option value='{"cal":102,"pro":6,"fat":8,"car":1.5,"fib":0,"sod":65,"name":"Mozzarella"}'>Mozzarella (1 oz)</option>
              <option value='{"cal":42,"pro":1,"fat":2.5,"car":4,"fib":0,"sod":50,"name":"Butter"}'>Butter (1 tbsp)</option>
            </optgroup>
            <optgroup label="Oils & Fats">
              <option value='{"cal":119,"pro":0,"fat":13.5,"car":0,"fib":0,"sod":0,"name":"Olive Oil"}'>Olive Oil (1 tbsp)</option>
              <option value='{"cal":120,"pro":0,"fat":14,"car":0,"fib":0,"sod":0,"name":"Coconut Oil"}'>Coconut Oil (1 tbsp)</option>
              <option value='{"cal":102,"pro":0,"fat":11.5,"car":0,"fib":0,"sod":116,"name":"Soy Sauce"}'>Soy Sauce (1 tbsp)</option>
            </optgroup>
            <optgroup label="Pantry">
              <option value='{"cal":64,"pro":0,"fat":0,"car":17,"fib":0,"sod":0,"name":"White Sugar"}'>White Sugar (1 tbsp)</option>
              <option value='{"cal":21,"pro":0,"fat":0,"car":5,"fib":0,"sod":0,"name":"Honey"}'>Honey (1 tbsp)</option>
              <option value='{"cal":65,"pro":0,"fat":5,"car":5,"fib":0,"sod":105,"name":"Peanut Butter"}'>Peanut Butter (1 tbsp)</option>
              <option value='{"cal":49,"pro":1.2,"fat":0.1,"car":12,"fib":0,"sod":1,"name":"Flour"}'>Flour (1/4 cup)</option>
            </optgroup>
          </select>
        </div>
      </div>

      <div class="btn-group">
        <button class="btn btn-accent" id="addIngredientBtn"><i class="fa-solid fa-plus"></i> Add Ingredient</button>
      </div>

      <div id="ingredientList" style="margin-top:16px;"></div>

      <div class="btn-group" style="margin-top:16px;">
        <button class="btn btn-primary" id="calcBtn">Calculate Nutrition</button>
        <button class="btn btn-secondary" id="resetBtn">Clear All</button>
      </div>

      <div class="result-box" id="nutritionResult">
        <div class="result-value" id="nutritionResultValue">0 calories</div>
        <div class="result-label" id="nutritionResultLabel">Per serving</div>
        <div class="result-details" id="nutritionResultDetails"></div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How to Use the Recipe Nutrition Calculator</h2>
      <p>Select ingredients from the dropdown and click "Add Ingredient" to build your recipe. The calculator totals all nutrition facts and divides by the number of servings to give you per-serving values.</p>
      <ul>
        <li><strong>Calories:</strong> Total energy per serving</li>
        <li><strong>Macros:</strong> Protein, carbohydrates, and fat breakdown</li>
        <li><strong>Fiber:</strong> Dietary fiber content</li>
        <li><strong>Sodium:</strong> Salt content per serving</li>
      </ul>
      <p>The ingredient database includes common recipe ingredients with standard serving sizes. This is an estimation tool — actual values vary by brand, preparation method, and specific ingredients.</p>
    </div>

    <FAQ items={[
      { question: "How accurate is this calculator?", answer: "This calculator uses standard USDA nutrition data for common ingredients. Actual values may vary by brand, ripeness, cooking method, and specific varieties. Use it as a good estimate, not a laboratory analysis." },
      { question: "Can I add my own ingredients?", answer: "The dropdown includes 40+ common ingredients. For custom ingredients not in the database, you would need to look up their nutrition facts and adjust the total manually." },
      { question: "What about cooking oil, salt, and seasonings?", answer: "Oils and butter are included in the ingredient list. For dry seasonings, the amounts are usually negligible — 1 tsp of salt adds about 2,300mg sodium, so add it separately if tracking closely." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="recipe-nutrition-calculator" category="food" />
  </fragment>
</ToolLayout>

<script>
import { showResult, hideResult } from '../utils/calculator-utils';

interface Ingredient {
  cal: number;
  pro: number;
  fat: number;
  car: number;
  fib: number;
  sod: number;
  name: string;
}

let ingredients: Ingredient[] = [];

function addIngredient() {
  const select = document.getElementById('ingredientSelect') as HTMLSelectElement;
  if (!select.value) return;
  const data = JSON.parse(select.value) as Ingredient;
  ingredients.push(data);
  renderIngredients();
  select.value = '';
}

function removeIngredient(index: number) {
  ingredients.splice(index, 1);
  renderIngredients();
}

function renderIngredients() {
  const container = document.getElementById('ingredientList')!;
  if (ingredients.length === 0) {
    container.innerHTML = '<p style="color:var(--color-text-muted);font-size:0.85rem;">No ingredients added yet. Select from the dropdown above.</p>';
    return;
  }
  let html = '<table class="comparison-table"><tr><th>Ingredient</th><th>Cal</th><th>Pro (g)</th><th>Fat (g)</th><th>Car (g)</th><th></th></tr>';
  ingredients.forEach(function(ing, i) {
    html += '<tr><td>' + ing.name + '</td><td>' + ing.cal + '</td><td>' + ing.pro + '</td><td>' + ing.fat + '</td><td>' + ing.car + '</td><td><a href="#" onclick="return false;" class="remove-ingredient" data-index="' + i + '" style="color:var(--color-danger);"><i class="fa-solid fa-xmark"></i></a></td></tr>';
  });
  html += '</table>';
  container.innerHTML = html;
  hideResult('nutritionResult');

  container.querySelectorAll('.remove-ingredient').forEach(el => {
    el.addEventListener('click', function(e) {
      e.preventDefault();
      const idx = parseInt((this as HTMLElement).getAttribute('data-index') || '0');
      removeIngredient(idx);
    });
  });
}

function calcNutrition() {
  if (ingredients.length === 0) return;
  const servings = parseInt((document.getElementById('servings') as HTMLInputElement).value) || 4;
  const name = (document.getElementById('recipeName') as HTMLInputElement).value || 'My Recipe';

  const totals = { cal: 0, pro: 0, fat: 0, car: 0, fib: 0, sod: 0 };
  ingredients.forEach(function(ing) {
    totals.cal += ing.cal;
    totals.pro += ing.pro;
    totals.fat += ing.fat;
    totals.car += ing.car;
    totals.fib += ing.fib || 0;
    totals.sod += ing.sod || 0;
  });

  const perServing: Record<string, number> = {};
  for (const key in totals) {
    perServing[key] = (totals as any)[key] / servings;
  }

  document.getElementById('nutritionResultValue')!.textContent = Math.round(perServing.cal) + ' calories';
  document.getElementById('nutritionResultLabel')!.textContent = 'Per serving (' + servings + ' servings)';
  document.getElementById('nutritionResultDetails')!.innerHTML =
    '<div><span class="label">Recipe</span><span class="value">' + name + '</span></div>' +
    '<div><span class="label">Protein</span><span class="value">' + perServing.pro.toFixed(1) + ' g</span></div>' +
    '<div><span class="label">Total Fat</span><span class="value">' + perServing.fat.toFixed(1) + ' g</span></div>' +
    '<div><span class="label">Total Carbs</span><span class="value">' + perServing.car.toFixed(1) + ' g</span></div>' +
    '<div><span class="label">Dietary Fiber</span><span class="value">' + perServing.fib.toFixed(1) + ' g</span></div>' +
    '<div><span class="label">Sodium</span><span class="value">' + Math.round(perServing.sod) + ' mg</span></div>' +
    '<div><span class="label">Total recipe</span><span class="value">' + Math.round(totals.cal) + ' cal (' + servings + ' servings)</span></div>';
  showResult('nutritionResult');
}

function resetNutrition() {
  ingredients = [];
  (document.getElementById('recipeName') as HTMLInputElement).value = 'My Recipe';
  (document.getElementById('servings') as HTMLInputElement).value = '4';
  renderIngredients();
  hideResult('nutritionResult');
}

document.getElementById('addIngredientBtn')!.addEventListener('click', addIngredient);
document.getElementById('calcBtn')!.addEventListener('click', calcNutrition);
document.getElementById('resetBtn')!.addEventListener('click', resetNutrition);
document.addEventListener('DOMContentLoaded', renderIngredients);
</script>
