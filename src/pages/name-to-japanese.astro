function katakanaToHiragana(katakana: string): string {
  let result = '';
  let i = 0;
  while (i < katakana.length) {
    const three = katakana.slice(i, i + 3);
    if (KATAKANA_TO_HIRAGANA[three]) { result += KATAKANA_TO_HIRAGANA[three]; i += 3; continue; }
    const two = katakana.slice(i, i + 2);
    if (KATAKANA_TO_HIRAGANA[two]) { result += KATAKANA_TO_HIRAGANA[two]; i += 2; continue; }
    const one = katakana[i];
    if (KATAKANA_TO_HIRAGANA[one]) result += KATAKANA_TO_HIRAGANA[one]; else result += one;
    i++;
  }
  return result;
}

