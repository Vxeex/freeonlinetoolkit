function convertNameToKana(name: string, lang: string): string {
  if (!name.trim()) return '';

  // Chinese character input (Traditional or Simplified)
  if (lang === 'trad' || lang === 'simp') {
    return convertHanziToKana(name.trim());
  }

  // Split into words (first/last name)
  const parts = name.trim().split(/\s+/);
  const kanaParts: string[] = [];

  for (const part of parts) {
    if (lang === 'chinese') {
      kanaParts.push(convertChinesePinyinToKana(part));
    } else {
      kanaParts.push(convertEnglishToKana(part));
    }
  }

  return kanaParts.join('・');
}

function convertHanziToKana(text: string): string {
  let result = '';
  for (const char of text) {
    if (HANZI_MAP[char]) {
      result += HANZI_MAP[char];
    } else if (/[一-鿿㐀-䶿]/.test(char)) {
      result += char; // Unmapped CJK character — keep as-is
    } else if (/[぀-ゟ゠-ヿ]/.test(char)) {
      result += char; // Already hiragana or katakana — pass through
    } else if (/[a-zA-Z]/.test(char)) {
      result += convertEnglishToKana(char);
    } else {
      result += char; // Spaces, punctuation — pass through
    }
  }
  return result;
}

function convertEnglishToKana(word: string): string {
  let input = word.toLowerCase();
  let result = '';
  let i = 0;

  while (i < input.length) {
    let matched = false;
    let longestLen = 0;
    let longestKana = '';

    // Try longest match first (up to 5 chars)
    for (let len = 5; len >= 1; len--) {
      const chunk = input.slice(i, i + len);
      if (SYLLABLE_MAP[chunk]) {
        longestLen = len;
        longestKana = SYLLABLE_MAP[chunk];
        matched = true;
        break;
      }
    }

    if (matched) {
      result += longestKana;
      i += longestLen;
    } else {
      i++;
    }
  }

  return result;
}

function convertChinesePinyinToKana(pinyin: string): string {
  const pinyinMap: Record<string, string> = {
    'b': 'バ', 'p': 'パ', 'm': 'マ', 'f': 'ファ',
    'd': 'ダ', 't': 'タ', 'n': 'ナ', 'l': 'ラ',
    'g': 'ガ', 'k': 'カ', 'h': 'ハ',
    'j': 'ジ', 'q': 'チ', 'x': 'シ',
    'zh': 'ジ', 'ch': 'チ', 'sh': 'シ',
    'r': 'ル', 'z': 'ズ', 'c': 'ツ', 's': 'ス',
    'w': 'ワ', 'y': 'イ',
    'a': 'ア', 'o': 'オ', 'e': 'ウー', 'i': 'イー', 'u': 'ウー', 'v': 'ユイ',
    'ai': 'アイ', 'ei': 'エイ', 'ui': 'ウイ',
    'ao': 'アオ', 'ou': 'オウ', 'iu': 'イウ',
    'an': 'アン', 'en': 'エン', 'in': 'イン', 'un': 'ウン', 'vn': 'ユイン',
    'ang': 'アン', 'eng': 'エン', 'ing': 'イン', 'ong': 'オン',
    'ia': 'イア', 'ie': 'イエ', 'iao': 'イアオ', 'ian': 'イエン',
    'iang': 'イアン', 'iong': 'イオン',
    'ua': 'ウア', 'uo': 'ウオ', 'uai': 'ウアイ', 'uan': 'ワン',
    'uang': 'ワン', 'ueng': 'ウエン',
    'ue': 'ユエ', 'van': 'ユアン', 've': 'ユエ',
  };

  let input = pinyin.toLowerCase();
  let result = '';
  let i = 0;
  while (i < input.length) {
    let matched = false;
    for (let len = 4; len >= 1; len--) {
      const chunk = input.slice(i, i + len);
      if (pinyinMap[chunk]) {
        result += pinyinMap[chunk];
        i += len;
        matched = true;
        break;
      }
    }
    if (!matched) {
      const engResult = convertEnglishToKana(input.slice(i));
      result += engResult;
      break;
    }
  }
  return result;
}

function convertName() {
  const nameInput = document.getElementById('nameInput') as HTMLInputElement;
  const langSelect = document.getElementById('inputLang') as HTMLSelectElement;
  const outputRadios = document.querySelectorAll('input[name="outputType"]') as NodeListOf<HTMLInputElement>;

  const name = nameInput.value.trim();
  if (!name) return;

  const lang = langSelect.value;
  const katakana = convertNameToKana(name, lang);

  if (!katakana) return;

  const hiragana = katakanaToHiragana(katakana);
  const romaji = toRomaji(katakana);
  const charCount = katakana.replace(/[・ー\s]/g, '').length;

  let selectedOutput = 'both';
  for (const radio of outputRadios) {
    if (radio.checked) { selectedOutput = radio.value; break; }
  }

  const katakanaEl = document.getElementById('katakanaResult')!;
  const hiraganaEl = document.getElementById('hiraganaResult')!;

  if (selectedOutput === 'both' || selectedOutput === 'katakana') {
    katakanaEl.textContent = katakana;
    (katakanaEl.parentElement as HTMLElement).style.display = '';
  } else {
    (katakanaEl.parentElement as HTMLElement).style.display = 'none';
  }
  if (selectedOutput === 'both' || selectedOutput === 'hiragana') {
    hiraganaEl.textContent = hiragana;
    (hiraganaEl.parentElement as HTMLElement).style.display = '';
  } else {
    (hiraganaEl.parentElement as HTMLElement).style.display = 'none';
  }

  document.getElementById('romajiResult')!.textContent = romaji;
  document.getElementById('charCount')!.textContent = String(charCount);

  showResult('japaneseResult');
}

function reset() {
  (document.getElementById('nameInput') as HTMLInputElement).value = 'Sarah Johnson';
  (document.getElementById('inputLang') as HTMLSelectElement).value = 'english';
  (document.querySelector('input[name="outputType"][value="both"]') as HTMLInputElement).checked = true;
  hideResult('japaneseResult');
}

document.getElementById('convertBtn')!.addEventListener('click', convertName);
document.getElementById('resetBtn')!.addEventListener('click', reset);

document.getElementById('copyKatakanaBtn')!.addEventListener('click', () => {
  const text = document.getElementById('katakanaResult')!.textContent;
  if (text && text !== 'ー') {
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('copyKatakanaBtn')!;
      btn.innerHTML = '<i class="fa-regular fa-check"></i> Copied!';
      setTimeout(() => { btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy katakana'; }, 2000);
    });
  }
});
document.getElementById('copyHiraganaBtn')!.addEventListener('click', () => {
  const text = document.getElementById('hiraganaResult')!.textContent;
  if (text && text !== 'ー') {
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('copyHiraganaBtn')!;
      btn.innerHTML = '<i class="fa-regular fa-check"></i> Copied!';
      setTimeout(() => { btn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy hiragana'; }, 2000);
    });
  }
});

document.getElementById('nameInput')!.addEventListener('keydown', (e: KeyboardEvent) => {
  if (e.key === 'Enter') convertName();
});

document.addEventListener('DOMContentLoaded', convertName);
</script>
