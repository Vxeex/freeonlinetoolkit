---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['name-to-japanese'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Convert Names to Japanese",
    "description": "Convert English and Chinese names to Japanese katakana and hiragana using phonetic transliteration.",
    "step": [
      { "@type": "HowToStep", "text": "Enter an English or Chinese name in the input field" },
      { "@type": "HowToStep", "text": "Choose the input language type (English or Chinese/Pinyin)" },
      { "@type": "HowToStep", "text": "Click Convert to see your name in katakana and hiragana" },
    ],
  },
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">See how your name sounds in Japanese. Enter any English or Chinese name and get instant katakana and hiragana transliteration.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Name to Japanese Converter</h2>
      <div class="form-group">
        <label for="nameInput">Enter a name</label>
        <input type="text" id="nameInput" value="Sarah Johnson" placeholder="Enter an English or Chinese name..." />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="inputLang">Input language</label>
          <select id="inputLang">
            <option value="english">English</option>
            <option value="chinese">Chinese (Pinyin)</option>
            <option value="trad">Chinese (Traditional)</option>
            <option value="simp">Chinese (Simplified)</option>
          </select>
        </div>
        <div class="form-group">
          <label>&nbsp;</label>
          <div style="padding-top:6px;">
            <label class="radio-group" style="gap:6px;">
              <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
                <input type="radio" name="outputType" value="both" checked /> Both scripts
              </label>
              <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
              <input type="radio" name="outputType" value="katakana" /> Katakana only
              </label>
              <label style="display:flex;align-items:center;gap:4px;cursor:pointer;">
                <input type="radio" name="outputType" value="hiragana" /> Hiragana only
              </label>
            </label>
          </div>
        </div>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="convertBtn">Convert to Japanese</button>
        <button class="btn btn-secondary" id="resetBtn">Reset</button>
      </div>

      <div class="result-box" id="japaneseResult">
        <div style="margin-bottom:16px;">
          <div style="font-size:0.8rem;color:var(--color-text-secondary);margin-bottom:4px;">Katakana (カタカナ)</div>
          <div class="result-value" id="katakanaResult" style="font-size:2rem;">ー</div>
        </div>
        <div style="margin-bottom:16px;">
          <div style="font-size:0.8rem;color:var(--color-text-secondary);margin-bottom:4px;">Hiragana (ひらがな)</div>
          <div class="result-value" id="hiraganaResult" style="font-size:2rem;color:var(--color-accent);">ー</div>
        </div>
        <div class="result-details">
          <div><span class="label">Reading</span><span class="value" id="romajiResult">—</span></div>
          <div><span class="label">Characters</span><span class="value" id="charCount">0</span></div>
        </div>
        <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn btn-secondary" id="copyKatakanaBtn" style="font-size:0.8rem;padding:8px 16px;">
            <i class="fa-regular fa-copy"></i> Copy katakana
          </button>
          <button class="btn btn-secondary" id="copyHiraganaBtn" style="font-size:0.8rem;padding:8px 16px;">
            <i class="fa-regular fa-copy"></i> Copy hiragana
          </button>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How the Name to Japanese Converter Works</h2>
      <p>Japanese uses three writing systems: <strong>katakana</strong> for foreign words and names, <strong>hiragana</strong> for native Japanese words, and <strong>kanji</strong> for Chinese characters. When converting non-Japanese names, katakana is the standard script used.</p>
      <p>The conversion is based on <strong>phonetic approximation</strong> — each sound in the original name is mapped to the closest equivalent sound in Japanese. Because Japanese has fewer distinct syllables than English (about 100 vs. over 15,000 in English), some sounds must be approximated.</p>
      <p>For example, the English sounds "l" and "r" are both mapped to Japanese "r" (ら行), and "th" becomes "s" or "z". Consonant clusters like "st" are broken into separate syllables: "s" + "u" + "t" + "o".</p>
    </div>

    <div class="content-section">
      <h2>Tips for Accurate Conversion</h2>
      <ul>
        <li><strong>Use the full name</strong> — Enter both first and last name for a complete conversion. The tool will separate them automatically.</li>
        <li><strong>Try different spellings</strong> — If the result sounds wrong, try alternative phonetic spellings of your name. For example, "Catherine" and "Katherine" will produce different results.</li>
        <li><strong>Chinese names</strong> — Enter names in pinyin (standard romanization). For example, "Zhang Wei" or "Li Xiaoming". The tool will approximate the Mandarin pronunciation.</li>
        <li><strong>Chinese characters</strong> — You can also enter Chinese characters directly. The tool will look up each character's Japanese on'yomi (Chinese-derived reading) to create the katakana conversion.</li>
        <li><strong>Double consonants</strong> — English doubled consonants like "tt" or "pp" often become a small ッ (sokuon) before the consonant, creating a pause effect.</li>
      </ul>
    </div>

    <FAQ items={[
      { question: "How accurate is the name conversion?", answer: "The conversion uses standard Japanese transliteration rules for foreign names. However, there is often no single correct way to write a foreign name in Japanese. Different people with the same name may choose different katakana representations. This tool provides the most common and natural-sounding conversion." },
      { question: "Why does my name get longer in Japanese?", answer: "Japanese has a strict consonant-vowel syllable structure. Consonant clusters in English (like 'st', 'nd', 'mp') must be split into separate syllables. For example, 'Smith' (1 syllable in English) becomes 'Su-mi-su' (3 syllables in Japanese)." },
      { question: "Can I use this to write my name on official documents?", answer: "This tool is for educational and personal use. For official documents, passports, or legal purposes, follow the guidelines provided by the relevant Japanese authorities." },
      { question: "What is the difference between katakana and hiragana?", answer: "Katakana is used for foreign words, names, loanwords, and emphasis. Hiragana is used for native Japanese words and grammar. Foreign names are almost always written in katakana." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="name-to-japanese" category="utility" />
  </fragment>
</ToolLayout>

