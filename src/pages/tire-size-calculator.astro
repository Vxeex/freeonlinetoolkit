---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['tire-size-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Compare Tire Sizes",
    "description": "Compare two tire sizes to see the differences in diameter, width, sidewall height, circumference, and speedometer error.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your first tire size in metric format (e.g., 245/45R18)" },
      { "@type": "HowToStep", "text": "Enter your second tire size to compare against (e.g., 225/60R16)" },
      { "@type": "HowToStep", "text": "Click Compare to see side-by-side specifications and the fitment recommendation" },
    ],
  },
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">Compare two tire sizes side by side. See the differences in diameter, width, sidewall height, circumference, revolutions per mile, and speedometer error. Find out if a tire swap is safe and recommended.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2><i class="fa-solid fa-arrows-left-right" style="color:var(--color-primary);margin-right:8px;"></i> Tire Size Comparison</h2>

      <div class="tire-input-group">
        <div class="tire-label"><span class="tire-num">1</span> Current / Reference Tire</div>
        <div class="form-group">
          <label for="tire1">Tire Size (e.g., 245/45R18)</label>
          <div class="input-with-badge">
            <input type="text" id="tire1" value="245/45R18" placeholder="e.g. 245/45R18" autocomplete="off" spellcheck="false">
            <span class="input-badge">metric</span>
          </div>
        </div>
        <div class="tire-example"><i class="fa-regular fa-circle-info"></i> Format: Section Width (mm) / Aspect Ratio (%) R Rim Diameter (inches)</div>
      </div>

      <div class="tire-input-group">
        <div class="tire-label"><span class="tire-num">2</span> New / Comparison Tire</div>
        <div class="form-group">
          <label for="tire2">Tire Size (e.g., 225/60R16)</label>
          <div class="input-with-badge">
            <input type="text" id="tire2" value="225/60R16" placeholder="e.g. 225/60R16" autocomplete="off" spellcheck="false">
            <span class="input-badge">metric</span>
          </div>
        </div>
        <div class="tire-example"><i class="fa-regular fa-circle-info"></i> Format: Section Width (mm) / Aspect Ratio (%) R Rim Diameter (inches)</div>
      </div>

      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn"><i class="fa-solid fa-scale-balanced"></i> Compare</button>
        <button class="btn btn-secondary" id="resetBtn"><i class="fa-solid fa-rotate-left"></i> Reset</button>
      </div>

      <div class="result-box" id="tireResult">
        <div class="result-value" id="tireDiffPercent">0.0%</div>
        <div class="result-label">Difference in Diameter</div>

        <div class="fitment-banner" id="fitmentBanner"></div>

        <div class="diff-visual">
          <div class="diff-visual-label"><i class="fa-solid fa-chart-simple"></i> Diameter Difference Scale</div>
          <div class="diff-bar-track">
            <div class="diff-bar-fill" id="diffBarFill" style="width:0%;"></div>
            <div class="diff-bar-marker" id="diffBarMarker" style="left:50%;"></div>
          </div>
          <div class="diff-bar-labels">
            <span>0%</span>
            <span>3% (max safe)</span>
            <span>10%+</span>
          </div>
        </div>

        <div class="tire-visual-wrap" id="tireVisualWrap">
          <div class="tire-visual">
            <svg viewBox="0 0 120 120" id="tireVis1"></svg>
            <div class="tire-visual-label">Tire 1</div>
            <div class="tire-visual-dims" id="tireVisLabel1"></div>
          </div>
          <div class="tire-visual">
            <svg viewBox="0 0 120 120" id="tireVis2"></svg>
            <div class="tire-visual-label">Tire 2</div>
            <div class="tire-visual-dims" id="tireVisLabel2"></div>
          </div>
        </div>

        <table class="comparison-table" id="tireComparisonTable">
          <thead>
            <tr><th>Specification</th><th>Tire 1</th><th>Tire 2</th><th>Difference</th></tr>
          </thead>
          <tbody id="tireTableBody"></tbody>
        </table>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How to Use the Tire Size Comparison Calculator</h2>
      <p>Enter two tire sizes in the standard <strong>metric format</strong>: <code>Section Width / Aspect Ratio R Rim Diameter</code>. For example, <strong>245/45R18</strong> means 245mm tread width, 45% aspect ratio, radial construction, 18-inch rim.</p>
      <p>The calculator compares every measurement and shows the <strong>percentage difference</strong> between the two tires. A diameter difference under 3% is generally considered a safe swap.</p>
    </div>

    <div class="content-section">
      <h2>Understanding the Comparison Results</h2>
      <ul>
        <li><strong>Tire Diameter</strong> - The overall height. Changing this affects ground clearance and speedometer accuracy.</li>
        <li><strong>Section Width</strong> - The tread width. Wider tires may rub on suspension or bodywork.</li>
        <li><strong>Sidewall Height</strong> - Distance from rim to tread. Affects ride comfort and handling.</li>
        <li><strong>Circumference</strong> - Distance traveled per revolution. Directly impacts speedometer readings.</li>
        <li><strong>Revolutions per Mile</strong> - How many times the tire rotates per mile.</li>
        <li><strong>Speedometer Error</strong> - How much your speedometer will be off with the new tires.</li>
      </ul>
      <div class="formula-box">
        <strong>Key Formula:</strong><br>
        Sidewall (in) = (Section Width &times; Aspect Ratio &divide; 100) &divide; 25.4<br>
        Diameter (in) = Rim Diameter + 2 &times; Sidewall Height<br>
        Circumference (in) = &pi; &times; Diameter
      </div>
    </div>

    <div class="content-section">
      <h2>Is It Safe to Change Tire Size?</h2>
      <p>The <strong>3% rule</strong> is the industry standard. If the new tire's diameter is within 3% of the original, the swap is generally safe. Beyond 3%, you may experience inaccurate speedometer, reduced clearance, gearing changes, and potential issues with ABS and traction control.</p>
    </div>

    <FAQ items={[
      { question: "What do the numbers on a tire mean?", answer: "Tire sizes use the metric format XXX/XX RXX. The first three digits are the section width in millimeters. The next two are the aspect ratio - sidewall height as a percentage of width. The 'R' means radial construction. The final number is the rim diameter in inches." },
      { question: "How much speedometer error is acceptable?", answer: "Most manufacturers allow up to 3-5% speedometer error. When changing tire size, keeping the diameter within 3% of the original ensures the speedometer stays reasonably accurate." },
      { question: "Can I use a wider tire on the same rim?", answer: "You can typically go up or down by 10-20mm in width on the same rim, but always check the rim width range for the tire size. Going too wide can cause the tire to bulge improperly." },
      { question: "Does tire size affect fuel economy?", answer: "Yes. Larger and wider tires increase rolling resistance and weight, which can reduce fuel economy. Taller tires also change your final drive ratio, potentially causing the engine to work harder at highway speeds." },
      { question: "What is the plus-sizing concept?", answer: "Plus-sizing increases rim diameter while reducing tire sidewall height to keep the overall diameter the same. For example, going from 205/55R16 to 225/45R17 (Plus 1) or 225/40R18 (Plus 2)." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="tire-size-calculator" category="automotive" />
  </fragment>
</ToolLayout>

<script>
import { showResult, hideResult } from '../utils/calculator-utils';

interface TireSize {
  width: number;
  aspectRatio: number;
  rimDiameter: number;
}

interface TireDimensions {
  sidewallMm: number;
  sidewallIn: number;
  diameterIn: number;
  circumferenceIn: number;
  revsPerMile: number;
  widthIn: number;
}

function parseTireSize(str: string): TireSize | null {
  if (!str) return null;
  str = str.trim().toUpperCase();
  const match = str.match(/^(\d+)\s*\/\s*(\d+)\s*R\s*(\d+)$/);
  if (!match) return null;
  return {
    width: parseInt(match[1], 10),
    aspectRatio: parseInt(match[2], 10),
    rimDiameter: parseInt(match[3], 10)
  };
}

function calcTireDimensions(tire: TireSize): TireDimensions | null {
  if (!tire) return null;
  const sidewallMm = tire.width * tire.aspectRatio / 100;
  const sidewallIn = sidewallMm / 25.4;
  const diameterIn = tire.rimDiameter + 2 * sidewallIn;
  const circumferenceIn = Math.PI * diameterIn;
  const revsPerMile = 63360 / circumferenceIn;
  return {
    sidewallMm, sidewallIn, diameterIn, circumferenceIn, revsPerMile,
    widthIn: tire.width / 25.4
  };
}

function formatDiff(val: number, unit: string, decimals: number, isPercent: boolean): string {
  decimals = decimals !== undefined ? decimals : 2;
  const absVal = Math.abs(val);
  const formatted = absVal.toFixed(decimals);
  const sign = val > 0 ? '+' : (val < 0 ? '-' : '');
  const badgeClass = val > 0 ? 'positive' : (val < 0 ? 'negative' : 'neutral');
  let badgeLabel = val > 0 ? '+' + formatted : (val < 0 ? '-' + formatted : '0');
  if (isPercent) badgeLabel += '%';
  else badgeLabel += ' ' + unit;
  return '<span class="diff-badge ' + badgeClass + '">' + badgeLabel + '</span>';
}

function addRow(label: string, val1: string, val2: string, diff: number, unit: string, decimals: number, isPercent: boolean) {
  const tbody = document.getElementById('tireTableBody')!;
  const tr = document.createElement('tr');
  const tdLabel = document.createElement('td');
  tdLabel.textContent = label;
  tr.appendChild(tdLabel);
  const td1 = document.createElement('td');
  td1.className = 'highlight';
  td1.textContent = val1;
  tr.appendChild(td1);
  const td2 = document.createElement('td');
  td2.className = 'highlight-accent';
  td2.textContent = val2;
  tr.appendChild(td2);
  const tdDiff = document.createElement('td');
  tdDiff.innerHTML = formatDiff(diff, unit, decimals, isPercent);
  tr.appendChild(tdDiff);
  tbody.appendChild(tr);
}

function drawTire(svgId: string, diameterIn: number, widthIn: number) {
  const svg = document.getElementById(svgId) as unknown as SVGSVGElement;
  if (!svg) return;
  const maxDim = Math.max(diameterIn, widthIn);
  const scale = 50 / maxDim;
  const cx = 60, cy = 60;
  const tireR = (diameterIn / 2) * scale;

  const outerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  outerCircle.setAttribute('cx', String(cx));
  outerCircle.setAttribute('cy', String(cy));
  outerCircle.setAttribute('r', String(tireR));
  outerCircle.setAttribute('fill', 'none');
  outerCircle.setAttribute('stroke', 'var(--color-text)');
  outerCircle.setAttribute('stroke-width', '2.5');

  const innerCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  innerCircle.setAttribute('cx', String(cx));
  innerCircle.setAttribute('cy', String(cy));
  innerCircle.setAttribute('r', String(tireR - 2));
  innerCircle.setAttribute('fill', 'var(--color-bg)');
  innerCircle.setAttribute('stroke', 'none');

  let rimR = (diameterIn / 2 - (diameterIn - widthIn) / 2) * scale;
  if (rimR < 4) rimR = 4;
  const hubCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  hubCircle.setAttribute('cx', String(cx));
  hubCircle.setAttribute('cy', String(cy));
  hubCircle.setAttribute('r', String(rimR));
  hubCircle.setAttribute('fill', 'var(--color-text-muted)');
  hubCircle.setAttribute('stroke', 'var(--color-text)');
  hubCircle.setAttribute('stroke-width', '1.5');

  svg.innerHTML = '';
  svg.appendChild(innerCircle);
  svg.appendChild(outerCircle);
  svg.appendChild(hubCircle);
}

function compareTires() {
  const raw1 = (document.getElementById('tire1') as HTMLInputElement).value.trim();
  const raw2 = (document.getElementById('tire2') as HTMLInputElement).value.trim();

  const tire1 = parseTireSize(raw1);
  const tire2 = parseTireSize(raw2);

  if (!tire1 || !tire2) {
    const invalid = (!tire1 ? 'Tire 1' : 'Tire 2');
    alert('Invalid tire size format for ' + invalid + '. Use format: SectionWidth/AspectRatio RRimDiameter (e.g., 245/45R18)');
    return;
  }

  const d1 = calcTireDimensions(tire1);
  const d2 = calcTireDimensions(tire2);
  if (!d1 || !d2) return;

  const diffPercent = ((d2.diameterIn - d1.diameterIn) / d1.diameterIn) * 100;
  const speedoError = ((d1.diameterIn / d2.diameterIn) - 1) * 100;
  const absDiff = Math.abs(diffPercent);
  const isSafe = absDiff <= 3;

  const sign = diffPercent > 0 ? '+' : '';
  document.getElementById('tireDiffPercent')!.textContent = sign + diffPercent.toFixed(2) + '%';

  const banner = document.getElementById('fitmentBanner')!;
  banner.className = 'fitment-banner';

  if (isSafe) {
    banner.classList.add('good', 'visible');
    banner.innerHTML = '<i class="fa-solid fa-circle-check"></i><div><strong>Recommended Swap</strong> &mdash; The diameter difference is ' + absDiff.toFixed(2) + '%, which is within the safe 3% threshold. These tires are close enough in size for most vehicles.</div>';
  } else if (absDiff <= 5) {
    banner.classList.add('info', 'visible');
    banner.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i><div><strong>Borderline Swap</strong> &mdash; The diameter difference is ' + absDiff.toFixed(2) + '%, which exceeds the recommended 3% threshold.</div>';
  } else {
    banner.classList.add('warning', 'visible');
    banner.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i><div><strong>Not Recommended</strong> &mdash; The diameter difference is ' + absDiff.toFixed(2) + '%, well beyond the safe 3% limit.</div>';
  }

  const fillPct = Math.min(Math.abs(diffPercent) / 10 * 100, 100);
  const barFill = document.getElementById('diffBarFill')!;
  const barMarker = document.getElementById('diffBarMarker')!;
  barFill.style.width = fillPct + '%';
  barFill.className = 'diff-bar-fill';

  let markerPos = 50 + (diffPercent / 10) * 50;
  markerPos = Math.max(0, Math.min(100, markerPos));
  barMarker.style.left = markerPos + '%';

  if (diffPercent > 0) barFill.classList.add('positive');
  else if (diffPercent < 0) barFill.classList.add('negative');
  else barFill.classList.add('zero');

  document.getElementById('tireTableBody')!.innerHTML = '';

  const fmt = (val: number, dec?: number) => val.toFixed(dec !== undefined ? dec : 2);

  addRow('Tire Size',
    tire1.width + '/' + tire1.aspectRatio + 'R' + tire1.rimDiameter,
    tire2.width + '/' + tire2.aspectRatio + 'R' + tire2.rimDiameter,
    0, '', 0, false);

  addRow('Diameter',
    fmt(d1.diameterIn) + ' in (' + (d1.diameterIn * 25.4).toFixed(1) + ' mm)',
    fmt(d2.diameterIn) + ' in (' + (d2.diameterIn * 25.4).toFixed(1) + ' mm)',
    diffPercent, '', 2, true);

  const widthDiff = tire2.width - tire1.width;
  addRow('Section Width',
    tire1.width + ' mm (' + fmt(d1.widthIn) + ' in)',
    tire2.width + ' mm (' + fmt(d2.widthIn) + ' in)',
    widthDiff, 'mm', 1, false);

  const sidewallDiff = d2.sidewallMm - d1.sidewallMm;
  addRow('Sidewall Height',
    fmt(d1.sidewallMm) + ' mm (' + fmt(d1.sidewallIn, 2) + ' in)',
    fmt(d2.sidewallMm) + ' mm (' + fmt(d2.sidewallIn, 2) + ' in)',
    sidewallDiff, 'mm', 1, false);

  const circDiff = ((d2.circumferenceIn - d1.circumferenceIn) / d1.circumferenceIn) * 100;
  addRow('Circumference',
    fmt(d1.circumferenceIn) + ' in (' + (d1.circumferenceIn * 25.4).toFixed(1) + ' mm)',
    fmt(d2.circumferenceIn) + ' in (' + (d2.circumferenceIn * 25.4).toFixed(1) + ' mm)',
    circDiff, '', 2, true);

  const revDiff = d2.revsPerMile - d1.revsPerMile;
  addRow('Revolutions per Mile',
    fmt(d1.revsPerMile, 1), fmt(d2.revsPerMile, 1), revDiff, 'rev', 1, false);

  addRow('Speedometer Error (Tire 2 vs Tire 1)', '-', fmt(speedoError, 2) + '%', speedoError, '', 2, true);

  const speedoLabel = document.createElement('tr');
  speedoLabel.innerHTML = '<td colspan="4" style="font-size:0.82rem;color:var(--color-text-muted);padding:8px 16px;background:var(--color-bg);">' +
    (speedoError > 0
      ? '<i class="fa-regular fa-circle-info"></i> Tire 2 is smaller: speedometer reads <strong>' + fmt(Math.abs(speedoError), 1) + '% faster</strong> than actual speed'
      : speedoError < 0
        ? '<i class="fa-regular fa-circle-info"></i> Tire 2 is larger: speedometer reads <strong>' + fmt(Math.abs(speedoError), 1) + '% slower</strong> than actual speed'
        : '<i class="fa-regular fa-circle-info"></i> No speedometer error &mdash; tire sizes are identical in diameter') +
    '</td>';
  document.getElementById('tireTableBody')!.appendChild(speedoLabel);

  drawTire('tireVis1', d1.diameterIn, d1.widthIn);
  drawTire('tireVis2', d2.diameterIn, d2.widthIn);

  document.getElementById('tireVisLabel1')!.textContent = fmt(d1.diameterIn) + '" x ' + fmt(tire1.width) + 'mm';
  document.getElementById('tireVisLabel2')!.textContent = fmt(d2.diameterIn) + '" x ' + fmt(tire2.width) + 'mm';

  showResult('tireResult');
}

function resetTires() {
  (document.getElementById('tire1') as HTMLInputElement).value = '245/45R18';
  (document.getElementById('tire2') as HTMLInputElement).value = '225/60R16';
  hideResult('tireResult');
  document.getElementById('fitmentBanner')!.className = 'fitment-banner';
}

document.getElementById('calcBtn')!.addEventListener('click', compareTires);
document.getElementById('resetBtn')!.addEventListener('click', resetTires);
document.addEventListener('DOMContentLoaded', compareTires);
</script>

<style>
  .input-with-badge { position: relative; }
  .input-with-badge input { padding-right: 70px; }
  .input-with-badge .input-badge {
    position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    font-size: 0.7rem; font-weight: 600; color: var(--color-text-muted);
    background: var(--color-bg); padding: 2px 8px; border-radius: 4px;
    pointer-events: none; white-space: nowrap;
  }
  .tire-input-group {
    border: 1px solid var(--color-border-light); border-radius: var(--radius-md);
    padding: 20px; margin-bottom: 18px; background: var(--color-bg);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .tire-input-group:focus-within { border-color: var(--color-primary); }
  .tire-input-group .tire-label {
    font-family: var(--font-display); font-size: 0.9rem; font-weight: 600;
    color: var(--color-text); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
  }
  .tire-input-group .tire-label .tire-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%; background: var(--color-primary);
    color: #fff; font-size: 0.75rem; font-weight: 700;
  }
  .tire-input-group .tire-example { font-size: 0.78rem; color: var(--color-text-muted); margin-top: 6px; }
  .diff-badge { display: inline-block; padding: 1px 8px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; margin-left: 6px; }
  .diff-badge.positive { background: var(--color-danger-bg); color: var(--color-danger); }
  .diff-badge.negative { background: var(--color-success-bg); color: var(--color-success); }
  .diff-badge.neutral { background: var(--color-primary-bg); color: var(--color-primary); }
  .fitment-banner {
    border-radius: var(--radius-md); padding: 20px 24px; margin-top: 20px;
    display: none; align-items: center; gap: 14px; font-size: 0.95rem; line-height: 1.6;
  }
  .fitment-banner.visible { display: flex; }
  .fitment-banner i { font-size: 1.5rem; flex-shrink: 0; }
  .fitment-banner.good { background: var(--color-success-bg); border: 1px solid var(--color-success-border); color: var(--color-success); }
  .fitment-banner.warning { background: var(--color-danger-bg); border: 1px solid var(--color-danger-border); color: var(--color-danger); }
  .fitment-banner.info { background: var(--color-primary-bg); border: 1px solid var(--color-primary-light); color: var(--color-primary); }
  .diff-visual { margin-top: 18px; padding: 18px 0; border-top: 1px solid var(--color-border-light); }
  .diff-visual-label { font-size: 0.82rem; font-weight: 500; color: var(--color-text-secondary); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
  .diff-bar-track { position: relative; height: 12px; background: var(--color-bg); border-radius: 6px; overflow: hidden; border: 1px solid var(--color-border-light); }
  .diff-bar-fill { height: 100%; border-radius: 6px; transition: width 0.4s var(--ease-out); background: var(--color-primary); }
  .diff-bar-fill.negative { background: var(--color-success); }
  .diff-bar-fill.positive { background: var(--color-primary); }
  .diff-bar-fill.zero { background: var(--color-text-muted); }
  .diff-bar-marker { position: absolute; top: -4px; width: 2px; height: 20px; background: var(--color-text); border-radius: 1px; left: 50%; }
  .diff-bar-labels { display: flex; justify-content: space-between; margin-top: 5px; font-size: 0.75rem; color: var(--color-text-muted); }
  .tire-visual-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--color-border-light); }
  .tire-visual { text-align: center; }
  .tire-visual svg { width: 100%; max-width: 120px; height: auto; margin: 0 auto; }
  .tire-visual-label { font-size: 0.82rem; font-weight: 600; color: var(--color-text); margin-top: 8px; }
  .tire-visual-dims { font-size: 0.75rem; color: var(--color-text-secondary); }
</style>
