---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['paint-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Paint Coverage: How Much Paint You Need & Free Calculator",
    "description": "Learn how paint coverage works, how much a gallon covers, and calculate exactly how much paint you need for any room. Avoid buying too much or too little.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2025-01-01",
    "dateModified": "2025-01-01",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Paint Needed",
    "description": "Calculate how much paint you need for any room based on wall dimensions.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your room length, width, and wall height" },
      { "@type": "HowToStep", "text": "Enter the number of doors and windows" },
      { "@type": "HowToStep", "text": "Select the number of coats" },
      { "@type": "HowToStep", "text": "Click Calculate to see how much paint you need" },
    ],
  },
];
---

<ToolLayout title="Paint Coverage: How Much Paint You Need & Free Calculator — FreeOnlineToolkit" description="Learn how paint coverage works and calculate exactly how much paint you need for any room." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Paint Coverage: How Much Paint You Need & Free Calculator</h1></fragment>
  <fragment slot="intro">
    <div class="key-takeaways">
      <h2>Key Takeaways</h2>
      <ul>
        <li>One gallon of paint covers approximately <strong>350 square feet</strong> on smooth, previously painted walls — less on textured or porous surfaces</li>
        <li>Most rooms need <strong>2 coats</strong> for even coverage, especially when changing colors or covering dark walls with lighter paint</li>
        <li>Always subtract the area of <strong>doors (~21 sq ft each) and windows (~15 sq ft each)</strong> from your total wall area</li>
        <li>Buy <strong>10% extra</strong> beyond your calculation to account for waste, touch-ups, and future repairs</li>
        <li>Higher-quality paints often cover better in <strong>fewer coats</strong>, potentially saving money despite the higher price per gallon</li>
      </ul>
    </div>

    <p>One of the most common DIY home improvement projects is painting a room. It's affordable, transformative, and achievable in a weekend. But one of the biggest mistakes DIY painters make is buying the wrong amount of paint. Too little means an extra trip to the store mid-project (and the new batch might not match exactly). Too much means wasted money and half-used cans cluttering your garage. Getting the quantity right starts with understanding paint coverage and accurately measuring your walls.</p>

    <p>Paint coverage refers to how much surface area a gallon of paint can cover. For standard interior latex paint on smooth, previously painted walls, the industry standard is <strong>350 square feet per gallon</strong>. However, this number varies significantly based on several factors. <strong>Texture matters enormously</strong> — rough stucco or heavily textured walls can reduce coverage by 20-40% because the paint fills in the crevices. <strong>Porous surfaces</strong> like new drywall or bare wood absorb more paint, also reducing coverage. <strong>Color changes</strong> affect how many coats you need: going from dark to light (or vice versa) typically requires a primer coat plus two finish coats.</p>

    <p>To calculate how much paint you need, measure the <strong>perimeter of your room</strong> (add up all four wall lengths), multiply by the <strong>wall height</strong> to get total wall area, then subtract the area of doors and windows. A standard interior door is about 21 square feet (3' × 7'), and a standard window is about 15 square feet (3' × 5'). Divide the net wall area by 350 (the coverage per gallon), then multiply by the number of coats. Round up to the nearest quart or gallon.</p>

    <p>Don't forget about <strong>ceilings</strong> — if you're painting those too, add the floor area (length × width) to your calculation. Ceilings typically need 1-2 gallons for an average room. <strong>Primer</strong> is a separate calculation; if your walls are bare drywall, stained, or you're making a drastic color change, plan for one coat of primer before your finish coats. The calculator below handles the wall calculation for you, giving you a precise estimate in gallons and quarts.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Paint &amp; Wall Square Footage Calculator</h2>

      <div class="form-row">
        <div class="form-group">
          <label for="wallLength">Room Length (ft)</label>
          <input type="number" id="wallLength" value="12" min="1" step="0.5">
        </div>
        <div class="form-group">
          <label for="wallWidth">Room Width (ft)</label>
          <input type="number" id="wallWidth" value="10" min="1" step="0.5">
        </div>
      </div>

      <div class="form-group">
        <label for="wallHeight">Wall Height (ft)</label>
        <input type="number" id="wallHeight" value="8" min="1" step="0.5">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="doorCount">Number of Doors</label>
          <input type="number" id="doorCount" value="1" min="0" step="1">
        </div>
        <div class="form-group">
          <label for="windowCount">Number of Windows</label>
          <input type="number" id="windowCount" value="2" min="0" step="1">
        </div>
      </div>

      <div class="form-group">
        <label for="coats">Number of Coats</label>
        <select id="coats">
          <option value="1">1 coat (touch-up)</option>
          <option value="2" selected>2 coats (recommended)</option>
          <option value="3">3 coats (drastic color change)</option>
        </select>
      </div>

      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="paintResult">
        <div class="result-value" id="paintResultValue">0</div>
        <div class="result-label" id="paintResultLabel">Paint needed</div>
        <div class="result-details" id="paintResultDetails"></div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This paint calculator tells you <strong>exactly how much paint to buy</strong> for your room, expressed in gallons and quarts. It shows the breakdown: gross wall area, area subtracted for doors and windows, net paintable area per coat, and total area including multiple coats. Use this to walk into the paint store knowing exactly what you need.</p>
    </div>

    <div class="content-section">
      <h2>How to Use the Paint Calculator</h2>
      <p>Measure your room's length, width, and wall height. Enter the number of doors and windows to subtract their area. Select how many coats you plan to apply.</p>
      <ul>
        <li><strong>Standard door:</strong> ~21 sq ft (3' x 7')</li>
        <li><strong>Standard window:</strong> ~15 sq ft (3' x 5')</li>
        <li><strong>Paint coverage:</strong> 1 gallon covers ~350 sq ft</li>
      </ul>
    </div>

    <div class="content-section">
      <h2>Paint Coverage Formula</h2>
      <div class="formula-box">Total Area = Perimeter &times; Wall Height<br>Paint Needed = (Total Area - Doors &amp; Windows) &divide; 350 &times; Coats</div>
    </div>

    <div class="content-section">
      <h2>Next Steps</h2>
      <ul>
        <li><strong>Measure twice, buy once</strong> — double-check your room measurements before heading to the paint store</li>
        <li><strong>Buy all paint from the same batch</strong> — color can vary slightly between production runs, so buy all gallons at once</li>
        <li><strong>Keep leftover paint</strong> sealed tightly for future touch-ups — label the can with the room and date</li>
        <li><strong>Use painter's tape</strong> for clean edges and drop cloths to protect floors — preparation is 80% of a good paint job</li>
        <li><strong>Consider paint quality</strong> — premium paints ($40-60/gallon) often cover in one coat, saving time and potentially money</li>
      </ul>
    </div>

    <FAQ items={[
      { question: "How much paint do I need for one wall?", answer: "Measure the wall's width and height, multiply them for square footage, then divide by 350. For a 12' x 8' wall with one coat: 96 &divide; 350 = 0.27 gallons (about 1 quart)." },
      { question: "Should I include ceiling paint?", answer: "This calculator estimates wall paint only. Ceilings typically take 1-2 gallons depending on room size." },
      { question: "How much extra should I buy?", answer: "Buy 10% extra for waste, touch-ups, and future repairs. If the calculator says 1.2 gallons, buy 1 gallon and 1 quart." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="paint-calculator" category="home-construction" />
  </fragment>
</ToolLayout>

<script>
import { showResult, hideResult } from '../utils/calculator-utils';

function calcPaint() {
  const length = parseFloat((document.getElementById('wallLength') as HTMLInputElement).value);
  const width = parseFloat((document.getElementById('wallWidth') as HTMLInputElement).value);
  const height = parseFloat((document.getElementById('wallHeight') as HTMLInputElement).value);
  const doors = parseInt((document.getElementById('doorCount') as HTMLInputElement).value) || 0;
  const windows = parseInt((document.getElementById('windowCount') as HTMLInputElement).value) || 0;
  const coats = parseInt((document.getElementById('coats') as HTMLSelectElement).value);

  if (isNaN(length) || isNaN(width) || isNaN(height) || length <= 0 || width <= 0 || height <= 0) return;

  const perimeter = 2 * (length + width);
  const grossArea = perimeter * height;
  const doorArea = doors * 21;
  const windowArea = windows * 15;
  const netArea = Math.max(0, grossArea - doorArea - windowArea);
  const totalArea = netArea * coats;
  const gallons = totalArea / 350;
  const gallonsRounded = Math.ceil(gallons * 4) / 4;

  const display = gallonsRounded >= 1
    ? Math.floor(gallonsRounded) + (gallonsRounded % 1 >= 0.25 ? ' gal ' + Math.round((gallonsRounded % 1) * 4) + ' qt' : ' gal')
    : Math.round(gallonsRounded * 4) + ' qt';

  document.getElementById('paintResultValue')!.textContent = display;
  document.getElementById('paintResultLabel')!.textContent = 'Paint needed (' + coats + ' coat' + (coats > 1 ? 's' : '') + ')';
  (document.getElementById('paintResultDetails') as HTMLElement).innerHTML =
    '<div><span class="label">Wall area</span><span class="value">' + grossArea.toFixed(0) + ' sq ft</span></div>' +
    '<div><span class="label">Minus doors</span><span class="value">-' + doorArea.toFixed(0) + ' sq ft</span></div>' +
    '<div><span class="label">Minus windows</span><span class="value">-' + windowArea.toFixed(0) + ' sq ft</span></div>' +
    '<div><span class="label">Net area per coat</span><span class="value">' + netArea.toFixed(0) + ' sq ft</span></div>' +
    '<div><span class="label">Total with coats</span><span class="value">' + totalArea.toFixed(0) + ' sq ft</span></div>';
  showResult('paintResult');
}

function resetPaint() {
  (document.getElementById('wallLength') as HTMLInputElement).value = '12';
  (document.getElementById('wallWidth') as HTMLInputElement).value = '10';
  (document.getElementById('wallHeight') as HTMLInputElement).value = '8';
  (document.getElementById('doorCount') as HTMLInputElement).value = '1';
  (document.getElementById('windowCount') as HTMLInputElement).value = '2';
  (document.getElementById('coats') as HTMLSelectElement).value = '2';
  hideResult('paintResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcPaint);
document.getElementById('resetBtn')!.addEventListener('click', resetPaint);
document.addEventListener('DOMContentLoaded', calcPaint);
</script>
