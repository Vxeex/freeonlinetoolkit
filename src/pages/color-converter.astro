        </div>
        <div class="slider-group">
          <label>Green <span id="greenValue">102</span></label>
          <input type="range" id="greenSlider" min="0" max="255" value="102" style="background:linear-gradient(to right,#000,#0f0);">
        </div>
        <div class="slider-group">
          <label>Blue <span id="blueValue">241</span></label>
          <input type="range" id="blueSlider" min="0" max="255" value="241" style="background:linear-gradient(to right,#000,#00f);">
