  border: 1px solid var(--color-border-light);
}
.color-value-row .label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-text-muted);
  min-width: 42px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.color-value-row .value {
  flex: 1;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.9rem;
  color: var(--color-text);
}
.color-value-row .copy-btn {
  background: none;
  border: 1px solid var(--color-border-light);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 0.75rem;
  cursor: pointer;
  color: var(--color-text-muted);
  transition: all 0.2s;
}
.color-value-row .copy-btn:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-bg);
}
.color-sliders { margin-top: 20px; }
.slider-group { margin-bottom: 14px; }
.slider-group label {
  display: flex;
  justify-content: space-between;
  font-size: 0.82rem;
  font-weight: 600;
  margin-bottom: 4px;
}
.slider-group label span { font-family: 'JetBrains Mono', monospace; font-weight: 400; color: var(--color-text-secondary); }
.slider-group input[type="range"] {
  width: 100%;
  height: 6px;
  -webkit-appearance: none;
  appearance: none;
  border-radius: 3px;
  outline: none;
  cursor: pointer;
}
.slider-group input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: white;
  border: 2px solid var(--color-border);
  cursor: pointer;
  box-shadow: 0 1px 4px rgba(0,0,0,0.1);
}
.slider-group input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: white;
  border: 2px solid var(--color-border);
  cursor: pointer;
}
.color-history {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 12px;
}
.color-swatch {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  border: 1px solid var(--color-border-light);
  cursor: pointer;
  transition: transform 0.15s;
}
.color-swatch:hover { transform: scale(1.15); }
</style>