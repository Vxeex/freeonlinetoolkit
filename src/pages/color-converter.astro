<script>
import { showResult, hideResult } from '../utils/calculator-utils';

var colorHistory: string[] = [];

function hexToRgb(hex: string): { r: number; g: number; b: number } | null {
  var result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? {
    r: parseInt(result[1], 16),
    g: parseInt(result[2], 16),
    b: parseInt(result[3], 16)
  } : null;
}

function rgbToHsl(r: number, g: number, b: number): { h: number; s: number; l: number } {
  r /= 255; g /= 255; b /= 255;
  var max = Math.max(r, g, b), min = Math.min(r, g, b);
  var h = 0, s = 0, l = (max + min) / 2;
  if (max !== min) {
    var d = max - min;
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = ((g - b) / d + (g < b ? 6 : 0)) / 6; break;
      case g: h = ((b - r) / d + 2) / 6; break;
      case b: h = ((r - g) / d + 4) / 6; break;
    }
  }
  return {
    h: Math.round(h * 360),
    s: Math.round(s * 100),
    l: Math.round(l * 100)
  };
}

function rgbToHex(r: number, g: number, b: number): string {
  return '#' + [r, g, b].map(function(x) {
    var hex = Math.round(x).toString(16);
    return hex.length === 1 ? '0' + hex : hex;
  }).join('');
}

function updateDisplay(hex: string): void {
  var preview = document.getElementById('colorPreview') as HTMLElement;
  var picker = document.getElementById('colorPicker') as HTMLInputElement;
  var hexInput = document.getElementById('hexInput') as HTMLInputElement;
  var hexDisplay = document.getElementById('hexDisplay') as HTMLElement;
  var rgbDisplay = document.getElementById('rgbDisplay') as HTMLElement;
  var hslDisplay = document.getElementById('hslDisplay') as HTMLElement;

  preview.style.background = hex;
  picker.value = hex;
  hexInput.value = hex;
  hexDisplay.textContent = hex;

  var rgb = hexToRgb(hex);
  if (!rgb) return;

  rgbDisplay.textContent = 'rgb(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ')';

  var hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
  hslDisplay.textContent = 'hsl(' + hsl.h + ', ' + hsl.s + '%, ' + hsl.l + '%)';

  (document.getElementById('redSlider') as HTMLInputElement).value = rgb.r;
  (document.getElementById('greenSlider') as HTMLInputElement).value = rgb.g;
  (document.getElementById('blueSlider') as HTMLInputElement).value = rgb.b;
  document.getElementById('redValue')!.textContent = rgb.r.toString();
  document.getElementById('greenValue')!.textContent = rgb.g.toString();
  document.getElementById('blueValue')!.textContent = rgb.b.toString();
}

function applyHex(): void {
  var input = (document.getElementById('hexInput') as HTMLInputElement).value.trim();
  if (input.charAt(0) !== '#') input = '#' + input;
  if (/^#[a-f\d]{6}$/i.test(input)) {
    updateDisplay(input);
    addToHistory(input);
  }
}

function updateFromSliders(): void {
  var r = parseInt((document.getElementById('redSlider') as HTMLInputElement).value);
  var g = parseInt((document.getElementById('greenSlider') as HTMLInputElement).value);
  var b = parseInt((document.getElementById('blueSlider') as HTMLInputElement).value);
  var hex = rgbToHex(r, g, b);
  updateDisplay(hex);
  addToHistory(hex);
}

function copyText(id: string, btn: HTMLElement): void {
  var text = document.getElementById(id)!.textContent || '';
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(function() {
      btn.textContent = 'Copied!';
      setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
    });
  }
}

function addToHistory(hex: string): void {
  if (colorHistory.indexOf(hex) > -1) return;
  colorHistory.unshift(hex);
  if (colorHistory.length > 12) colorHistory.pop();
  renderHistory();
}

function renderHistory(): void {
  var container = document.getElementById('colorHistory') as HTMLElement;
  container.innerHTML = '';
  colorHistory.forEach(function(hex) {
    var swatch = document.createElement('div');
    swatch.className = 'color-swatch';
    swatch.style.background = hex;
    swatch.title = hex;
    swatch.addEventListener('click', function() { updateDisplay(hex); });
    container.appendChild(swatch);
  });
}

document.getElementById('applyHexBtn')!.addEventListener('click', applyHex);
document.getElementById('hexInput')!.addEventListener('keydown', function(e: KeyboardEvent) {
  if (e.key === 'Enter') applyHex();
});
document.getElementById('colorPicker')!.addEventListener('input', function() {
  var hex = (this as HTMLInputElement).value;
  updateDisplay(hex);
  addToHistory(hex);
});
document.getElementById('redSlider')!.addEventListener('input', updateFromSliders);
document.getElementById('greenSlider')!.addEventListener('input', updateFromSliders);
document.getElementById('blueSlider')!.addEventListener('input', updateFromSliders);
document.getElementById('copyHex')!.addEventListener('click', function(e) { copyText('hexDisplay', e.currentTarget as HTMLElement); });
document.getElementById('copyRgb')!.addEventListener('click', function(e) { copyText('rgbDisplay', e.currentTarget as HTMLElement); });
document.getElementById('copyHsl')!.addEventListener('click', function(e) { copyText('hslDisplay', e.currentTarget as HTMLElement); });

document.addEventListener('DOMContentLoaded', function() {
  addToHistory('#6366f1');
});
</script>

<style>
.color-preview-large {
  width: 100%;
  height: 160px;
  border-radius: var(--radius-md);
  border: 2px solid var(--color-border);
  margin-bottom: 20px;
  transition: background 0.15s ease;
}
.color-input-row {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 16px;
}
.color-input-row input[type="color"] {
  width: 64px;
  height: 48px;
  padding: 0;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  background: none;
}
.color-input-row input[type="text"] {
  flex: 1;
  padding: 12px 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
