---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['mortgage-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Mortgage Payments",
    "description": "Calculate your monthly mortgage payment using loan amount, interest rate, and term.",
    "step": [
      { "@type": "HowToStep", "text": "Enter the total loan amount you wish to borrow" },
      { "@type": "HowToStep", "text": "Input the annual interest rate as a percentage" },
      { "@type": "HowToStep", "text": "Select the loan term in years" },
      { "@type": "HowToStep", "text": "Click Calculate to see your monthly payment and amortization details" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is a good interest rate for a mortgage?", "acceptedAnswer": { "@type": "Answer", "text": "Mortgage rates vary based on market conditions, your credit score, and loan type. Compare rates from multiple lenders to find the best deal for your situation." } },
      { "@type": "Question", "name": "Does this calculator include property taxes and insurance?", "acceptedAnswer": { "@type": "Answer", "text": "This calculator shows principal and interest only. Your actual monthly payment may also include property taxes, homeowner's insurance, and PMI if your down payment is less than 20%." } },
      { "@type": "Question", "name": "Should I choose a 15-year or 30-year mortgage?", "acceptedAnswer": { "@type": "Answer", "text": "A 15-year mortgage has higher monthly payments but much less total interest. A 30-year mortgage has lower monthly payments but costs more in interest over time. Choose based on your budget and financial goals." } },
    ],
  },
];
---

<ToolLayout title={`${tool.title} - FreeOnlineToolkit`} description={tool.description} breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Free {tool.title}</h1></fragment>
  <fragment slot="intro">
    <p class="tool-intro">Calculate your monthly mortgage payments instantly. Shows total payment including principal and interest, with full amortization details for any loan term.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Mortgage Calculator</h2>
      <div class="form-group">
        <label for="loanAmount">Loan Amount</label>
        <div class="input-wrap">
          <span class="prefix">$</span>
          <input type="number" id="loanAmount" class="prefixed" value="300000" min="0" step="1000">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="interestRate">Annual Interest Rate (%)</label>
          <input type="number" id="interestRate" value="6.5" min="0" step="0.1">
        </div>
        <div class="form-group">
          <label for="loanTerm">Loan Term (Years)</label>
          <input type="number" id="loanTerm" value="30" min="1" max="50">
        </div>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn">Reset</button>
      </div>

      <div class="result-box" id="mortgageResult">
        <div class="result-value" id="monthlyPayment">$0.00</div>
        <div class="result-label">Monthly Payment (Principal & Interest)</div>
        <div class="result-details">
          <div><span class="label">Total Payment (over term)</span><span class="value" id="totalPayment">$0</span></div>
          <div><span class="label">Total Interest</span><span class="value" id="totalInterest">$0</span></div>
          <div><span class="label">Number of Payments</span><span class="value" id="numPayments">0</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>How to Use the Mortgage Calculator</h2>
      <p>Enter the total <strong>loan amount</strong> you plan to borrow — the purchase price minus your down payment. Input the <strong>annual interest rate</strong> your lender has quoted. Then choose your <strong>loan term</strong> in years — typically 15, 20, or 30 years.</p>
      <p>Click "Calculate" to see your <strong>monthly payment</strong> (principal and interest), the total amount over the full term, and total interest paid.</p>
      <p>Try adjusting the rate or term to see how small changes affect your payment. A lower rate or shorter term saves on total interest.</p>
    </div>

    <div class="content-section">
      <h2>Mortgage Payment Formula</h2>
      <div class="formula-box">M = P × [r(1+r)^n] / [(1+r)^n − 1]</div>
      <p>Where: <strong>M</strong> = monthly payment, <strong>P</strong> = loan principal, <strong>r</strong> = monthly interest rate (annual rate / 12), <strong>n</strong> = total number of monthly payments (term × 12).</p>
    </div>

    <div class="content-section">
      <h2 style="display:flex;align-items:center;gap:8px;"><i class="fa-solid fa-chart-line" style="color:var(--color-primary);"></i> Financial Calculators</h2>
      <p>These tools help you plan your home buying and loan strategy:</p>
      <div class="health-grid">
        <div class="health-card">
          <strong><a href="/home-loan-prepayment-calculator/">Home Loan Prepayment Calculator</a></strong>
          <p>See how extra payments save interest and shorten your loan term.</p>
        </div>
        <div class="health-card">
          <strong><a href="/compound-interest-calculator/">Compound Interest Calculator</a></strong>
          <p>See how your investments grow over time with compound interest.</p>
        </div>
        <div class="health-card">
          <strong><a href="/home-affordability-calculator/">Home Affordability Calculator</a></strong>
          <p>Find out how much house you can afford based on your income.</p>
        </div>
      </div>
    </div>

    <FAQ items={[
      { question: "What is a good interest rate for a mortgage?", answer: "Mortgage rates vary based on market conditions, your credit score, and loan type. Compare rates from multiple lenders to find the best deal for your situation." },
      { question: "Does this calculator include property taxes and insurance?", answer: "This calculator shows principal and interest only. Your actual monthly payment may also include property taxes, homeowner's insurance, and PMI if your down payment is less than 20%." },
      { question: "Should I choose a 15-year or 30-year mortgage?", answer: "A 15-year mortgage has higher monthly payments but much less total interest. A 30-year mortgage has lower monthly payments but costs more in interest over time. Choose based on your budget and financial goals." },
      { question: "How much can I borrow for a mortgage?", answer: "Most lenders approve mortgages where the monthly payment is no more than 28-31% of your gross monthly income. Your credit score, debt-to-income ratio, and down payment also affect how much you can borrow." },
    ]} />
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="mortgage-calculator" category="financial" />
  </fragment>
</ToolLayout>

<script>
import { getNum, formatCurrency, showResult, hideResult } from '../utils/calculator-utils';

function calcMortgage() {
  const P = getNum('loanAmount');
  const annualRate = getNum('interestRate');
  const years = getNum('loanTerm');
  if (!P || !annualRate || !years) return;

  const r = annualRate / 100 / 12;
  const n = years * 12;
  const M = P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);

  (document.getElementById('monthlyPayment') as HTMLElement).textContent = formatCurrency(M);
  (document.getElementById('totalPayment') as HTMLElement).textContent = formatCurrency(M * n);
  (document.getElementById('totalInterest') as HTMLElement).textContent = formatCurrency(M * n - P);
  (document.getElementById('numPayments') as HTMLElement).textContent = String(n);
  showResult('mortgageResult');
}

function resetMortgage() {
  (document.getElementById('loanAmount') as HTMLInputElement).value = '300000';
  (document.getElementById('interestRate') as HTMLInputElement).value = '6.5';
  (document.getElementById('loanTerm') as HTMLInputElement).value = '30';
  hideResult('mortgageResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcMortgage);
document.getElementById('resetBtn')!.addEventListener('click', resetMortgage);
document.addEventListener('DOMContentLoaded', calcMortgage);
</script>
