      </tr>
    </thead>
    <tbody>
      <tr><td style="padding:8px;border:1px solid #e2e8f0;">Priority order</td><td style="padding:8px;text-align:center;border:1px solid #e2e8f0;">Highest interest rate</td><td style="padding:8px;text-align:center;border:1px solid #e2e8f0;">Smallest balance</td></tr>
      <tr style="background:#f8fafc;"><td style="padding:8px;border:1px solid #e2e8f0;">Total interest paid</td><td style="padding:8px;text-align:center;border:1px solid #e2e8f0;color:#166534;font-weight:bold;">Lowest</td><td style="padding:8px;text-align:center;border:1px solid #e2e8f0;">Higher</td></tr>
