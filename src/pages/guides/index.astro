---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { guides } from '../../data/guides';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Guides' }];

const pageTitle = `Guides & Resources (${guides.length} Articles) | FreeOnlineToolkit`;
const pageDesc = `Browse our collection of ${guides.length} in-depth guides covering mortgage calculators, BMI and health, compound interest, car loans, savings goals, and more.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Header />
  <div class="tool-page">
    <Breadcrumb items={breadcrumbItems} />
    <h1>Guides & Resources</h1>
    <p class="tool-intro">Learn how to use our calculators effectively and understand the concepts behind them. Our guides break down complex topics into simple, actionable advice.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">
      {guides.map(g => (
        <a href={`/guides/${g.slug}/`} class="guide-card">
          <span class="guide-card-icon" style={`background:${g.color}18;color:${g.color};`}>
            <i class={`fa-solid ${g.icon}`}></i>
          </span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
  <Footer />
</BaseLayout>
