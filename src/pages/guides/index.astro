---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { guides } from '../../data/guides';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Guides' }];

const pageTitle = `Guides & Resources (${guides.length} Articles) | FreeOnlineToolkit`;
const pageDesc = `Browse our collection of ${guides.length} in-depth guides covering mortgage calculators, BMI and health, compound interest, car loans, savings goals, and more.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <main>
  <div class="tool-page">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="animate-in">Guides & Resources</h1>
    <p class="tool-intro animate-in animate-in-delay-1">Learn how to use our calculators effectively and understand the concepts behind them. Our guides break down complex topics into simple, actionable advice.</p>
    <div class="guides-grid">
      {guides.map((g, i) => (
        <a href={`/guides/${g.slug}/`} class="guide-card animate-in" style={`transition-delay:${(i % 12) * 0.06}s;`}>
          <span class="guide-card-icon" style={`background:${g.color}18;color:${g.color};`}>
            <i class={`fa-solid ${g.icon}`}></i>
          </span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
  </main>
  <script>
    import { initScrollAnimations } from '../../utils/scroll-animations';
    initScrollAnimations();
  </script>
</BaseLayout>
