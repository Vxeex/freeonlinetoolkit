---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { guides } from '../../data/guides';

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Guides' }];
const pageTitle = 'Guides & Resources | FreeOnlineToolkit';
const pageDesc = 'Learn how to use our calculators effectively with detailed guides on mortgage, BMI, compound interest, password security, and more.';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Header />
  <div class="tool-page">
    <Breadcrumb items={breadcrumbItems} />
    <h1>Guides & Resources</h1>
    <p class="tool-intro">Learn how to use our calculators effectively and understand the concepts behind them. Our guides break down complex topics into simple, actionable advice.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">
      {guides.map(g => (
        <a href={`/guides/${g.slug}/`} style="display:flex;align-items:flex-start;gap:16px;padding:24px;background:var(--color-surface);border:1px solid var(--color-border-light);border-radius:var(--radius-lg);text-decoration:none;color:inherit;transition:all var(--duration-normal) var(--ease-out);"
          onMouseOver="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-2px)';this.style.borderColor='var(--color-primary)';"
          onMouseOut="this.style.boxShadow='';this.style.transform='';this.style.borderColor='';">
          <span style={`width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;background:${g.color}14;color:${g.color};`}>
            <i class={`fa-solid ${g.icon}`}></i>
          </span>
          <div>
            <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:600;color:var(--color-text);margin-bottom:6px;">{g.title}</h3>
            <p style="font-size:0.85rem;color:var(--color-text-secondary);line-height:1.6;">{g.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
  <Footer />
</BaseLayout>
