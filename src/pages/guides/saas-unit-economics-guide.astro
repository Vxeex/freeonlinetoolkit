        <th>B2B Enterprise SaaS</th>
        <th>B2C SaaS</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>Unhealthy</td><td>Below 2:1</td><td>Below 2:1</td><td>Below 1.5:1</td></tr>
      <tr><td>Adequate</td><td>2:1 to 3:1</td><td>2:1 to 3:1</td><td>1.5:1 to 2.5:1</td></tr>
      <tr><td>Good</td><td>3:1 to 5:1</td><td>3:1 to 5:1</td><td>2.5:1 to 4:1</td></tr>
      <tr><td>Excellent</td><td>5:1 to 8:1</td><td>5:1 to 10:1</td><td>4:1 to 7:1</td></tr>
