const tool = toolBySlug['property-tax-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Property Tax: Rates, Deductions & Free Calculator",
    "description": "Understand how property taxes work, compare rates by state, learn about deductions, and estimate your annual tax bill. Free property tax calculator with multi-year projections.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/property-tax-calculator/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Estimate Property Taxes",
    "description": "Estimate annual property taxes based on your home value and local tax rate, with multi-year projections.",
    "step": [
      { "@type": "HowToStep", "text": "Enter your home's current market value" },
      { "@type": "HowToStep", "text": "Input your local property tax rate or select a state with preset rates" },
