---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['body-fat-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Body Fat Percentage: What It Means & Free Calculator",
    "description": "Understand body fat percentage, how it differs from BMI, and what healthy ranges look like for men and women. Free body fat calculator using the U.S. Navy method.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/body-fat-calculator/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Body Fat Percentage",
    "description": "Calculate your body fat percentage using circumference measurements.",
    "step": [
      { "@type": "HowToStep", "text": "Select your gender" },
      { "@type": "HowToStep", "text": "Enter your height" },
      { "@type": "HowToStep", "text": "Enter your neck and waist (and hip for women) measurements" },
      { "@type": "HowToStep", "text": "Click Calculate to see your body fat percentage" },
    ],
  }
];
---

<ToolLayout title="Body Fat Percentage: What It Means & Free Calculator | FreeOnlineToolkit" description="Understand body fat percentage, how it differs from BMI, and what healthy ranges look like for men and women. Free body fat calculator using the U.S. Navy method." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Body Fat Percentage: What It Means & Free Calculator</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>Body fat percentage is a more accurate health metric than BMI because it distinguishes between fat mass and lean mass (muscle, bone, organs).</li>
      <li>The U.S. Navy circumference method provides estimates within 3–4% of hydrostatic weighing — accurate enough for most people's needs.</li>
      <li>Healthy body fat ranges differ significantly between men (10–20%) and women (18–28%) due to essential biological differences.</li>
      <li>Essential fat is the minimum your body needs to function — dropping below 2–5% for men or 10–13% for women is dangerous and unsustainable.</li>
      <li>Body fat percentage is more useful for tracking fitness progress than scale weight alone, since muscle gain can offset fat loss on the scale.</li>
    </ul>
  </div>

  <p>Body weight alone tells you very little about your health. A muscular athlete and a sedentary person of the same height and weight can have dramatically different body compositions — and dramatically different health outcomes. That's where <strong>body fat percentage</strong> comes in. It measures how much of your total weight is fat tissue versus lean mass (muscle, bone, organs, and water), giving you a far more meaningful picture of your fitness level.</p>

  <p>The <strong>U.S. Navy circumference method</strong>, used by this calculator, is one of the most practical body fat estimation techniques available. Developed by the U.S. military, it requires only a flexible tape measure and a few simple measurements: neck circumference, waist circumference, and hip circumference (for women). It's not as precise as a DEXA scan or hydrostatic weighing, but it's remarkably close — typically within 3–4% — and far more accessible for everyday use.</p>

  <p>Understanding your body fat category helps you set realistic fitness goals. <strong>Essential fat</strong> (2–5% for men, 10–13% for women) is the minimum your body needs for basic physiological functions like hormone production, vitamin absorption, and organ protection. <strong>Athletic ranges</strong> (6–13% men, 14–20% women) are typical for competitive athletes. <strong>Fitness ranges</strong> (14–17% men, 21–24% women) indicate a healthy, active lifestyle. The <strong>average range</strong> (18–24% men, 25–31% women) is where most people fall. Above these ranges enters the obese category, associated with increased health risks.</p>

  <p>One of the biggest advantages of tracking body fat percentage over BMI is that BMI can't distinguish between fat and muscle. A bodybuilder with 8% body fat might register as "obese" on the BMI scale because of their muscle mass. Body fat percentage gives you the real story. It's also a better indicator of progress during a fitness programme — you might gain 2kg of muscle and lose 2kg of fat, showing zero change on the scale but a meaningful improvement in body composition.</p>

  <fragment slot="intro">
    <p class="tool-intro">Estimate your body fat percentage using the proven U.S. Navy circumference method. Just take a few simple measurements with a tape measure — no special equipment needed.</p>
  </fragment>

  <fragment slot="calculator">
    <div class="calc-card">
      <h2>Body Fat Calculator</h2>

      <div class="form-group">
        <label for="bfGender">Gender</label>
        <select id="bfGender">
          <option value="male">Male</option>
          <option value="female">Female</option>
        </select>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="bfHeight">Height</label>
          <input type="number" id="bfHeight" value="175" min="100" max="250" step="0.5">
          <div style="font-size:0.78rem;color:var(--color-text-muted);margin-top:4px;">cm</div>
        </div>
        <div class="form-group">
          <label for="bfNeck">Neck circumference</label>
          <input type="number" id="bfNeck" value="38" min="20" max="60" step="0.5">
          <div style="font-size:0.78rem;color:var(--color-text-muted);margin-top:4px;">cm — measure just below the larynx</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="bfWaist">Waist circumference</label>
          <input type="number" id="bfWaist" value="85" min="50" max="180" step="0.5">
          <div style="font-size:0.78rem;color:var(--color-text-muted);margin-top:4px;">cm — at navel level</div>
        </div>
        <div class="form-group" id="bfHipGroup">
          <label for="bfHip">Hip circumference</label>
          <input type="number" id="bfHip" value="95" min="50" max="180" step="0.5">
          <div style="font-size:0.78rem;color:var(--color-text-muted);margin-top:4px;">cm — at widest point (women only)</div>
        </div>
      </div>

      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="bfResult">
        <div class="result-value" id="bfPercentage">0.0%</div>
        <div class="result-label">Estimated Body Fat</div>
        <div class="result-details">
          <div><span class="label">Category</span><span class="value" id="bfCategory">—</span></div>
          <div><span class="label">Body Fat Mass</span><span class="value" id="bfMass">—</span></div>
          <div><span class="label">Lean Body Mass</span><span class="value" id="leanMass">—</span></div>
          <div><span class="label">Method</span><span class="value">U.S. Navy Circumference</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>Select your gender, then enter your measurements. Measure your <strong>neck</strong> just below the larynx, your <strong>waist</strong> at navel level, and your <strong>hips</strong> at the widest point (women only). Use a flexible tape measure and keep it snug but not tight.</p>
      <p>This calculator uses the <strong>U.S. Navy circumference method</strong>, with accuracy of about 3-4% compared to hydrostatic weighing. It also estimates your fat mass and lean body mass based on a healthy reference weight.</p>
    </div>

    <div class="content-section">
      <h2>Body Fat Categories</h2>
      <table class="comparison-table">
        <thead>
          <tr><th>Category</th><th>Men (% body fat)</th><th>Women (% body fat)</th></tr>
        </thead>
        <tbody>
          <tr><td>Essential Fat</td><td>2-5%</td><td>10-13%</td></tr>
          <tr><td>Athletes</td><td>6-13%</td><td>14-20%</td></tr>
          <tr><td>Fitness</td><td>14-17%</td><td>21-24%</td></tr>
          <tr><td>Average</td><td>18-24%</td><td>25-31%</td></tr>
          <tr><td>Obese</td><td>25% +</td><td>32% +</td></tr>
        </tbody>
      </table>
    </div>

    <FAQ items={[
      { question: "How accurate is the U.S. Navy method?", answer: "The U.S. Navy method has a margin of error of about 2-3% compared to hydrostatic weighing. It's more accurate than BMI for assessing body composition and is widely used by military and fitness professionals." },
      { question: "What is the difference between body fat % and BMI?", answer: "BMI uses only height and weight, so it can misclassify muscular people as overweight. Body fat percentage directly measures how much of your weight is fat vs. lean mass, giving a more accurate picture of your fitness level." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Measure your body fat percentage every 4–6 weeks to track trends rather than obsessing over single readings. Pair body composition tracking with our <a href="/bmi-calculator/">BMI Calculator</a> for a broader health picture, and our <a href="/ideal-weight-calculator/">Ideal Weight Calculator</a> to set realistic weight targets based on your height and frame. For the most accurate results, measure at the same time of day and under similar conditions each time.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="body-fat-calculator" category="health-wellness" />
  </fragment>
</ToolLayout>

<script>
import { showResult, hideResult } from '../utils/calculator-utils';

function toggleBFGender() {
  const gender = (document.getElementById('bfGender') as HTMLSelectElement).value;
  (document.getElementById('bfHipGroup') as HTMLElement).style.display = gender === 'female' ? '' : 'none';
}

function calcBodyFat() {
  const gender = (document.getElementById('bfGender') as HTMLSelectElement).value;
  const height = parseFloat((document.getElementById('bfHeight') as HTMLInputElement).value);
  const neck = parseFloat((document.getElementById('bfNeck') as HTMLInputElement).value);
  const waist = parseFloat((document.getElementById('bfWaist') as HTMLInputElement).value);
  const hip = gender === 'female' ? parseFloat((document.getElementById('bfHip') as HTMLInputElement).value) : 0;

  if (!height || !neck || !waist) return;
  if (gender === 'female' && !hip) return;

  let bf: number;
  if (gender === 'male') {
    bf = 86.010 * Math.log10(waist - neck) - 70.041 * Math.log10(height) + 36.76;
  } else {
    bf = 163.205 * Math.log10(waist + hip - neck) - 97.684 * Math.log10(height) - 78.387;
  }

  bf = Math.max(2, Math.min(bf, 70));
  document.getElementById('bfPercentage')!.textContent = bf.toFixed(1) + '%';

  let category = '';
  if (gender === 'male') {
    if (bf < 6) category = 'Essential Fat (2-5%)';
    else if (bf < 14) category = 'Athletes (6-13%)';
    else if (bf < 18) category = 'Fitness (14-17%)';
    else if (bf < 25) category = 'Average (18-24%)';
    else category = 'Obese (25%+)';
  } else {
    if (bf < 14) category = 'Essential Fat (10-13%)';
    else if (bf < 21) category = 'Athletes (14-20%)';
    else if (bf < 25) category = 'Fitness (21-24%)';
    else if (bf < 32) category = 'Average (25-31%)';
    else category = 'Obese (32%+)';
  }
  document.getElementById('bfCategory')!.textContent = category;

  const estWeight = 22 * Math.pow(height / 100, 2);
  const fatMass = estWeight * bf / 100;
  const leanMass = estWeight - fatMass;

  document.getElementById('bfMass')!.textContent = fatMass.toFixed(1) + ' kg (estimated)';
  document.getElementById('leanMass')!.textContent = leanMass.toFixed(1) + ' kg (estimated)';
  showResult('bfResult');
}

function resetBodyFat() {
  (document.getElementById('bfHeight') as HTMLInputElement).value = '175';
  (document.getElementById('bfNeck') as HTMLInputElement).value = '38';
  (document.getElementById('bfWaist') as HTMLInputElement).value = '85';
  (document.getElementById('bfHip') as HTMLInputElement).value = '95';
  hideResult('bfResult');
}

document.getElementById('bfGender')!.addEventListener('change', toggleBFGender);
document.getElementById('calcBtn')!.addEventListener('click', calcBodyFat);
document.getElementById('resetBtn')!.addEventListener('click', resetBodyFat);
document.addEventListener('DOMContentLoaded', () => { toggleBFGender(); calcBodyFat(); });
</script>
