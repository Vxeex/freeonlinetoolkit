---
import ToolLayout from '../layouts/ToolLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug['divorce-calculator'];
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: tool.title }];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Divorce Cost Calculator: Estimate Legal Fees & Expenses",
    "description": "Divorce Cost Calculator: Estimate Legal Fees & Expenses. Free online calculator included.",
    "author": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "publisher": { "@type": "Organization", "name": "FreeOnlineToolkit" },
    "datePublished": "2026-07-26",
    "dateModified": "2026-07-26",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://freeonlinetoolkit.org/divorce-calculator/" }
  }
];
---

<ToolLayout title="Divorce Cost Calculator: Estimate Legal Fees & Expenses | FreeOnlineToolkit" description="Divorce Cost Calculator: Estimate Legal Fees & Expenses. Free online calculator included." breadcrumbItems={breadcrumbItems} jsonLd={jsonLd}>
  <fragment slot="heading"><h1>Divorce Cost Calculator: Estimate Legal Fees & Expenses</h1></fragment>

  <div class="key-takeaways" style="background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;padding:1.25rem;margin-bottom:1.5rem;">
    <h3 style="margin-top:0;color:#1e40af;">Key Takeaways</h3>
    <ul style="margin-bottom:0;">
      <li>The average cost of divorce in the US ranges from $15,000 to $30,000, but contested divorces with complex assets can exceed $100,000.</li>
      <li>Uncontested divorces (where both parties agree on terms) cost 4-10x less than contested divorces - mediation can help convert a contested case into an uncontested one.</li>
      <li>State filing fees vary from $100 to $450, but attorney fees are the largest cost component at $200-$500 per hour.</li>
      <li>Children, high-value assets, and contested custody significantly increase both the cost and timeline of divorce proceedings.</li>
      <li>Mediation ($3,000-$8,000) is almost always cheaper than litigation and typically produces better outcomes for both parties and children.</li>
    </ul>
  </div>

    <p>Divorce is one of the most financially significant events in a person's life, yet many people enter the process without understanding the true costs involved. The total expense extends far beyond filing fees - it includes attorney costs, mediation fees, court costs, and the often-overlooked expenses of dividing assets, establishing separate households, and potentially modifying financial plans. Understanding these costs upfront helps you budget appropriately and make strategic decisions about how to proceed.</p>

    <p>The single largest cost driver is whether the divorce is <strong>contested or uncontested</strong>. An uncontested divorce - where both spouses agree on asset division, child custody, support, and all other terms - can cost as little as $1,500-$5,000 in total. A contested divorce that goes to trial typically costs $15,000-$50,000 or more, with complex cases involving business valuations, forensic accountants, and custody evaluations easily exceeding $100,000. The attorney's hourly rate ($200-$500/hour in most markets) multiplied by the hours required explains most of this difference.</p>

    <p><strong>Mediation</strong> is an increasingly popular alternative that can dramatically reduce costs. A trained mediator helps both parties communicate and reach mutually acceptable agreements on all major issues. Mediation typically costs $3,000-$8,000 total (split between both parties), compared to $15,000+ each for litigation. Research consistently shows that mediated agreements have higher compliance rates and produce better emotional outcomes for both adults and children.</p>

    <p>Several factors significantly affect both cost and timeline. <strong>Children</strong> introduce custody and support calculations that add complexity. <strong>High-value assets</strong> (businesses, real estate portfolios, retirement accounts) require professional valuations that add $2,000-$10,000+. The <strong>state you file in</strong> affects filing fees (California charges $435, Texas $300, New York $335), mandatory waiting periods, and specific rules about property division.</p>

  <fragment slot="intro">
    <p class="tool-intro">Use the free calculator below to get instant results. Read on for a full guide to the topic, key formulas, and expert tips.</p>
  </fragment>

<fragment slot="calculator">
    <div class="calc-card">
      <h2>Divorce Cost Calculator</h2>
      <div class="form-row">
        <div class="form-group">
          <label for="filingState">Filing State</label>
          <select id="filingState">
            <option value="CA" selected>California</option>
            <option value="NY">New York</option>
            <option value="TX">Texas</option>
          </select>
        </div>
        <div class="form-group">
          <label for="maritalStatus">Marital Status</label>
          <select id="maritalStatus">
            <option value="uncontested" selected>Uncontested</option>
            <option value="contested">Contested</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="children">Children Involved?</label>
          <select id="children">
            <option value="no" selected>No</option>
            <option value="yes">Yes</option>
          </select>
        </div>
        <div class="form-group">
          <label for="assetRange">Assets Value Range</label>
          <select id="assetRange">
            <option value="low">Under $100,000</option>
            <option value="medium" selected>$100,000 - $500,000</option>
            <option value="high">$500,000 - $1,000,000</option>
            <option value="veryhigh">Over $1,000,000</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="attorneyRate">Attorney Hourly Rate ($)</label>
          <div class="input-wrap">
            <span class="prefix">$</span>
            <input type="number" id="attorneyRate" class="prefixed" value="350" min="0" step="25">
          </div>
        </div>
        <div class="form-group">
          <label for="attorneyHours">Estimated Attorney Hours</label>
          <input type="number" id="attorneyHours" value="20" min="1" step="5">
        </div>
      </div>
      <div class="form-group">
        <label for="mediation">Mediation?</label>
        <select id="mediation">
          <option value="no" selected>No</option>
          <option value="yes">Yes (+$5,000 mediation cost)</option>
        </select>
      </div>
      <div class="btn-group">
        <button class="btn btn-primary" id="calcBtn" data-i18n="common.calculate">Calculate</button>
        <button class="btn btn-secondary" id="resetBtn" data-i18n="common.reset">Reset</button>
      </div>

      <div class="result-box" id="divorceResult">
        <div class="result-value" id="divorceTotal">$0.00</div>
        <div class="result-label">Total Estimated Cost</div>
        <div class="result-details">
          <div><span class="label">Filing Fee</span><span class="value" id="divorceFilingFee">$0</span></div>
          <div><span class="label">Attorney Fee Estimate</span><span class="value" id="divorceAttorneyFee">$0</span></div>
          <div><span class="label">Mediation Cost</span><span class="value" id="divorceMediation">$0</span></div>
          <div><span class="label">Cost Range</span><span class="value" id="divorceRange">$0 &mdash;$0</span></div>
          <div><span class="label">Estimated Timeline</span><span class="value" id="divorceTimeline">0 months</span></div>
        </div>
      </div>
    </div>
  </fragment>

  <fragment slot="content">
    <div class="content-section">
      <h2>What This Calculator Shows</h2>
      <p>This divorce cost estimator calculates your <strong>total estimated cost</strong> based on state filing fees, attorney hourly rates and hours, mediation costs, and court costs. It accounts for complicating factors like children and high-value assets, provides a <strong>cost range</strong> (plus or minus 20%), and estimates the <strong>timeline</strong> from filing to finalisation in months.</p>
    </div>

<div class="content-section">
      <h2>How to Use the Divorce Cost Calculator</h2>
      <p>Start by selecting your <strong>filing state</strong> &mdash;filing fees vary by state with California ($435), New York ($335), and Texas ($300). Choose your <strong>marital status</strong>: uncontested divorces where both parties agree typically cost much less than contested divorces that go to court.</p>
      <p>Indicate whether <strong>children</strong> are involved and your <strong>assets value range</strong>, as these factors influence complexity and cost. Enter your <strong>attorney's hourly rate</strong> and the <strong>estimated hours</strong> needed &mdash;uncontested cases average around 20 hours, while contested cases can require 100-200 hours.</p>
    </div>

    <div class="content-section">
      <h2>Divorce Cost Formula</h2>
      <div class="formula-box">
        Total Cost = Filing Fee + Attorney Fees + Mediation Cost + Court Costs
      </div>
      <div class="formula-box">
        Attorney Fees = Hourly Rate &times; Estimated Hours
      </div>
    </div>

    <FAQ items={[
      { question: "What is the difference between contested and uncontested divorce?", answer: "An uncontested divorce means both spouses agree on all major issues including asset division, child custody, and support. It is faster, cheaper, and less stressful. A contested divorce involves disagreements that require court intervention, making it significantly more expensive and time-consuming." },
      { question: "How much does mediation cost in a divorce?", answer: "Mediation typically costs $3,000 to $8,000 depending on the mediator's rates, the complexity of issues, and the number of sessions needed. The mediator helps both parties communicate and reach mutually acceptable agreements. While mediation has an upfront cost, it usually saves thousands in attorney fees." },
      { question: "How long does a divorce take?", answer: "An uncontested divorce can be finalized in 3-6 months depending on your state's waiting period and court processing times. Contested divorces can take 12-24 months or longer, especially when children, complex assets, or high conflict are involved." },
      { question: "Can I file for divorce without an attorney?", answer: "Yes, you can file for divorce pro se (without an attorney), especially in simple, uncontested cases with no children and minimal assets. Many courts provide self-help resources and forms. However, if there are significant assets, children involved, or any disagreement on terms, hiring an attorney is strongly recommended." },
    ]} />

    <div class="content-section">
      <h2>Next Steps</h2>
      <p>Enter your state, marital situation, and estimated attorney costs above to get a personalised divorce cost estimate. If possible, explore mediation before litigation - it almost always saves money and produces better outcomes. Consult with a family law attorney in your state for advice specific to your situation.</p>
    </div>
  </fragment>

  <fragment slot="sidebar">
    <RelatedTools currentSlug="divorce-calculator" category="legal" />
  </fragment>
</ToolLayout>


<script>
import { showResult, hideResult } from '../utils/calculator-utils';

const STATE_FILING_FEES: Record<string, number> = {
  CA: 435,
  NY: 335,
  TX: 300
};

const ASSET_MULTIPLIERS: Record<string, number> = {
  low: 1,
  medium: 1.2,
  high: 1.5,
  veryhigh: 2
};

function calcDivorce(): void {
  const state = (document.getElementById('filingState') as HTMLSelectElement).value;
  const status = (document.getElementById('maritalStatus') as HTMLSelectElement).value;
  const hasChildren = (document.getElementById('children') as HTMLSelectElement).value;
  const assetRange = (document.getElementById('assetRange') as HTMLSelectElement).value;
  const rate = parseFloat((document.getElementById('attorneyRate') as HTMLInputElement).value) || 0;
  const hours = parseFloat((document.getElementById('attorneyHours') as HTMLInputElement).value) || 0;
  const mediation = (document.getElementById('mediation') as HTMLSelectElement).value;

  const filingFee = STATE_FILING_FEES[state];
  const assetMultiplier = ASSET_MULTIPLIERS[assetRange];
  const childrenMultiplier = hasChildren === 'yes' ? 1.3 : 1;

  let adjustedHours = hours;
  if (status === 'contested') {
    adjustedHours = Math.max(hours, 100);
  }
  adjustedHours = adjustedHours * assetMultiplier * childrenMultiplier;

  const attorneyFee = rate * adjustedHours;
  const mediationCost = mediation === 'yes' ? 5000 : 0;
  const courtCosts = 500;
  const total = filingFee + attorneyFee + mediationCost + courtCosts;
  const lowRange = total * 0.8;
  const highRange = total * 1.2;

  let timelineMonths = 0;
  if (status === 'uncontested') {
    timelineMonths = hasChildren === 'yes' ? 6 : 4;
  } else {
    timelineMonths = hasChildren === 'yes' ? 18 : 12;
  }
  if (assetRange === 'veryhigh') timelineMonths += 6;
  if (assetRange === 'high') timelineMonths += 3;

  document.getElementById('divorceTotal')!.textContent = '$' + total.toFixed(2);
  document.getElementById('divorceFilingFee')!.textContent = '$' + filingFee.toFixed(2);
  document.getElementById('divorceAttorneyFee')!.textContent = '$' + attorneyFee.toFixed(2);
  document.getElementById('divorceMediation')!.textContent = '$' + mediationCost.toFixed(2);
  document.getElementById('divorceRange')!.textContent = '$' + lowRange.toFixed(2) + ' —$' + highRange.toFixed(2);
  document.getElementById('divorceTimeline')!.textContent = timelineMonths + ' months';

  showResult('divorceResult');
}

function resetDivorce(): void {
  (document.getElementById('filingState') as HTMLSelectElement).value = 'CA';
  (document.getElementById('maritalStatus') as HTMLSelectElement).value = 'uncontested';
  (document.getElementById('children') as HTMLSelectElement).value = 'no';
  (document.getElementById('assetRange') as HTMLSelectElement).value = 'medium';
  (document.getElementById('attorneyRate') as HTMLInputElement).value = '350';
  (document.getElementById('attorneyHours') as HTMLInputElement).value = '20';
  (document.getElementById('mediation') as HTMLSelectElement).value = 'no';
  hideResult('divorceResult');
}

document.getElementById('calcBtn')!.addEventListener('click', calcDivorce);
document.getElementById('resetBtn')!.addEventListener('click', resetDivorce);
document.addEventListener('DOMContentLoaded', calcDivorce);
</script>
